async function poll() {
  try {
    const st = await api("/api/status");
    const pill = $("statusPill");
    const mine = st.only === VMID;
    if (st.running && mine) {
      pill.className = "pill run";
      pill.textContent = st.dry_run ? "checking…" : "updating…";
    } else if (st.running || st.lock_held) {
      pill.className = "pill run"; pill.textContent = "another run in progress";
    } else if (st.returncode === 0 && mine) {
      pill.className = "pill ok"; pill.textContent = "last run OK";
    } else if (mine && st.returncode) {
      pill.className = "pill err"; pill.textContent = "last run failed (" + st.returncode + ")";
    } else {
      pill.className = "pill idle"; pill.textContent = "idle";
    }
    $("btnDry").disabled = st.running || st.lock_held;
    $("btnFull").disabled = st.running || st.lock_held;

    if (st.log && st.log !== activeLog && mine) {
      activeLog = st.log; logOffset = 0; $("logView").textContent = "";
    }
    if (activeLog) {
      const data = await api("/api/log?name=" + encodeURIComponent(activeLog) +
                             "&offset=" + logOffset);
      if (data.data) {
        const view = $("logView");
        const atBottom = view.scrollTop + view.clientHeight >= view.scrollHeight - 30;
        view.textContent += data.data;
        if (atBottom) view.scrollTop = view.scrollHeight;
      }
      logOffset = data.offset;
    }
  } catch (e) {
    $("statusPill").className = "pill err";
    $("statusPill").textContent = e.message;
  }
}

$("btnDry").onclick = async () => {
  try {
    await post("/api/guest/run", {vmid: VMID, dry_run: true});
    msg($("runMsg"), "Checking — nothing will be installed.", true);
    activeLog = null; logOffset = 0;
  } catch (e) { msg($("runMsg"), e.message, false); }
};

$("btnFull").onclick = async () => {
  const typed = prompt("Update guest " + VMID + " now?\n\nType UPDATE to confirm:");
  if (typed !== "UPDATE") { msg($("runMsg"), "Cancelled.", false); return; }
  try {
    await post("/api/guest/run", {vmid: VMID, dry_run: false, confirm: "UPDATE"});
    msg($("runMsg"), "Update started.", true);
    activeLog = null; logOffset = 0;
  } catch (e) { msg($("runMsg"), e.message, false); }
};

loadGuest();
poll();
setInterval(poll, 2000);
</script>
</body>
