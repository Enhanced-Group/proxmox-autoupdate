// --- appearance ---
// Every colour in the stylesheet already goes through a CSS custom property, so
// previewing a change is one setProperty call per token — no re-render, no
// stylesheet rebuild. Saving persists it for every browser, not just this one.
const THEME_KEYS = ["accent", "ok", "warn", "err"];
let THEME_DEFAULTS_CLIENT = {};

function themeInputs(key) {
  return [$("th-" + key), $("th-" + key + "-hex")];
}

function srgbToLinear(c) {
  c /= 255;
  return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
}

// Same WCAG relative-luminance test the server uses, so the live preview
// matches exactly what gets saved. White unless white would be unreadable.
function readableOn(hex) {
  const r = parseInt(hex.slice(1, 3), 16),
        g = parseInt(hex.slice(3, 5), 16),
        b = parseInt(hex.slice(5, 7), 16);
  const lum = 0.2126 * srgbToLinear(r) + 0.7152 * srgbToLinear(g) + 0.0722 * srgbToLinear(b);
  return 1.05 / (lum + 0.05) >= 3.0 ? "#ffffff" : "#000000";
}

function previewTheme() {
  const root = document.documentElement;
  THEME_KEYS.forEach((k) => {
    const v = $("th-" + k).value;
    if (!/^#[0-9a-fA-F]{6}$/.test(v)) return;
    root.style.setProperty("--" + k, v);
    root.style.setProperty("--on-" + k, readableOn(v));
    if (k === "accent") {
      const r = parseInt(v.slice(1, 3), 16),
            g = parseInt(v.slice(3, 5), 16),
            b = parseInt(v.slice(5, 7), 16);
      root.style.setProperty("--accent-dim", "rgba(" + r + "," + g + "," + b + ",0.35)");
    }
  });
}

function setThemeInputs(theme) {
  THEME_KEYS.forEach((k) => {
    const [picker, hex] = themeInputs(k);
    const v = theme[k] || THEME_DEFAULTS_CLIENT[k] || "#000000";
    picker.value = v;
    hex.value = v;
  });
  previewTheme();
}

function collectTheme() {
  const out = {};
  THEME_KEYS.forEach((k) => { out[k] = $("th-" + k).value; });
  return out;
}

THEME_KEYS.forEach((k) => {
  const [picker, hex] = themeInputs(k);
  picker.addEventListener("input", () => { hex.value = picker.value; previewTheme(); });
  hex.addEventListener("input", () => {
    const v = hex.value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(v)) { picker.value = v; previewTheme(); }
  });
});

