# --- Job state ----------------------------------------------------------------


class Job:
    """Tracks the single update run this service may have started."""

    def __init__(self):
        self.lock = threading.Lock()
        self.proc = None
        self.log_path = None
        self.dry_run = False
        self.only = None
        self.started_at = None
        self.finished_at = None
        self.returncode = None
        self.started_by = None

    def snapshot(self):
        with self.lock:
            running = self.proc is not None and self.proc.poll() is None
            if self.proc is not None and not running and self.returncode is None:
                self.returncode = self.proc.returncode
                self.finished_at = time.time()
            return {
                "running": running,
                "dry_run": self.dry_run,
                "only": self.only,
                "log": os.path.basename(self.log_path) if self.log_path else None,
                "started_at": self.started_at,
                "finished_at": self.finished_at,
                "returncode": self.returncode,
                "started_by": self.started_by,
            }

    def start(self, dry_run, user, only=None, no_email=False):
        """Launch a run. `only` limits it to a comma-separated set of guest IDs."""
        with self.lock:
            if self.proc is not None and self.proc.poll() is None:
                return False, "An update is already running."

            if not os.path.isfile(UPDATE_SCRIPT) or not os.access(UPDATE_SCRIPT, os.X_OK):
                return False, "%s is missing or not executable." % UPDATE_SCRIPT

            os.makedirs(LOG_DIR, exist_ok=True)
            stamp = time.strftime("%Y%m%d_%H%M%S")
            if only:
                kind = "guest%s" % only.replace(",", "-")
            else:
                kind = "dryrun" if dry_run else "manual"
            self.log_path = os.path.join(LOG_DIR, "webui_%s_%s.log" % (kind, stamp))

            cmd = [UPDATE_SCRIPT]
            if dry_run:
                cmd.append("--dry-run")
            if only:
                cmd += ["--only", only]
            if no_email:
                cmd.append("--no-email")

            scope = "guest %s" % only if only else "everything"
            logfh = open(self.log_path, "wb", buffering=0)
            logfh.write(
                ("=== started from web UI by %s at %s (%s, %s) ===\n"
                 % (user, time.strftime("%d/%m/%Y %H:%M:%S"),
                    "dry run" if dry_run else "full run", scope)).encode()
            )
            try:
                # start_new_session so the run survives a service restart and is
                # not killed by our own process group teardown.
                self.proc = subprocess.Popen(
                    cmd,
                    stdout=logfh,
                    stderr=subprocess.STDOUT,
                    stdin=subprocess.DEVNULL,
                    start_new_session=True,
                    env=dict(os.environ, TERM="dumb"),
                )
            except OSError as exc:
                logfh.close()
                return False, "Could not start the update script: %s" % exc

            self.dry_run = dry_run
            self.only = only
            self.started_at = time.time()
            self.finished_at = None
            self.returncode = None
            self.started_by = user
            return True, os.path.basename(self.log_path)


JOB = Job()


# --- Helpers ------------------------------------------------------------------


def lock_is_held():
    """True when some other run (usually cron) currently holds the lockfile."""
    if not os.path.exists(LOCKFILE):
        return False
    try:
        out = subprocess.run(
            ["fuser", LOCKFILE], capture_output=True, timeout=5
        )
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def read_config():
    """Parse the shell config into a dict. Only simple KEY="value" lines."""
    values = {}
    if not os.path.isfile(CONFIG_FILE):
        return values
    with open(CONFIG_FILE, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, raw = line.partition("=")
            key = key.strip()
            raw = raw.strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                raw = raw[1:-1]
            values[key] = raw
    return values


def write_config(updates):
    """Rewrite the config in place, preserving comments, ordering and mode 600."""
    existing = []
    if os.path.isfile(CONFIG_FILE):
        with open(CONFIG_FILE, "r", encoding="utf-8", errors="replace") as fh:
            existing = fh.readlines()

    seen = set()
    out = []
    for line in existing:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in stripped:
            key = stripped.partition("=")[0].strip()
            if key in updates:
                out.append('%s="%s"\n' % (key, updates[key]))
                seen.add(key)
                continue
        out.append(line)

    missing = [k for k in updates if k not in seen]
    if missing:
        out.append("\n# Added by the web UI\n")
        for key in missing:
            out.append('%s="%s"\n' % (key, updates[key]))

    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.writelines(out)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG_FILE)


def excluded_ids():
    raw = read_config().get("EXCLUDE_IDS", "")
    return {part for part in re.split(r"[,\s]+", raw) if part}


def set_excluded_ids(ids):
    """Persist the exclusion list, normalised and sorted numerically."""
    clean = sorted({str(int(i)) for i in ids}, key=int)
    write_config({"EXCLUDE_IDS": ",".join(clean)})
    return clean


def list_guests():
    """Every VM and container on this cluster, with its exclusion state.

    Uses /cluster/resources so one call covers both types and every node,
    rather than scraping `pct list` and `qm list` separately.
    """
    try:
        res = subprocess.run(
            ["pvesh", "get", "/cluster/resources", "--type", "vm",
             "--output-format", "json"],
            capture_output=True, text=True, timeout=20,
        )
        if res.returncode != 0:
            return [], (res.stderr.strip() or "pvesh returned %d" % res.returncode)
        raw = json.loads(res.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        return [], str(exc)

    skip = excluded_ids()
    guests = []
    for item in raw:
        vmid = item.get("vmid")
        if vmid is None:
            continue
        guests.append({
            "vmid": str(vmid),
            "name": item.get("name") or ("guest-%s" % vmid),
            "type": "lxc" if item.get("type") == "lxc" else "qemu",
            "status": item.get("status", "unknown"),
            "node": item.get("node", ""),
            "excluded": str(vmid) in skip,
        })
    guests.sort(key=lambda g: int(g["vmid"]))
    return guests, None


def read_state():
    """Run history written by update-everything.sh. Absent before the first run."""
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def repeat_offenders_text():
    guests = read_state().get("guests") or {}
    items = [
        (gid, g) for gid, g in guests.items()
        if isinstance(g, dict) and (g.get("consecutive_failures") or 0) > 1
    ]
    items.sort(key=lambda kv: -kv[1]["consecutive_failures"])
    return ", ".join(
        "%s (%s) x%d" % (g.get("name") or "guest", gid, g["consecutive_failures"])
        for gid, g in items
    )


def log_stats():
    """Total size and count of the log directory, for the UI to display."""
    total = count = 0
    oldest = None
    if os.path.isdir(LOG_DIR):
        for name in os.listdir(LOG_DIR):
            if not name.endswith(".log"):
                continue
            try:
                st = os.stat(os.path.join(LOG_DIR, name))
            except OSError:
                continue
            total += st.st_size
            count += 1
            if oldest is None or st.st_mtime < oldest:
                oldest = st.st_mtime
    return {"dir": LOG_DIR, "bytes": total, "count": count, "oldest": oldest}


def purge_logs(keep_current=True):
    """Delete stored logs. The log of a run in progress is kept by default."""
    current = None
    if keep_current:
        snap = JOB.snapshot()
        if snap["running"] and snap["log"]:
            current = snap["log"]
    removed = 0
    if os.path.isdir(LOG_DIR):
        for name in os.listdir(LOG_DIR):
            if not name.endswith(".log") or name == current:
                continue
            try:
                os.remove(os.path.join(LOG_DIR, name))
                removed += 1
            except OSError:
                pass
    return removed


def send_test_notification(cfg):
    """Fire a sample notification through every configured channel.

    Reuses update-everything.sh's own notifier rather than reimplementing the
    payloads here, so a successful test genuinely proves the real path works.
    """
    methods = [m.strip() for m in (cfg.get("NOTIFY_METHODS") or "").split(",") if m.strip()]
    methods = [m for m in methods if m in VALID_METHODS]
    if not methods:
        return False, "No notification channels are enabled."

    script = r'''
set -u
CONFIG_FILE="%s"
. "${CONFIG_FILE}"
HOST_NAME=$(hostname -f 2>/dev/null || hostname)
TIMESTAMP=$(date '+%%d/%%m/%%Y %%H:%%M:%%S')
ERRORS_OCCURRED=false; DRY_RUN=false; KEEP_LOGS=false; LOG_FILE=""
REBOOT_NEEDED=false; REPEAT_OFFENDERS=""; PVE_VERSION_AFTER=$(pveversion 2>/dev/null | awk '{print $1}')
LXC_UPDATED=0 LXC_ERRORS=0 VM_UPDATED=0 VM_ERRORS=0 HOST_PKG_COUNT=0
C_GREEN='' C_RED='' C_BOLD='' C_NC='' C_DIM='' C_YELLOW='' C_CYAN=''
print_ok()   { echo "OK: $1"; }
print_fail() { echo "FAIL: $1"; }
%s
BODY="This is a test notification from Proxmox Auto-Update on ${HOST_NAME}.

If you can read this, the channel is configured correctly.
No update was run."
for m in %s; do
    case "$m" in
        email)   notify_email   "[Proxmox] Test notification" "$BODY" "" ;;
        discord) notify_discord "[Proxmox] Test notification" "$BODY" ;;
        slack)   notify_slack   "[Proxmox] Test notification" "$BODY" ;;
        webhook) notify_webhook "[Proxmox] Test notification" "$BODY" ;;
    esac
done
'''
    # Lift the notifier verbatim out of the update script.
    try:
        with open(UPDATE_SCRIPT, encoding="utf-8") as fh:
            src = fh.read()
    except OSError as exc:
        return False, "Cannot read %s: %s" % (UPDATE_SCRIPT, exc)

    start = src.find("PAYLOAD_HELPER='")
    end = src.find("notify_all()")
    if start < 0 or end < 0 or end <= start:
        return False, "Could not locate the notification helpers in the update script."
    helpers = src[start:end]

    # Email needs the HTML file argument; a plain-text body is fine for a test.
    body_file = ""
    if "email" in methods:
        fd, body_file = tempfile.mkstemp(suffix=".html")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("<p>This is a <strong>test notification</strong> from "
                     "Proxmox Auto-Update.</p><p>If you can read this, email is "
                     "configured correctly. No update was run.</p>")
        script = script.replace('notify_email   "[Proxmox] Test notification" "$BODY" ""',
                                'notify_email   "[Proxmox] Test notification" "$BODY" "%s"'
                                % body_file)

    full = script % (CONFIG_FILE, helpers, " ".join(methods))
    try:
        res = subprocess.run(["bash", "-c", full], capture_output=True,
                             text=True, timeout=120)
        output = (res.stdout + res.stderr).strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return False, "Test failed to run: %s" % exc
    finally:
        if body_file:
            try:
                os.remove(body_file)
            except OSError:
                pass

    ok = "FAIL:" not in output and output != ""
    return ok, output or "No output from the notifier."


GITHUB_REPO = "Enhanced-Group/proxmox-autoupdate"
GITHUB_RAW = "https://raw.githubusercontent.com/%s/main" % GITHUB_REPO
INSTALL_SCRIPT_URL = "%s/install.sh" % GITHUB_RAW
UNINSTALL_SCRIPT = "/usr/local/bin/pve-autoupdate-uninstall"


def installed_version():
    try:
        with open(UPDATE_SCRIPT, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'\s*PAU_VERSION="([^"]+)"', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return "unknown"


def _version_tuple(v):
    parts = []
    for chunk in re.split(r"[.\-+]", v):
        parts.append(int(chunk) if chunk.isdigit() else 0)
    return tuple(parts or [0])


def check_for_updates():
    """Read-only version check against the published update script.

    Deliberately only *reports*. Applying is a separate, explicitly confirmed
    action, so a compromised or mistaken upstream cannot roll itself out
    silently onto a node that merely looked.
    """
    current = installed_version()
    req = urllib.request.Request(
        "%s/update-everything.sh" % GITHUB_RAW,
        headers={"User-Agent": "proxmox-autoupdate"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            head = resp.read(4096).decode("utf-8", errors="replace")
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        return {"current": current, "latest": None,
                "error": "Could not reach GitHub: %s" % exc}

    m = re.search(r'PAU_VERSION="([^"]+)"', head)
    if not m:
        return {"current": current, "latest": None,
                "error": "Could not read a version from the published script."}

    latest = m.group(1)
    try:
        behind = _version_tuple(latest) > _version_tuple(current)
    except ValueError:
        behind = latest != current
    return {
        "current": current,
        "latest": latest,
        "update_available": bool(behind),
        "repo": "https://github.com/%s" % GITHUB_REPO,
        "command": "curl -sSL %s | bash" % INSTALL_SCRIPT_URL,
    }


def run_detached(command, unit):
    """Run a command owned by systemd rather than by this service.

    Required for self-update and uninstall: both restart or delete this very
    process, so anything still parented to it would be killed part way through.
    """
    if shutil_which("systemd-run"):
        subprocess.run(["systemctl", "reset-failed", unit + ".service"],
                       capture_output=True, timeout=10)
        res = subprocess.run(
            ["systemd-run", "--unit", unit, "--collect",
             "--description", "proxmox-autoupdate maintenance",
             "/bin/bash", "-c", command],
            capture_output=True, text=True, timeout=20)
        if res.returncode == 0:
            return True, unit
        return False, (res.stderr.strip() or "systemd-run failed")

    try:
        subprocess.Popen(["/bin/bash", "-c", command],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True)
        return True, "detached process"
    except OSError as exc:
        return False, str(exc)


def shutil_which(name):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def read_crontab():
    try:
        res = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=10)
        return res.stdout if res.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def current_schedule():
    for line in read_crontab().splitlines():
        if UPDATE_SCRIPT in line and not line.strip().startswith("#"):
            return " ".join(line.split()[:5])
    return ""


def write_schedule(expr):
    """Replace our crontab entry, leaving every other entry untouched."""
    kept = [
        line
        for line in read_crontab().splitlines()
        if UPDATE_SCRIPT not in line and line.strip() != CRON_MARKER
    ]
    while kept and not kept[-1].strip():
        kept.pop()
    kept.append(CRON_MARKER)
    kept.append("%s %s >> %s/cron.log 2>&1" % (expr, UPDATE_SCRIPT, LOG_DIR))
    payload = "\n".join(kept) + "\n"

    proc = subprocess.run(["crontab", "-"], input=payload, text=True,
                          capture_output=True, timeout=10)
    if proc.returncode != 0:
        raise ValueError(proc.stderr.strip() or "crontab rejected the schedule")


def list_logs(limit=40):
    if not os.path.isdir(LOG_DIR):
        return []
    entries = []
    for name in os.listdir(LOG_DIR):
        if not name.endswith(".log"):
            continue
        path = os.path.join(LOG_DIR, name)
        try:
            st = os.stat(path)
        except OSError:
            continue
        entries.append({"name": name, "size": st.st_size, "mtime": st.st_mtime})
    entries.sort(key=lambda e: e["mtime"], reverse=True)
    return entries[:limit]


def safe_log_path(name):
    """Resolve a log name to a path inside LOG_DIR, or None if it escapes."""
    if not name or "/" in name or "\\" in name or name.startswith("."):
        return None
    path = os.path.realpath(os.path.join(LOG_DIR, name))
    if os.path.dirname(path) != os.path.realpath(LOG_DIR):
        return None
    return path if os.path.isfile(path) else None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\r")


def strip_ansi(text):
    return ANSI_RE.sub("", text)


# --- Authentication -----------------------------------------------------------

TICKET_RE = re.compile(r"^PVE:([^:]+):")

_ssl_noverify = ssl.create_default_context()
_ssl_noverify.check_hostname = False
_ssl_noverify.verify_mode = ssl.CERT_NONE


def verify_ticket(ticket):
    """Validate a PVEAuthCookie against the local PVE API. Returns username or None.

    The signature check is delegated to pvedaemon rather than reimplemented:
    if the API accepts the cookie, it is genuine and unexpired.
    """
    if not ticket:
        return None
    match = TICKET_RE.match(ticket)
    if not match:
        return None
    user = match.group(1)

    req = urllib.request.Request(
        "https://127.0.0.1:8006/api2/json/access/permissions",
        headers={"Cookie": "PVEAuthCookie=%s" % ticket},
    )
    try:
        with urllib.request.urlopen(req, context=_ssl_noverify, timeout=8) as resp:
            if resp.status != 200:
                return None
    except urllib.error.HTTPError:
        return None
    except (urllib.error.URLError, OSError, ssl.SSLError):
        return None
    return user


# CSRF: a token bound to the ticket, handed out with the page and required on
# every mutating request. Cross-origin script cannot read our HTML, so it cannot
# obtain the token.
_CSRF_SECRET = token_urlsafe(32)
_csrf_tokens = {}
_csrf_lock = threading.Lock()


def issue_csrf(user):
    token = token_urlsafe(24)
    with _csrf_lock:
        now = time.time()
        for key, (_, ts) in list(_csrf_tokens.items()):
            if now - ts > 43200:
                _csrf_tokens.pop(key, None)
        _csrf_tokens[token] = (user, now)
    return token


def check_csrf(token, user):
    if not token:
        return False
    with _csrf_lock:
        entry = _csrf_tokens.get(token)
    if not entry:
        return False
    owner, ts = entry
    return compare_digest(owner, user) and (time.time() - ts) <= 43200


# --- HTTP handler -------------------------------------------------------------


class Handler(BaseHTTPRequestHandler):
    server_version = "ProxmoxAutoUpdateUI/1.0"
    protocol_version = "HTTP/1.1"

    # -- plumbing --

    def log_message(self, fmt, *args):
        sys.stderr.write("[ui] %s - %s\n" % (self.address_string(), fmt % args))

    def _allowed_origin(self):
        """Echo the Origin back only when it is this same host on another port.

        The Proxmox UI runs on :8006 and this panel on :8007, so the status dot
        is a cross-origin credentialed request. Credentialed CORS forbids '*',
        and reflecting arbitrary origins would let any site read run status
        using the visitor's cookie — so the hostname must match exactly.
        """
        origin = self.headers.get("Origin")
        if not origin:
            return None
        try:
            parsed = urllib.parse.urlparse(origin)
        except ValueError:
            return None
        if parsed.scheme != "https" or not parsed.hostname:
            return None

        host_header = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        candidates = {host_header.lower()} if host_header else set()
        candidates.discard("")
        if parsed.hostname.lower() in candidates:
            return origin
        return None

    def _send(self, code, body, ctype="application/json", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        allowed = self._allowed_origin()
        if allowed:
            self.send_header("Access-Control-Allow-Origin", allowed)
            self.send_header("Access-Control-Allow-Credentials", "true")
            self.send_header("Vary", "Origin")
        # Allow the Proxmox UI (any origin/port on this host) to frame us, but
        # nothing else may embed this control panel.
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; style-src 'self' 'unsafe-inline'; "
                         "script-src 'self' 'unsafe-inline'; frame-ancestors https:")
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _json(self, code, payload):
        self._send(code, json.dumps(payload), "application/json")

    def _auth(self):
        """Returns the username, or None after having already sent a 401."""
        cookies = self.headers.get("Cookie", "")
        ticket = None
        for part in cookies.split(";"):
            name, _, value = part.strip().partition("=")
            if name == "PVEAuthCookie":
                ticket = urllib.parse.unquote(value)
                break

        user = verify_ticket(ticket)
        if not user:
            self._json(401, {"error": "Not logged in to Proxmox. "
                                      "Open the Proxmox web UI, log in, then reload."})
            return None
        if user not in ALLOWED_USERS:
            self._json(403, {"error": "User %s is not permitted to control updates." % user})
            return None
        return user

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return {}
        if length <= 0 or length > 1_000_000:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}

    # -- routes --

    def do_GET(self):
        path, _, query = self.path.partition("?")
        params = urllib.parse.parse_qs(query)

        if path == "/healthz":
            self._send(200, "ok", "text/plain")
            return

        user = self._auth()
        if not user:
            return

        if path == "/":
            token = issue_csrf(user)
            self._send(200, render_page(user, token), "text/html; charset=utf-8")
        elif path == "/guest":
            vmid = (params.get("vmid") or [""])[0]
            if not vmid.isdigit():
                self._send(400, "<p>Missing or invalid vmid.</p>", "text/html; charset=utf-8")
                return
            name = (params.get("name") or [""])[0]
            token = issue_csrf(user)
            self._send(200, render_guest_page(user, token, vmid, name),
                       "text/html; charset=utf-8")
        elif path == "/api/guests":
            guests, err = list_guests()
            if err:
                self._json(500, {"error": "Could not list guests: %s" % err})
                return
            self._json(200, {"guests": guests})
        elif path == "/api/status":
            status = JOB.snapshot()
            status["lock_held"] = lock_is_held() and not status["running"]
            status["schedule"] = current_schedule()
            status["user"] = user
            status["version"] = installed_version()
            self._json(200, status)
        elif path == "/api/state":
            # Consumed cross-origin by the toolbar button's status dot.
            state = read_state()
            snap = JOB.snapshot()
            self._json(200, {
                "running": snap["running"] or lock_is_held(),
                "last_run": state.get("last_run") or {},
                "repeat_offenders": repeat_offenders_text(),
                "version": installed_version(),
            })
        elif path == "/api/history":
            state = read_state()
            self._json(200, {
                "runs": state.get("runs") or [],
                "guests": state.get("guests") or {},
                "repeat_offenders": repeat_offenders_text(),
            })
        elif path == "/api/logs/stats":
            cfg = read_config()
            stats = log_stats()
            stats["keep_logs"] = (cfg.get("KEEP_LOGS") or "true")
            stats["retention_days"] = (cfg.get("LOG_RETENTION_DAYS") or "90")
            self._json(200, stats)
        elif path == "/api/self/version":
            self._json(200, {"version": installed_version()})
        elif path == "/api/config":
            cfg = read_config()
            payload = {k: cfg.get(k, "") for k in EDITABLE_KEYS}
            self._json(200, {"config": payload, "sensitive": sorted(SENSITIVE_KEYS)})
        elif path == "/api/logs":
            self._json(200, {"logs": list_logs()})
        elif path == "/api/log":
            self._serve_log(params)
        else:
            self._json(404, {"error": "Not found"})

    def _serve_log(self, params):
        name = (params.get("name") or [None])[0]
        if name is None:
            status = JOB.snapshot()
            name = status["log"]
            if not name:
                self._json(200, {"data": "", "offset": 0, "eof": True})
                return
        path = safe_log_path(name)
        if not path:
            self._json(404, {"error": "No such log"})
            return
        try:
            offset = int((params.get("offset") or ["0"])[0])
        except ValueError:
            offset = 0

        size = os.path.getsize(path)
        if offset > size:      # log rotated or truncated underneath us
            offset = 0
        with open(path, "rb") as fh:
            fh.seek(offset)
            chunk = fh.read(256 * 1024)
        self._json(200, {
            "data": strip_ansi(chunk.decode("utf-8", errors="replace")),
            "offset": offset + len(chunk),
            "eof": offset + len(chunk) >= size,
            "name": name,
        })

    def do_POST(self):
        path = self.path.partition("?")[0]
        user = self._auth()
        if not user:
            return

        if not check_csrf(self.headers.get("X-PAU-CSRF"), user):
            self._json(403, {"error": "Invalid or expired CSRF token — reload the page."})
            return

        body = self._body()

        if path == "/api/run":
            self._run(body, user)
        elif path == "/api/guest/run":
            self._run_guest(body, user)
        elif path == "/api/exclusions":
            self._save_exclusions(body)
        elif path == "/api/config":
            self._save_config(body)
        elif path == "/api/schedule":
            self._save_schedule(body)
        elif path == "/api/notify/test":
            self._test_notification()
        elif path == "/api/logs/purge":
            removed = purge_logs()
            self._json(200, {"removed": removed})
        elif path == "/api/self/check":
            self._json(200, check_for_updates())
        elif path == "/api/self/update":
            self._self_update(body, user)
        elif path == "/api/self/uninstall":
            self._self_uninstall(body, user)
        else:
            self._json(404, {"error": "Not found"})

    def _test_notification(self):
        ok, detail = send_test_notification(read_config())
        self._json(200 if ok else 400, {"ok": ok, "detail": detail})

    def _self_update(self, body, user):
        if body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Self-update requires an explicit confirmation."})
            return
        if JOB.snapshot()["running"] or lock_is_held():
            self._json(409, {"error": "An update run is in progress — wait for it to finish."})
            return

        # Runs detached: the installer replaces this very script and restarts
        # this service, so it cannot be a child of the request handling it.
        command = ("curl -fsSL %s -o /tmp/pau-install.sh && "
                   "bash /tmp/pau-install.sh --unattended; "
                   "rm -f /tmp/pau-install.sh" % INSTALL_SCRIPT_URL)
        ok, detail = run_detached(command, "pve-autoupdate-selfupdate")
        if not ok:
            self._json(500, {"error": "Could not start the update: %s" % detail})
            return
        sys.stderr.write("[ui] self-update started by %s\n" % user)
        self._json(200, {
            "started": True,
            "detail": "Update started as %s. This panel will restart; "
                      "reload in about a minute." % detail,
        })

    def _self_uninstall(self, body, user):
        # Two independent gates: the typed word, and an explicit acknowledgement
        # that this removes the panel serving the request.
        if body.get("confirm") != "UNINSTALL":
            self._json(400, {"error": "Type UNINSTALL to confirm."})
            return
        if not body.get("acknowledged"):
            self._json(400, {"error": "Acknowledgement required."})
            return
        if JOB.snapshot()["running"] or lock_is_held():
            self._json(409, {"error": "An update run is in progress — wait for it to finish."})
            return

        purge = " --purge" if body.get("purge") else ""
        if os.path.isfile(UNINSTALL_SCRIPT):
            command = "%s --yes%s" % (UNINSTALL_SCRIPT, purge)
        else:
            command = ("curl -fsSL %s/uninstall.sh -o /tmp/pau-uninstall.sh && "
                       "bash /tmp/pau-uninstall.sh --yes%s; "
                       "rm -f /tmp/pau-uninstall.sh" % (GITHUB_RAW, purge))

        ok, detail = run_detached(command, "pve-autoupdate-uninstall")
        if not ok:
            self._json(500, {"error": "Could not start the uninstall: %s" % detail})
            return
        sys.stderr.write("[ui] uninstall started by %s (purge=%s)\n" % (user, bool(purge)))
        self._json(200, {
            "started": True,
            "detail": "Uninstall started as %s. This panel will stop responding "
                      "shortly — that is expected." % detail,
        })

    def _run(self, body, user):
        dry = bool(body.get("dry_run", True))
        if not dry and body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Full runs require an explicit confirmation."})
            return
        if lock_is_held():
            self._json(409, {"error": "Another update run holds the lock "
                                      "(a scheduled run is probably in progress)."})
            return
        ok, detail = JOB.start(dry, user)
        if not ok:
            self._json(409, {"error": detail})
            return
        self._json(200, {"started": True, "log": detail, "dry_run": dry})

    def _run_guest(self, body, user):
        """Update a single guest. Never touches the host and never reboots."""
        vmid = str(body.get("vmid", "")).strip()
        if not vmid.isdigit():
            self._json(400, {"error": "Expected a numeric vmid."})
            return

        guests, err = list_guests()
        if err:
            self._json(500, {"error": "Could not verify the guest: %s" % err})
            return
        if vmid not in {g["vmid"] for g in guests}:
            self._json(404, {"error": "No guest with ID %s on this cluster." % vmid})
            return

        dry = bool(body.get("dry_run", True))
        if not dry and body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Full runs require an explicit confirmation."})
            return
        if lock_is_held():
            self._json(409, {"error": "Another update run holds the lock "
                                      "(a scheduled run is probably in progress)."})
            return

        # No email for a single guest — the caller is watching the output live.
        ok, detail = JOB.start(dry, user, only=vmid, no_email=True)
        if not ok:
            self._json(409, {"error": detail})
            return
        self._json(200, {"started": True, "log": detail, "dry_run": dry, "vmid": vmid})

    def _save_exclusions(self, body):
        ids = body.get("excluded")
        if not isinstance(ids, list):
            self._json(400, {"error": "Expected a list of IDs."})
            return
        cleaned = []
        for item in ids:
            text = str(item).strip()
            if not text.isdigit():
                self._json(400, {"error": "Not a valid guest ID: %r" % item})
                return
            cleaned.append(text)
        try:
            saved = set_excluded_ids(cleaned)
        except OSError as exc:
            self._json(500, {"error": "Could not write config: %s" % exc})
            return
        self._json(200, {"excluded": saved})

    def _save_config(self, body):
        incoming = body.get("config")
        if not isinstance(incoming, dict):
            self._json(400, {"error": "Expected a config object."})
            return

        updates, errors = {}, []
        for key, value in incoming.items():
            if key not in EDITABLE_KEYS:
                errors.append("%s is not an editable setting" % key)
                continue
            value = ("" if value is None else str(value)).strip()
            # An untouched sensitive field comes back as the placeholder; skip it
            # so we never overwrite a real key with asterisks.
            if key in SENSITIVE_KEYS and set(value) == {"*"}:
                continue
            if not EDITABLE_KEYS[key](value):
                errors.append("%s: invalid value" % key)
                continue
            updates[key] = value

        if errors:
            self._json(400, {"error": "; ".join(errors)})
            return
        try:
            write_config(updates)
        except OSError as exc:
            self._json(500, {"error": "Could not write config: %s" % exc})
            return

        # The cron expression lives in both the config and the crontab.
        if "UPDATE_SCHEDULE_CRON" in updates:
            try:
                write_schedule(updates["UPDATE_SCHEDULE_CRON"])
            except (ValueError, OSError, subprocess.SubprocessError) as exc:
                self._json(500, {"error": "Config saved, but crontab update failed: %s" % exc})
                return
        self._json(200, {"saved": sorted(updates)})

    def _save_schedule(self, body):
        expr = str(body.get("cron", "")).strip()
        if not _v_cron(expr):
            self._json(400, {"error": "Expected a 5-field cron expression."})
            return
        try:
            write_schedule(expr)
        except (ValueError, OSError, subprocess.SubprocessError) as exc:
            self._json(400, {"error": str(exc)})
            return
        try:
            write_config({"UPDATE_SCHEDULE_CRON": expr})
        except OSError as exc:
            self._json(500, {"error": "Crontab updated, but config write failed: %s" % exc})
            return
        self._json(200, {"cron": expr})


