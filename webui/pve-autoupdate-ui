// --- status + live log ---
let logOffset = 0, activeLog = null, wasRunning = false;

// Elapsed-time readout for a run in progress. Lives here rather than in the
// shared script because only this page has a timer: shared code that reaches
// for an element the per-guest page lacks fails silently inside a timer.
let runStartedAt = null;
function fmtElapsed(secs) {
  if (secs < 60) { return secs + "s"; }
  if (secs < 3600) {
    return Math.floor(secs / 60) + "m " + String(secs % 60).padStart(2, "0") + "s";
  }
  return Math.floor(secs / 3600) + "h " +
         String(Math.floor((secs % 3600) / 60)).padStart(2, "0") + "m";
}
function tickTimer() {
  // started_at is a Unix timestamp in seconds, not milliseconds and not ISO.
  if (!runStartedAt) { return; }
  const secs = Math.max(0, Math.round(Date.now() / 1000 - runStartedAt));
  $("runTimer").textContent = "running for " + fmtElapsed(secs);
}
setInterval(() => {
  if (!$("runTimer").classList.contains("hidden")) { tickTimer(); }
}, 1000);

async function poll() {
  try {
    const st = await api("/api/status");
    const pill = $("statusPill");
    const busy = st.running || st.lock_held || st.self_updating;

    // Checked first: a self-update is about this tool, not about your guests,
    // and it is the only one of these that invalidates the page you are on.
    if (st.self_updating) {
      pill.className = "pill run";
      pill.innerHTML = '<span class="spinner"></span>updating Auto-Update' +
                       (st.pending ? " to " + st.pending : "") + "…";
    } else if (st.running) {
      pill.className = "pill run";
      pill.innerHTML = '<span class="spinner"></span>' +
                       (st.dry_run ? "dry run" : "updating guests") + "…";
    } else if (st.lock_held) {
      pill.className = "pill run";
      pill.innerHTML = '<span class="spinner"></span>scheduled run in progress';
    } else if (st.returncode === 0) {
      pill.className = "pill ok"; pill.textContent = "last run OK";
    } else if (st.returncode === 2) {
      // Not a failure. The run completed, but one or more guests were left
      // mid-update — typically a Windows guest still installing — so the host
      // reboot was deliberately held back.
      pill.className = "pill warn-pill";
      pill.textContent = "guests left mid-update";
      pill.title = "The run finished, but at least one guest was still updating. " +
                   "Any host reboot was postponed.";
    } else if (st.returncode !== null && st.returncode !== undefined) {
      pill.className = "pill err"; pill.textContent = "last run failed (" + st.returncode + ")";
    } else {
      pill.className = "pill idle"; pill.textContent = "idle";
    }
    $("schedDisplay").textContent = st.schedule || "not scheduled";

    // Motion while a run is in flight: a long silent stretch mid-upgrade
    // otherwise looks identical to a panel that has hung. Scoped to an actual
    // run — a self-update produces no run log, so a "live" marker on an empty
    // output pane would be a lie.
    const runLive = !!(st.running || st.lock_held);
    $("runProgress").classList.toggle("active", runLive);
    $("liveTag").classList.toggle("hidden", !runLive);
    $("logView").classList.toggle("live", runLive);

    // Elapsed time for a run in progress.
    //
    // A guest upgrade can legitimately take half an hour, and a panel showing
    // an unchanging log with no clock gives you no way to tell "working" from
    // "wedged". Driven off the job's own start time so it survives a page
    // reload rather than counting from when the tab was opened.
    // Only trust started_at while this panel's own job is running. A cron run
    // holds the lockfile but is not our subprocess, so started_at would still
    // be whatever the last panel-started run left behind — and the clock would
    // read hours or days.
    if (st.running && st.started_at) {
      runStartedAt = st.started_at;
      $("runTimer").classList.remove("hidden");
      tickTimer();
    } else if (st.lock_held) {
      runStartedAt = null;
      $("runTimer").textContent = "started outside this panel";
      $("runTimer").classList.remove("hidden");
    } else {
      runStartedAt = null;
      $("runTimer").classList.add("hidden");
    }

    // Still disabled during a self-update: the script is being replaced.
    $("btnDry").disabled = busy;
    $("btnFull").disabled = busy;

    if (st.log && st.log !== activeLog) { activeLog = st.log; logOffset = 0; $("logView").textContent = ""; }
    if (activeLog) await pumpLog();
    if (wasRunning && !st.running) await pumpLog();
    wasRunning = st.running;
    $("offline").classList.add("hidden");
  } catch (e) {
    // Say the panel lost contact, rather than leaving a page that has silently
    // stopped updating and looks identical to one that is simply idle. The API
    // answers 503 while pve-manager restarts during a host upgrade, which is
    // exactly when someone is most likely to be watching.
    $("offline").classList.remove("hidden");
    const pill = $("statusPill");
    pill.className = "pill err";
    pill.textContent = "reconnecting…";
    pill.title = e.message;
  }
}

// The live pane only ever showed runs started from this page, so the scheduled
// Friday-night run — the one that matters — left it saying "No run started from
// this page yet". Fall back to the newest log on disk.
async function showLastRunLog() {
  if (activeLog) { return; }
  try {
    const data = await api("/api/logs");
    const newest = (data.logs || [])[0];
    if (!newest) { return; }
    const view = $("logView");
    if (view.textContent && view.textContent.indexOf("No run started") !== 0) { return; }
    let offset = 0, text = "";
    for (;;) {
      const d = await api("/api/log?name=" + encodeURIComponent(newest.name) + "&offset=" + offset);
      text += d.data; offset = d.offset;
      if (d.eof || text.length > 400000) { break; }
    }
    if (!activeLog) {
      view.textContent = text || "(empty)";
      $("logSource").textContent = "showing " + newest.name + " · " + relTime(newest.mtime * 1000);
    }
  } catch (e) { /* leave the placeholder */ }
}

async function pumpLog() {
  const data = await api("/api/log?name=" + encodeURIComponent(activeLog) + "&offset=" + logOffset);
  if (data.data) {
    const view = $("logView");
    const atBottom = view.scrollTop + view.clientHeight >= view.scrollHeight - 30;
    view.textContent += data.data;
    if (atBottom) view.scrollTop = view.scrollHeight;
  }
  logOffset = data.offset;
}

