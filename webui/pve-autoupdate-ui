const CSRF = "{{CSRF}}";

// Every setting belongs to exactly one screen.
//
// This list used to repeat the five Mailgun fields that Notifications owns,
// EXCLUDE_IDS which Exclusions owns as checkboxes, and REBOOT_TIME which
// Schedule owns. That was not merely redundant: saving this form posts every
// field in it, so ticking exclusions on one tab and then saving Configuration
// wrote back the stale text value and silently reverted them.
//
// What is left here is the set of settings with no dedicated screen of their
// own — including three added in 1.0.0 that had no UI at all.
const FIELDS = [
  // A single-element entry is a group heading, not a setting. Fourteen
  // unrelated fields in one flat column meant the panel's own port sat
  // directly below "Snapshots to keep", and nothing said where one subject
  // ended and the next began.
  ["— Guest update timeouts"],
  ["WINDOWS_UPDATE_TIMEOUT",  "Windows update timeout (s)",   "number",
   "How long a Windows guest gets to install updates. Cumulative updates often need more than an hour."],
  ["WINDOWS_SHUTDOWN_TIMEOUT","Windows shutdown wait (s)",    "number",
   "How long to wait for a Windows guest to shut down. It is never forced off — a guest still servicing updates is left running."],
  ["LINUX_UPDATE_TIMEOUT",    "Linux update timeout (s)",     "number",
   "How long a container or Linux VM gets to finish its upgrade."],
  ["LINUX_SHUTDOWN_TIMEOUT",  "Linux shutdown wait (s)",      "number",
   "How long a started Linux guest gets to shut down before it is forced off."],
  ["APT_LOCK_TIMEOUT",        "APT lock wait (s)",            "number",
   "How long apt waits for the dpkg lock inside a guest. Ubuntu's unattended-upgrades holds it regularly."],
  ["AGENT_ERROR_GRACE",       "Guest agent grace (s)",        "number",
   "How long guest-agent errors are tolerated mid-update. A guest upgrading its own agent restarts it."],
  ["— Stopped guests"],
  ["START_STOPPED_LXC",       "Start stopped containers",     "select", ["true", "false"]],
  ["START_STOPPED_LINUX_VMS", "Start stopped Linux VMs",      "select", ["true", "false"]],
  ["START_STOPPED_WINDOWS",   "Start stopped Windows VMs",    "select", ["true", "false"]],
  ["— Snapshots"],
  ["SNAPSHOT_BEFORE_UPDATE",  "Snapshot before update",       "select", ["true", "false"],
   "Needs snapshot-capable storage (ZFS, LVM-thin, qcow2)."],
  ["SNAPSHOT_KEEP",           "Snapshots to keep",            "number"],
  ["— This node"],
  ["PAU_TZ",                  "Timezone",                     "text",
   "Leave empty to use this host's own timezone. Affects timestamps and the reboot time."],
  ["— This panel"],
  ["WEB_UI_PORT",             "Panel port",                   "number",
   "The port this panel listens on. Changing it rewrites the service's systemd drop-in, opens the new port in the Proxmox firewall and closes the old one, re-points the toolbar button, then restarts this service - so this page will stop responding and has to be reopened on the new port. Ports below 1024, ports already in use, and common service ports (8006, 8007, 3128, 8080, 5900-5999, 60000-60050) are refused."],
  ["WEB_UI_PUBLIC_URL",       "Panel address (external)",     "text",
   "Leave empty unless you reach Proxmox through a reverse proxy or tunnel — Cloudflare Tunnel, nginx, Traefik, Tailscale. Those forward the Proxmox port and nothing else, so the toolbar button would point at a port your browser cannot open. Publish this panel through the same proxy and give its address here, e.g. https://panel.example.com. A path is allowed (https://proxmox.example.com/pau) and mounts the panel under it. Saving re-applies the toolbar button for you."],
