// --- logs ---
async function loadLogList() {
  try {
    const data = await api("/api/logs");
    const tbody = $("logList");
    tbody.innerHTML = "";
    if (!data.logs.length) {
      tbody.innerHTML = "<tr><td colspan='4'>No logs yet. They appear here after the first run.</td></tr>";
      $("logFilterCount").textContent = "";
      return;
    }
    data.logs.forEach((entry) => {
      const tr = document.createElement("tr");
      // Build with DOM nodes rather than innerHTML: the name comes off the
      // filesystem, and it is about to become a link and a download URL.
      const nameCell = document.createElement("td");
      nameCell.className = "wrap";
      const link = document.createElement("a");
      link.href = "#"; link.textContent = entry.name;
      link.onclick = (ev) => { ev.preventDefault(); showLog(entry.name); };
      nameCell.appendChild(link);

      const whenCell = document.createElement("td");
      whenCell.textContent = relTime(entry.mtime * 1000);
      whenCell.title = new Date(entry.mtime * 1000).toLocaleString();

      const sizeCell = document.createElement("td");
      sizeCell.textContent = humanSize(entry.size);

      const dlCell = document.createElement("td");
      const dl = document.createElement("a");
      dl.href = BASE + "/api/log/download?name=" + encodeURIComponent(entry.name);
      dl.textContent = "Download";
      dl.setAttribute("download", entry.name);
      dl.title = "Save " + entry.name + " to this computer";
      dlCell.appendChild(dl);

      tr.append(nameCell, whenCell, sizeCell, dlCell);
      tbody.appendChild(tr);
    });
    // Re-apply whatever is typed in the filter: the list is rebuilt on every
    // load, and without this a reload silently un-filters it.
    applyLogFilter();
  } catch (e) { $("logList").innerHTML = "<tr><td>" + e.message + "</td></tr>"; }
}

async function showLog(name) {
  $("logFile").textContent = "Loading…";
  $("logFileName").textContent = name;
  const dl = $("btnDownloadOne");
  dl.href = BASE + "/api/log/download?name=" + encodeURIComponent(name);
  dl.setAttribute("download", name);
  dl.classList.remove("hidden");
  let offset = 0, text = "";
  try {
    for (;;) {
      const data = await api("/api/log?name=" + encodeURIComponent(name) + "&offset=" + offset);
      text += data.data;
      offset = data.offset;
      if (data.eof) break;
    }
    LOG_TEXT = text || "(empty)";
    $("logFile").textContent = LOG_TEXT;
    $("logSearch").disabled = false;
    applyLogSearch();
  } catch (e) {
    LOG_TEXT = "";
    $("logSearch").disabled = true;
    $("logSearchCount").textContent = "";
    $("logFile").textContent = e.message;
  }
}

// Say where a report will actually go, rather than assuming email. With no
// channel configured a run is simply quiet, and claiming otherwise sends people
// looking for a message that was never going to arrive.
async function describeChannels() {
  try {
    const cfg = (await api("/api/config")).config;
    const methods = (cfg.NOTIFY_METHODS || "").split(",")
      .map((s) => s.trim()).filter((s) => s && s !== "none");
    const el = $("runChannels");
    if (!methods.length) {
      el.textContent = "No notification channel configured — the output appears below.";
    } else if (cfg.NOTIFY_ON_FAILURE_ONLY === "true") {
      el.textContent = "Reports go to " + methods.join(", ") + ", failures only.";
    } else {
      el.textContent = "Reports go to " + methods.join(", ") + ".";
    }
  } catch (e) { /* leave it blank rather than guess */ }
}

// --- overview summary ---
// Everything here already exists server-side; it was just spread across two
// other tabs. /api/state carries the last run and the repeat-offender list,
// /api/status carries the schedule.
const CRON_WORDS = {
  "0 23 * * 5": "Fridays at 23:00",
  "0 3 * * *":  "every day at 03:00",
  "0 3 * * 0":  "Sundays at 03:00",
  "0 3 1 * *":  "the 1st of each month at 03:00",
};

async function loadSummary() {
  try {
    const st = await api("/api/state");
    const run = st.last_run || {};
    const never = !run.finished;
    $("sumNever").classList.toggle("hidden", !never);

    $("sumWhen").textContent = never ? "never" : relTime(run.finished);
    $("sumWhenExact").textContent = never ? "" : new Date(run.finished).toLocaleString();

    const pill = $("sumResult");
    const result = (run.result || "").toString();
    const dry = result.indexOf("dryrun") !== -1;
    if (never)                          { pill.className = "pill idle"; pill.textContent = "—"; }
    else if (result.indexOf("error") === 0) { pill.className = "pill err"; pill.textContent = "errors"; }
    else                                { pill.className = "pill ok";  pill.textContent = "clean"; }
    $("sumScope").textContent =
      never ? "" : ((run.scope && run.scope !== "all" ? "only " + run.scope : "full sweep") +
                    (dry ? " · dry run" : ""));

    const c = run.counts || {};
    const guests = (c.lxc_updated || 0) + (c.vm_updated || 0);
    const errs = (c.lxc_errors || 0) + (c.vm_errors || 0);
    $("sumCounts").textContent = never ? "—" :
      (guests + " guest" + (guests === 1 ? "" : "s") +
       ", " + (c.host_packages || 0) + " host pkg" + ((c.host_packages || 0) === 1 ? "" : "s"));
    $("sumCountsDetail").textContent = never ? "" :
      (errs ? errs + " error" + (errs === 1 ? "" : "s") : "no errors") +
      ((c.mid_update || 0) ? " · " + c.mid_update + " left mid-update" : "");

    // Anything that needs a human. Repeat offenders come straight from the
    // state file's per-guest failure streaks.
    const att = $("sumAttention");
    const notes = [];
    if (st.repeat_offenders) { notes.push("Failing repeatedly: " + st.repeat_offenders); }
    if ((c.mid_update || 0) > 0) {
      notes.push(c.mid_update + " guest(s) were left mid-update, so no host reboot was scheduled.");
    }
    if (notes.length) { att.textContent = notes.join(" "); att.classList.remove("hidden"); }
    else { att.classList.add("hidden"); }
  } catch (e) { /* the header pill already reports connectivity */ }

  try {
    const status = await api("/api/status");
    const cron = (status.schedule || "").trim();
    $("sumNext").textContent = cron ? (CRON_WORDS[cron] || "on schedule") : "not scheduled";
    $("sumNextCron").textContent = cron || "no crontab entry";
  } catch (e) { /* as above */ }
}

// --- self-check ---
async function runDoctor() {
  const btn = $("btnDoctor"), out = $("doctorOut");
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span>Checking…';
  out.classList.remove("hidden");
  out.innerHTML = "<div class='hint'>Running checks — this reads state only and changes nothing.</div>";
  try {
    const r = await post("/api/self/doctor", {});
    if (r.error) { out.innerHTML = ""; msg($("doctorMsg"), r.error, false); return; }
    out.innerHTML = "";
    let section = null;
    r.rows.forEach((row) => {
      if (row.section !== section) {
        section = row.section;
        const h = document.createElement("div");
        h.className = "doc-section"; h.textContent = section;
        out.appendChild(h);
      }
      const line = document.createElement("div");
      line.className = "doc-row";
      const tag = document.createElement("span");
      tag.className = "doc-tag " + (row.level === "FAIL" ? "doc-fail" :
                                    row.level === "warn" ? "doc-warn" : "doc-ok");
      tag.textContent = row.level === "FAIL" ? "FAIL" : row.level.toUpperCase();
      const txt = document.createElement("span");
      txt.textContent = row.text;
      line.append(tag, txt);
      out.appendChild(line);
    });
    if (r.failures) {
      msg($("doctorMsg"), r.failures + " problem(s) will stop this working, " +
                          r.warnings + " warning(s).", false);
    } else {
      msg($("doctorMsg"), r.warnings ? ("No blocking problems, " + r.warnings + " warning(s).")
                                     : "Everything checks out.", true);
    }
  } catch (e) { msg($("doctorMsg"), e.message, false); }
  finally { btn.disabled = false; btn.textContent = "Run self-check"; }
}

