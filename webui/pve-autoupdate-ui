SHARED_JS = r"""
const $ = (id) => document.getElementById(id);

// "3 days ago" reads faster than a timestamp when the question is "is this
// recent?", which is the question being asked of every date in this panel. The
// exact value stays available as a tooltip.
function relTime(when) {
  if (!when) { return "never"; }
  const then = (when instanceof Date) ? when : new Date(when);
  if (isNaN(then.getTime())) { return "unknown"; }
  const secs = Math.round((Date.now() - then.getTime()) / 1000);
  if (secs < 0)     { return "just now"; }
  if (secs < 60)    { return secs + "s ago"; }
  const mins = Math.round(secs / 60);
  if (mins < 60)    { return mins + (mins === 1 ? " minute ago" : " minutes ago"); }
  const hours = Math.round(mins / 60);
  if (hours < 24)   { return hours + (hours === 1 ? " hour ago" : " hours ago"); }
  const days = Math.round(hours / 24);
  if (days < 31)    { return days + (days === 1 ? " day ago" : " days ago"); }
  const months = Math.round(days / 30);
  if (months < 12)  { return months + (months === 1 ? " month ago" : " months ago"); }
  const years = Math.round(months / 12);
  return years + (years === 1 ? " year ago" : " years ago");
}


function humanSize(bytes) {
  if (bytes < 1024) { return bytes + " B"; }
  if (bytes < 1024 * 1024) { return (bytes / 1024).toFixed(1) + " KB"; }
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

function msg(el, text, ok) {
  el.textContent = text;
  el.className = "msg show " + (ok ? "ok" : "err");
  if (ok) setTimeout(() => { el.className = "msg"; }, 6000);
}

/* Every request the page makes goes through here, which is the only reason
   mounting the panel under a path costs almost nothing. */
const BASE = "{{BASE}}";

async function api(path, opts) {
  const res = await fetch(BASE + path, Object.assign({credentials: "same-origin"}, opts || {}));
  let data = {};
  try { data = await res.json(); } catch (e) { /* non-JSON error page */ }
  if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));
  return data;
}

const post = (path, body) => api(path, {
  method: "POST",
  headers: {"Content-Type": "application/json", "X-PAU-CSRF": CSRF},
  body: JSON.stringify(body || {}),
});

/* Whether update actions ask first. Deliberately does not apply to deleting
   logs or uninstalling — those are irreversible from here and always confirm. */
let CONFIRM_UPDATES = {{CONFIRM_UPDATES}};

/* Confirm an update action, honouring that preference. Returns true to go
   ahead. The backend still requires its token either way; this only decides
   whether a human is asked. */
async function confirmUpdate(opts) {
  if (!CONFIRM_UPDATES) { return true; }
  return (await dialog(Object.assign({requireText: "UPDATE", danger: true}, opts)))
         === "UPDATE";
}

/* ---- Unsaved changes -----------------------------------------------------
   Nothing on these tabs saves on its own, and it is easy to edit a field,
   switch tab and assume it took. Every editable section tracks whether it has
   been touched since its last save, and says so — on the tab, on the Save
   button, and on the way out of the page. */
const dirty = new Set();

function markDirty(section) {
  if (dirty.has(section)) { return; }
  dirty.add(section);
  paintDirty(section, true);
}

function markClean(section) {
  if (!dirty.delete(section)) { paintDirty(section, false); return; }
  paintDirty(section, false);
}

function paintDirty(section, on) {
  const tab = document.querySelector('.tabs button[data-tab="' + section + '"]');
  if (tab) { tab.classList.toggle("dirty", on); }
  const banner = document.getElementById("unsaved-" + section);
  if (banner) { banner.classList.toggle("hidden", !on); }
  const sec = document.getElementById("tab-" + section);
  if (sec) {
    sec.querySelectorAll("button.primary").forEach((b) => b.classList.toggle("needs-save", on));
  }
  // Unsaved changes on a settings sub-tab must also show on the Settings tab
  // itself, or the indicator is invisible from anywhere else in the panel.
  const settingsBtn = document.querySelector('.tabs:not(.subtabs) button[data-tab="settings"]');
  if (settingsBtn) {
    const anySub = ["exclusions", "schedule", "notify", "config"].some((s) => dirty.has(s));
    settingsBtn.classList.toggle("dirty", anySub);
  }
}

/* Any input inside a tab marks that tab dirty. Registered once, on the
   container, so fields added later are covered without re-binding. */
function watchForChanges() {
  document.querySelectorAll("section[id^='tab-']").forEach((sec) => {
    const name = sec.id.replace(/^tab-/, "");
    const flag = (e) => {
      if (e.target.matches("input, select, textarea")) { markDirty(name); }
    };
    sec.addEventListener("input", flag);
    sec.addEventListener("change", flag);
  });
}

window.addEventListener("beforeunload", (e) => {
  if (dirty.size) { e.preventDefault(); e.returnValue = ""; }
});

/* Proxmox-style dialog. Resolves false on cancel, true on confirm, or the typed
   text when `requireText` is set.

   Replaces confirm()/prompt(), which the browser renders as "An embedded page
   at <host>:8007 says" — visually nothing like Proxmox, and it advertises the
   iframe. */
function dialog(opts) {
  return new Promise((resolve) => {
    const back = document.createElement("div");
    back.className = "modal-back";
    const needsText = !!opts.requireText;

    back.innerHTML =
      '<div class="modal" role="dialog" aria-modal="true">' +
        '<div class="modal-head"></div>' +
        '<div class="modal-body"><div class="mtext"></div>' +
          (needsText
            ? '<label style="margin-top:12px">Type <strong>' + opts.requireText +
              '</strong> to confirm</label>' +
              '<input type="text" autocomplete="off" spellcheck="false">'
            : "") +
        "</div>" +
        '<div class="modal-foot">' +
          '<button class="mcancel">' + (opts.cancelText || "Cancel") + "</button>" +
          '<button class="' + (opts.danger ? "danger" : "primary") + ' mok">' +
            (opts.okText || "OK") + "</button>" +
        "</div>" +
      "</div>";

    back.querySelector(".modal-head").textContent = opts.title || "Confirm";
    back.querySelector(".mtext").innerHTML = opts.message || "";

    const input = back.querySelector("input");
    const okBtn = back.querySelector(".mok");
    if (needsText) { okBtn.disabled = true; }

    const close = (value) => {
      document.removeEventListener("keydown", onKey);
      back.remove();
      resolve(value);
    };
    const accept = () => {
      if (needsText && input.value !== opts.requireText) { return; }
      close(needsText ? input.value : true);
    };
    const onKey = (e) => {
      if (e.key === "Escape") { close(false); }
      if (e.key === "Enter" && !okBtn.disabled) { accept(); }
    };

    if (needsText) {
      input.oninput = () => { okBtn.disabled = input.value !== opts.requireText; };
    }
    okBtn.onclick = accept;
    back.querySelector(".mcancel").onclick = () => close(false);
    back.onclick = (e) => { if (e.target === back) { close(false); } };
    document.addEventListener("keydown", onKey);

    document.body.appendChild(back);
    (needsText ? input : okBtn).focus();
  });
}

/* --- stale-interface watch ------------------------------------------------
   The version this page was served by. If the version on disk stops matching
   it, this page is running the previous release's HTML, CSS and JavaScript,
   and needs reloading.

   This watches the *version*, not the self-update systemd unit. The unit only
   runs for a panel-driven update, so watching it meant a `bash install.sh`
   from the node's shell — the way most upgrades actually happen — finished
   without anything ever saying the open tab had gone stale. A version change
   is a version change however it was made. */
const PAGE_VERSION = "{{VERSION}}";
let versionDriftPrompted = false;

async function checkVersionDrift() {
  if (versionDriftPrompted) { return; }
  let now;
  try {
    now = (await api("/api/self/version")).version;
  } catch (e) {
    return;                       /* mid-restart; the next tick will catch it */
  }
  if (!now || !PAGE_VERSION || now === PAGE_VERSION) { return; }
  versionDriftPrompted = true;
  const go = await dialog({
    title: "Updated to " + now,
    okText: "Reload now",
    cancelText: "Later",
    message:
      "Proxmox Auto-Update is now on version <b>" + now + "</b>." +
      "<p style='margin:10px 0 0'>This page is still showing " +
      PAGE_VERSION + "'s interface. Reloading picks up the new one.</p>" +
      "<p style='margin:10px 0 0;opacity:.75'>Any other Proxmox tabs you have " +
      "open will want a refresh too.</p>",
  });
  if (go) { window.location.reload(); }
}

setInterval(checkVersionDrift, 15000);
/* Also on return to the tab: a laptop asleep through the update comes back to
   the prompt straight away rather than up to fifteen seconds later. */
document.addEventListener("visibilitychange", () => {
  if (!document.hidden) { checkVersionDrift(); }
});
"""


def confirm_updates_flag():
    """CONFIRM_UPDATES as a JS literal. Defaults to true — the safer default is
    the one that applies when the setting has never been touched."""
    return "false" if (read_config().get("CONFIRM_UPDATES") or "").strip() == "false" else "true"


def _shared_js():
    return (SHARED_JS
            .replace("{{BASE}}", base_path())
            .replace("{{CONFIRM_UPDATES}}", confirm_updates_flag())
            .replace("{{VERSION}}", PROCESS_VERSION))


