    ("/etc/pve/local/pveproxy-ssl.pem", "/etc/pve/local/pveproxy-ssl.key"),
    ("/etc/pve/local/pve-ssl.pem", "/etc/pve/local/pve-ssl.key"),
]

# Only these realms/users may control updates. These actions are root-equivalent.
ALLOWED_USERS = {"root@pam"}

# Config keys the UI is allowed to write, with their validators.
INT_RE = re.compile(r"^[0-9]+$")
BOOL_VALUES = {"true", "false"}
CRON_RE = re.compile(r"^\s*\S+\s+\S+\s+\S+\s+\S+\s+\S+\s*$")
TIME_RE = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
IDLIST_RE = re.compile(r"^[0-9]*([,\s]*[0-9]+)*$")
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def _v_int(v):
    return bool(INT_RE.match(v))


def _v_bool(v):
    return v in BOOL_VALUES


def _v_cron(v):
    return bool(CRON_RE.match(v))


def _v_time(v):
    return bool(TIME_RE.match(v))


def _v_idlist(v):
    return v == "" or bool(IDLIST_RE.match(v))


def _v_email(v):
    return bool(EMAIL_RE.match(v))


def _v_region(v):
    return v in {"EU", "US"}


def _v_nonempty(v):
    return len(v.strip()) > 0 and "\n" not in v and '"' not in v


VALID_METHODS = {"email", "discord", "slack", "webhook"}


def _v_methods(v):
    if v.strip() in ("", "none"):
        return True
    return all(part.strip() in VALID_METHODS for part in v.split(",") if part.strip())


def _v_url(v):
    # Empty clears the channel. Otherwise require an https URL — these carry no
    # authentication of their own, so the URL is the secret.
    return v == "" or (v.startswith("https://") and " " not in v and len(v) < 2048)


def _v_optional_email(v):
    return v == "" or _v_email(v)


def _v_optional(v):
    return "\n" not in v and '"' not in v


