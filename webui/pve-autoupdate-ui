def base_path():
    """The path this panel is mounted under, from WEB_UI_PUBLIC_URL, or "".

    Set WEB_UI_PUBLIC_URL to something with a path — say
    https://proxmox.example.com/pau — and the panel can be published as one more
    route on a proxy that already fronts Proxmox, instead of needing a hostname
    and a certificate of its own. Same origin as the Proxmox UI, so the toolbar
    button's status fetch stops being a cross-origin credentialed request too.

    Read fresh rather than cached at import: the config is edited by the panel
    itself, and a stale prefix would route every request to the wrong place.
    """
    url = (read_config().get("WEB_UI_PUBLIC_URL") or "").strip()
    if not url:
        return ""
    try:
        path = urllib.parse.urlparse(url).path or ""
    except ValueError:
        return ""
    path = "/" + path.strip("/")
    return "" if path == "/" else path


def strip_base(path):
    """Routing sees the same paths whether or not a prefix is in use.

    Direct access on the panel's own port has no prefix, and the installer's
    health probe uses exactly that, so stripping is conditional rather than
    required — both forms have to keep working or a path-mounted panel becomes
    unmonitorable from the node itself.
    """
    prefix = base_path()
    if prefix and (path == prefix or path.startswith(prefix + "/")):
        return path[len(prefix):] or "/"
    return path


def _v_public_url(v):
    """Empty, or an http(s) origin safe to interpolate into JavaScript.

    This value is written into pvemanagerlib.js by the patcher, inside a
    single-quoted JS string, so a quote or a newline in it would be a script
    injection into the Proxmox UI rather than a formatting mistake.
    """
    if v == "":
        return True
    if len(v) > 200 or not re.match(r"\Ahttps?://[A-Za-z0-9._~:@/-]+\Z", v):
        return False
    return True



