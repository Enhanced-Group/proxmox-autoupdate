# Config keys the UI is allowed to write, with their validators.
INT_RE = re.compile(r"^[0-9]+$")
BOOL_VALUES = {"true", "false"}
# \A and \Z, not ^ and $: in Python ^/$ also match either side of an embedded
# newline, so "0 3 * * *\nrm -rf /" satisfied a ^...$ cron pattern. \s likewise
# matches a newline, which let multi-line values through the id-list and cron
# checks and straight into the root crontab and the sourced config file.
CRON_RE = re.compile(r"\A[ \t]*\S+[ \t]+\S+[ \t]+\S+[ \t]+\S+[ \t]+\S+[ \t]*\Z")
TIME_RE = re.compile(r"\A([01][0-9]|2[0-3]):[0-5][0-9]\Z")
IDLIST_RE = re.compile(r"\A[0-9]*([,\t ]*[0-9]+)*\Z")
EMAIL_RE = re.compile(r"\A[^@\s]+@[^@\s]+\.[^@\s]+\Z")

# Characters that must never reach the config file.
#
# /etc/proxmox-autoupdate.conf is `source`d by update-everything.sh as root, and
# values were written into double quotes, where bash still expands $, backticks
# and \. A webhook URL containing "$" aborted the entire run under `set -u`
# ("bar: unbound variable") before a single guest was touched; a backtick or
# $(...) executed as root on the next scheduled run.
#
# Values are now single-quoted on write, which makes this defence in depth
# rather than the only line — but a cron expression also reaches crontab(1)
# directly, so rejecting these outright is still worth doing.
_SHELL_META_RE = re.compile(r"[$`\\\r\n\x00]")


def _has_shell_meta(v):
    return bool(_SHELL_META_RE.search(v))


# The Host header is attacker-controlled, and it is interpolated into a CSP
# header. Only ever emit something that cannot break out of the directive.
_SAFE_HOST_RE = re.compile(r"\A[A-Za-z0-9._-]{1,253}\Z")


def _v_int(v):
    # Empty means "not set, use the built-in default". The script reads every
    # one of these as ${KEY:-default}, so an empty value in the config is
    # equivalent to the key being absent — and rejecting empty here made any
    # setting that was not already in a user's config file impossible to save,
    # because the form posts every field it renders.
    return v == "" or bool(INT_RE.match(v))


