async function loadSnapshots() {
  setTimeout(() => markClean('snapshots'), 0);
  const tbody = $("snapList");
  try {
    const data = await api("/api/snapshots");
    SNAP_ROWS = [];
    tbody.innerHTML = "";
    let rows = 0;
    (data.guests || []).forEach((g) => {
      if (g.snapshots === null) {
        const tr = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5;
        td.textContent = g.vmid + " (" + g.name + ") — could not read snapshots: " +
                         (g.error || "unknown error");
        td.style.color = "var(--warn)";
        tr.appendChild(td);
        tbody.appendChild(tr);
        rows++;
        return;
      }
      (g.snapshots || []).forEach((snap) => {
        rows++;
        const tr = document.createElement("tr");

        const cbCell = document.createElement("td");
        if (snap.ours) {
          const box = document.createElement("input");
          box.type = "checkbox";
          box.style.width = "auto";
          box.dataset.vmid = g.vmid;
          box.dataset.name = snap.name;
