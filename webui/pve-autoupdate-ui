// --- tabs ---
// Top-level navigation. Four sections rather than seven: Exclusions, Schedule,
// Notifications and Configuration are all "set this up once", so they live
// together under Settings, while Overview and Logs are the day-to-day.
const TOP_TABS = ["run", "settings", "logs", "maint"];
const SUB_TABS = ["exclusions", "schedule", "notify", "snapshots", "config"];

function loadFor(name) {
  if (name === "run")        { loadRunGuests(); }
  if (name === "logs")       { loadLogList(); loadLogCfg(); }
  if (name === "exclusions") { loadGuests(); }
  if (name === "schedule")   { loadSchedules(); }
  if (name === "notify")     { loadNotify(); }
  if (name === "snapshots")  { loadSnapshots(); }
  if (name === "config")     { loadConfig(); }
  if (name === "maint")      { loadMaint(); }
}

function selectTop(name) {
  if (name !== activeTopTab() && !mayLeaveSection()) { return; }
  document.querySelectorAll(".tabs:not(.subtabs) button").forEach((b) => {
    const on = b.dataset.tab === name;
    b.classList.toggle("active", on);
    b.setAttribute("aria-selected", on ? "true" : "false");
    b.tabIndex = on ? 0 : -1;
  });
  TOP_TABS.forEach((t) => $("tab-" + t).classList.toggle("hidden", t !== name));
  if (name === "settings") {
    // Show the sub-section as well as its container. Loading the data without
    // unhiding the section left Settings looking empty on first open — the
    // content was there, behind `hidden`, until a sub-tab click revealed it.
    // selectSub does both, so go through it rather than repeating half of it.
    selectSub(currentSub);
  } else {
    loadFor(name);
  }
}

let currentSub = "exclusions";
function selectSub(name) {
  if (name !== currentSub && !mayLeaveSection()) { return; }
  currentSub = name;
  document.querySelectorAll(".subtabs button").forEach((b) => {
    const on = b.dataset.tab === name;
    b.classList.toggle("active", on);
    b.setAttribute("aria-selected", on ? "true" : "false");
    b.tabIndex = on ? 0 : -1;
  });
  SUB_TABS.forEach((t) => $("tab-" + t).classList.toggle("hidden", t !== name));
  loadFor(name);
}

// Arrow-key navigation, which is what a tablist is expected to do and what
// these were missing entirely — they were styled buttons with no roles.
function wireTablist(selector, onSelect) {
  const buttons = Array.from(document.querySelectorAll(selector));
  buttons.forEach((btn, i) => {
    btn.onclick = () => onSelect(btn.dataset.tab);
    btn.onkeydown = (ev) => {
      let next = null;
      if (ev.key === "ArrowRight") { next = buttons[(i + 1) % buttons.length]; }
      if (ev.key === "ArrowLeft")  { next = buttons[(i - 1 + buttons.length) % buttons.length]; }
      if (ev.key === "Home")       { next = buttons[0]; }
      if (ev.key === "End")        { next = buttons[buttons.length - 1]; }
      if (next) { ev.preventDefault(); next.focus(); onSelect(next.dataset.tab); }
    };
  });
}

wireTablist(".tabs:not(.subtabs) button", selectTop);
wireTablist(".subtabs button", selectSub);

// --- unsaved-change guard ---
//
// Leaving a tab with edits on it silently discarded them: nothing was posted,
// and coming back re-read the saved values. Rather than a save button that
// follows you around, navigation is blocked while a section is dirty and you
// are taken to the control that resolves it.
//
// There is always a way out — being unable to leave a form you have changed
// your mind about would be worse than losing the edit.
const SECTION_SAVE_BTN = {
  exclusions: "btnSaveExcl",
  schedule:   "btnSaveSched",
  notify:     "btnSaveNotify",
  config:     "btnSaveConfig",
  logs:       "btnSaveLogCfg",
  maint:      "btnSaveConfirm",
};

function activeTopTab() {
  const top = document.querySelector('.tabs:not(.subtabs) button.active');
  return top ? top.dataset.tab : "run";
}

function activeSection() {
  const name = activeTopTab();
  return name === "settings" ? currentSub : name;
}

// True when it is safe to navigate. When it is not, point at what needs doing.
function mayLeaveSection() {
  const section = activeSection();
  if (!dirty.has(section)) { return true; }

  const banner = $("unsaved-" + section);
  const btn = $(SECTION_SAVE_BTN[section]);
  if (banner) {
    banner.classList.remove("hidden");
    banner.scrollIntoView({behavior: "smooth", block: "nearest"});
    // Re-trigger the attention animation even if the class is already on.
    banner.classList.remove("attention");
    void banner.offsetWidth;
    banner.classList.add("attention");
  }
  if (btn) {
    btn.classList.add("needs-save");
    btn.focus({preventScroll: true});
    btn.scrollIntoView({behavior: "smooth", block: "center"});
  }
  return false;
}

// Discard: reload the section from what is actually saved, which is also the
// escape hatch out of the guard above.
function discardSection(section) {
  markClean(section);
  loadFor(section);
}
document.querySelectorAll(".unsaved [data-discard]").forEach((el) => {
  el.onclick = () => discardSection(el.dataset.discard);
});

// --- notifications ---
const METHOD_IDS = {email: "m_email", discord: "m_discord", slack: "m_slack",
                    teams: "m_teams", ntfy: "m_ntfy", gotify: "m_gotify",
                    telegram: "m_telegram", webhook: "m_webhook"};
const METHOD_CARDS = {m_email: "cardEmail", m_discord: "cardDiscord",
                      m_slack: "cardSlack", m_teams: "cardTeams",
                      m_ntfy: "cardNtfy", m_gotify: "cardGotify",
                      m_telegram: "cardTelegram", m_webhook: "cardWebhook"};

function syncNotifyCards() {
  Object.keys(METHOD_CARDS).forEach((box) => {
    $(METHOD_CARDS[box]).style.display = $(box).checked ? "" : "none";
  });
  // The email card shows either the Mailgun fields or the SMTP fields.
  const smtp = $("cfg2_EMAIL_TRANSPORT").value === "smtp";
  $("emailMailgun").style.display = smtp ? "none" : "";
  $("emailSmtp").style.display = smtp ? "" : "none";
}
Object.values(METHOD_IDS).forEach((id) => { $(id).onchange = syncNotifyCards; });
$("cfg2_EMAIL_TRANSPORT").onchange = syncNotifyCards;

async function loadNotify() {
  // Populating fields is not an edit.
  setTimeout(() => markClean('notify'), 0);
  try {
    const data = await api("/api/config");
    const cfg = data.config, sensitive = data.sensitive;
    const active = (cfg.NOTIFY_METHODS || "").split(",").map((s) => s.trim());
    Object.entries(METHOD_IDS).forEach(([m, id]) => { $(id).checked = active.includes(m); });
    $("failOnly").checked = cfg.NOTIFY_ON_FAILURE_ONLY === "true";
    document.querySelectorAll("#tab-notify [data-key]").forEach((el) => {
      const k = el.dataset.key;
      // Checkboxes are ticked, not assigned a value — setting .value on one
      // leaves it visually unticked whatever the setting actually says.
      if (el.type === "checkbox") { el.checked = cfg[k] === "true"; return; }
      el.value = sensitive.includes(k) && cfg[k] ? "********" : (cfg[k] || "");
    });
    syncNotifyCards();
  } catch (e) { msg($("notifyMsg"), e.message, false); }
}

function collectNotify() {
  const methods = Object.entries(METHOD_IDS)
    .filter(([, id]) => $(id).checked).map(([m]) => m);
  const cfg = {
    NOTIFY_METHODS: methods.join(","),
    NOTIFY_ON_FAILURE_ONLY: $("failOnly").checked ? "true" : "false",
  };
  document.querySelectorAll("#tab-notify [data-key]").forEach((el) => {
    // A checkbox's .value is "on" regardless of whether it is ticked, which
    // would save "on" into a setting the script reads as a boolean and the
    // validator rejects outright.
    cfg[el.dataset.key] = el.type === "checkbox"
      ? (el.checked ? "true" : "false")
      : el.value;
  });
  return cfg;
}

$("btnSaveNotify").onclick = async () => {
  try {
    await post("/api/config", {config: collectNotify()});
    markClean("notify");
    msg($("notifyMsg"), "Notification settings saved.", true);
  } catch (e) { msg($("notifyMsg"), e.message, false); }
};

$("btnDiagDiscord").onclick = async () => {
  const btn = $("btnDiagDiscord");
  btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Checking…';
  $("notifyOut").classList.add("hidden");
  try {
    // Save first, so the diagnosis reflects what is on screen.
    await post("/api/config", {config: collectNotify()});
    markClean("notify");
    const r = await post("/api/notify/diagnose-discord", {});
    const lines = r.steps.map((s) => (s.ok ? "PASS  " : "FAIL  ") + s.step + " — " + s.detail);
    $("notifyOut").textContent = lines.join("\n");
    $("notifyOut").classList.remove("hidden");
    msg($("notifyMsg"), r.ok
        ? "Discord DM works — check your direct messages."
        : "Discord DM failed. The failing step is shown below.", r.ok);
  } catch (e) {
    msg($("notifyMsg"), e.message, false);
  } finally {
    btn.disabled = false; btn.textContent = "Diagnose Discord DM";
  }
};

$("btnTestNotify").onclick = async () => {
  const btn = $("btnTestNotify");
  btn.disabled = true; btn.textContent = "Sending…";
  $("notifyOut").classList.add("hidden");
  try {
    // Save first, so the test exercises what is on screen.
    await post("/api/config", {config: collectNotify()});
    const res = await post("/api/notify/test", {});
    msg($("notifyMsg"), res.ok ? "Test sent — check your channel." : "Test reported a problem.", res.ok);
    $("notifyOut").textContent = res.detail || "";
    $("notifyOut").classList.remove("hidden");
  } catch (e) {
    msg($("notifyMsg"), e.message, false);
  } finally {
    btn.disabled = false; btn.textContent = "Send test notification";
  }
};

// --- log settings ---
async function loadLogCfg() {
  setTimeout(() => markClean('logs'), 0);
  try {
    const s = await api("/api/logs/stats");
    $("keepLogs").value = s.keep_logs === "false" ? "false" : "true";
    $("retentionDays").value = s.retention_days;
    $("logPath").value = s.dir;
    const mb = (s.bytes / 1048576).toFixed(1);
    $("logUsage").textContent = s.count + " file(s), " + mb + " MB" +
      (s.oldest ? " · oldest " + new Date(s.oldest * 1000).toLocaleDateString() : "");
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
}

$("btnSaveLogCfg").onclick = async () => {
  try {
    await post("/api/config", {config: {
      KEEP_LOGS: $("keepLogs").value,
      LOG_RETENTION_DAYS: $("retentionDays").value,
    }});
    markClean("logs");
    msg($("logCfgMsg"), "Log settings saved.", true);
    loadLogCfg();
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
};

$("btnPurgeLogs").onclick = async () => {
  const go = await dialog({
    title: "Delete stored logs",
    message: "Delete every stored update log?<br><br>" +
             "The log of a run currently in progress is kept.",
    okText: "Delete", danger: true,
  });
  if (!go) return;
  try {
    const res = await post("/api/logs/purge", {});
    msg($("logCfgMsg"), "Deleted " + res.removed + " log file(s).", true);
    loadLogCfg(); loadLogList();
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
};

// --- maintenance ---
/* A self-update restarts this very service, so its progress can't live in the
   page — it is read back from systemd and polled until the unit settles. */
let maintPoll = null;

/* Offered once the new version is confirmed running. The reload is genuinely
   needed — this page and the Proxmox UI around it are both still running the
   previous version's JavaScript — but it is a normal end-of-update step, not a
   warning, so it reads as one. */
async function offerReload(version) {
  // This prompt always fires, embedded or not.
  //
  // It was briefly suppressed when embedded, on the assumption that the
  // toolbar patch would prompt instead. It often does not: the toolbar polls
  // every 25 seconds when idle, and the panel service is restarting for part of
  // that window, so its status fetch fails and it never observes the update
  // happening at all. The panel is driving the update and polling every two
  // seconds, so it is the reliable detector — and it is the window being looked
  // at. The toolbar suppresses its own prompt while this panel is open instead.
  const go = await dialog({
    title: "Updated to " + version,
    okText: "Reload now",
    cancelText: "Later",
    message:
      "All done." +
      "<p style='margin:10px 0 0'>This page is still showing the previous " +
      "version's interface. Reloading picks up the new one.</p>" +
      "<p style='margin:10px 0 0;opacity:.75'>Any other Proxmox tabs you have " +
      "open will want a refresh too.</p>",
  });
  if (go) { window.location.reload(); }
}

function renderMaintState(v) {
  const busy = !!v.busy;
  const btn = $("btnSelfUpdate");
  btn.disabled = busy;
  $("btnCheckUpdate").disabled = busy;
  $("maintProgress").classList.toggle("active", busy);

  // Three distinct stages, because "installing" covers a stretch where the
  // panel itself restarts and the version briefly still reads as the old one.
  const stage = $("installStage");
  stage.classList.toggle("hidden", !busy);
  $("reloadWarning").classList.toggle("hidden", !busy);
  if (busy) {
    btn.classList.remove("hidden");
    btn.innerHTML = '<span class="spinner"></span>Installing…';
    if (v.self_update === "active" || v.self_update === "activating") {
      stage.textContent = "Downloading and running the installer…";
    } else if (v.pending) {
      stage.textContent = "Installed — waiting for the panel to come back on " +
                          v.pending + "…";
    } else {
      stage.textContent = "Working…";
    }
  } else {
    btn.textContent = "Install update now";
  }

  if (v.self_update === "failed") {
    msg($("verMsg"), "The update failed. Check: journalctl -u pve-autoupdate-selfupdate", false);
  } else if (v.uninstall === "failed") {
    msg($("uninstallMsg"), "The uninstall failed. Check: journalctl -u pve-autoupdate-uninstall", false);
  }
  return busy;
}

// --- changelog -------------------------------------------------------------
function renderChangelog(data) {
  const box = $("changelog");
  if (!data.entries || !data.entries.length) {
    box.textContent = data.warning || "No changelog available.";
    return;
  }
  $("clSource").textContent = data.warning || "";
  box.innerHTML = "";
  data.entries.forEach((e, i) => {
    const wrap = document.createElement("div");
    wrap.style.cssText = i ? "margin-top:14px;opacity:.72" : "";
    const isInstalled = e.version === data.installed;
    const head = document.createElement("div");
    head.style.cssText = "font-size:13px;color:var(--text);margin-bottom:4px";
    head.innerHTML = "<strong>" + e.version + "</strong>" +
      (e.date ? ' <span style="opacity:.6">· ' + e.date + "</span>" : "") +
      (isInstalled ? ' <span class="pill ok">installed</span>'
                   : (i === 0 ? ' <span class="pill warn-pill">new</span>' : ""));
    wrap.appendChild(head);
    Object.keys(e.sections).forEach((name) => {
      const items = e.sections[name];
      if (!items.length) return;
      const h = document.createElement("div");
      h.style.cssText = "margin-top:6px;font-size:11px;text-transform:uppercase;" +
                        "letter-spacing:.05em;color:var(--muted)";
      h.textContent = name;
      wrap.appendChild(h);
      const ul = document.createElement("ul");
      ul.style.cssText = "margin:3px 0 0 16px;padding:0;font-size:12px;line-height:1.5";
      items.forEach((t) => {
        const li = document.createElement("li");
        li.textContent = t;
        ul.appendChild(li);
      });
      wrap.appendChild(ul);
    });
    box.appendChild(wrap);
  });
}

