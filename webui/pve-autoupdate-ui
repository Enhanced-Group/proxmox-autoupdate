<script>
const CSRF = "{{CSRF}}";

const FIELDS = [
  ["MAILGUN_API_KEY",        "Mailgun API key",          "password"],
  ["MAILGUN_DOMAIN",         "Mailgun domain",           "text"],
  ["MAILGUN_REGION",         "Mailgun region",           "select", ["EU", "US"]],
  ["SENDER_EMAIL",           "Sender email",             "text"],
  ["RECIPIENT_EMAIL",        "Recipient email",          "text"],
  ["EXCLUDE_IDS",            "Excluded VM/CT IDs",       "text"],
  ["WINDOWS_UPDATE_TIMEOUT", "Windows timeout (s)",      "number"],
  ["LINUX_UPDATE_TIMEOUT",   "Linux timeout (s)",        "number"],
  ["APT_LOCK_TIMEOUT",       "APT lock wait (s)",        "number"],
  ["START_STOPPED_LXC",      "Start stopped LXC",        "select", ["true", "false"]],
  ["START_STOPPED_LINUX_VMS","Start stopped Linux VMs",  "select", ["true", "false"]],
  ["START_STOPPED_WINDOWS",  "Start stopped Windows VMs","select", ["true", "false"]],
  ["SNAPSHOT_BEFORE_UPDATE", "Snapshot before update",   "select", ["true", "false"]],
  ["SNAPSHOT_KEEP",          "Snapshots to keep",        "number"],
  ["REBOOT_TIME",            "Reboot time (HH:MM)",      "text"],
];

const $ = (id) => document.getElementById(id);

function msg(el, text, ok) {
  el.textContent = text;
  el.className = "msg show " + (ok ? "ok" : "err");
  if (ok) setTimeout(() => { el.className = "msg"; }, 6000);
}

async function api(path, opts) {
  const res = await fetch(path, Object.assign({credentials: "same-origin"}, opts || {}));
  let data = {};
  try { data = await res.json(); } catch (e) { /* non-JSON error page */ }
  if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));
  return data;
}

const post = (path, body) => api(path, {
  method: "POST",
  headers: {"Content-Type": "application/json", "X-PAU-CSRF": CSRF},
  body: JSON.stringify(body || {}),
});

// --- tabs ---
document.querySelectorAll(".tabs button").forEach((btn) => {
  btn.onclick = () => {
    document.querySelectorAll(".tabs button").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    ["run", "exclusions", "schedule", "notify", "config", "logs", "maint"].forEach((name) => {
      $("tab-" + name).classList.toggle("hidden", name !== btn.dataset.tab);
    });
    if (btn.dataset.tab === "logs") { loadLogList(); loadLogCfg(); }
    if (btn.dataset.tab === "exclusions") loadGuests();
    if (btn.dataset.tab === "notify") loadNotify();
    if (btn.dataset.tab === "maint") loadMaint();
  };
});

// --- notifications ---
const METHOD_IDS = {email: "m_email", discord: "m_discord",
                    slack: "m_slack", webhook: "m_webhook"};

function syncNotifyCards() {
  $("cardEmail").style.display   = $("m_email").checked ? "" : "none";
  $("cardDiscord").style.display = $("m_discord").checked ? "" : "none";
  $("cardSlack").style.display   = $("m_slack").checked ? "" : "none";
  $("cardWebhook").style.display = $("m_webhook").checked ? "" : "none";
}
Object.values(METHOD_IDS).forEach((id) => { $(id).onchange = syncNotifyCards; });

async function loadNotify() {
  try {
    const data = await api("/api/config");
    const cfg = data.config, sensitive = data.sensitive;
    const active = (cfg.NOTIFY_METHODS || "").split(",").map((s) => s.trim());
    Object.entries(METHOD_IDS).forEach(([m, id]) => { $(id).checked = active.includes(m); });
    $("failOnly").checked = cfg.NOTIFY_ON_FAILURE_ONLY === "true";
    document.querySelectorAll("#tab-notify [data-key]").forEach((el) => {
      const k = el.dataset.key;
      el.value = sensitive.includes(k) && cfg[k] ? "********" : (cfg[k] || "");
    });
    syncNotifyCards();
  } catch (e) { msg($("notifyMsg"), e.message, false); }
}

function collectNotify() {
  const methods = Object.entries(METHOD_IDS)
    .filter(([, id]) => $(id).checked).map(([m]) => m);
  const cfg = {
    NOTIFY_METHODS: methods.join(","),
    NOTIFY_ON_FAILURE_ONLY: $("failOnly").checked ? "true" : "false",
  };
  document.querySelectorAll("#tab-notify [data-key]").forEach((el) => {
    cfg[el.dataset.key] = el.value;
  });
  return cfg;
}

$("btnSaveNotify").onclick = async () => {
  try {
    await post("/api/config", {config: collectNotify()});
    msg($("notifyMsg"), "Notification settings saved.", true);
  } catch (e) { msg($("notifyMsg"), e.message, false); }
};

$("btnTestNotify").onclick = async () => {
  const btn = $("btnTestNotify");
  btn.disabled = true; btn.textContent = "Sending…";
  $("notifyOut").classList.add("hidden");
  try {
    // Save first, so the test exercises what is on screen.
    await post("/api/config", {config: collectNotify()});
    const res = await post("/api/notify/test", {});
    msg($("notifyMsg"), res.ok ? "Test sent — check your channel." : "Test reported a problem.", res.ok);
    $("notifyOut").textContent = res.detail || "";
    $("notifyOut").classList.remove("hidden");
  } catch (e) {
    msg($("notifyMsg"), e.message, false);
  } finally {
    btn.disabled = false; btn.textContent = "Send test notification";
  }
};

// --- log settings ---
async function loadLogCfg() {
  try {
    const s = await api("/api/logs/stats");
    $("keepLogs").value = s.keep_logs === "false" ? "false" : "true";
    $("retentionDays").value = s.retention_days;
    $("logPath").value = s.dir;
    const mb = (s.bytes / 1048576).toFixed(1);
    $("logUsage").textContent = s.count + " file(s), " + mb + " MB" +
      (s.oldest ? " · oldest " + new Date(s.oldest * 1000).toLocaleDateString() : "");
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
}

$("btnSaveLogCfg").onclick = async () => {
  try {
    await post("/api/config", {config: {
      KEEP_LOGS: $("keepLogs").value,
      LOG_RETENTION_DAYS: $("retentionDays").value,
    }});
    msg($("logCfgMsg"), "Log settings saved.", true);
    loadLogCfg();
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
};

$("btnPurgeLogs").onclick = async () => {
  if (!confirm("Delete all stored update logs?\n\nThe log of a run in progress is kept.")) return;
  try {
    const res = await post("/api/logs/purge", {});
    msg($("logCfgMsg"), "Deleted " + res.removed + " log file(s).", true);
    loadLogCfg(); loadLogList();
  } catch (e) { msg($("logCfgMsg"), e.message, false); }
};

// --- maintenance ---
async function loadMaint() {
  try {
    const v = await api("/api/self/version");
    $("verInstalled").textContent = v.version;
  } catch (e) { $("verInstalled").textContent = "unknown"; }

  try {
    const h = await api("/api/history");
    const tbody = $("histList");
    tbody.innerHTML = "";
    if (!h.runs.length) {
      tbody.innerHTML = "<tr><td colspan='4'>No runs recorded yet.</td></tr>";
    } else {
      h.runs.forEach((r) => {
        const tr = document.createElement("tr");
        const when = r.finished ? new Date(r.finished).toLocaleString() : "—";
        const bad = (r.result || "").indexOf("error") === 0;
        tr.innerHTML =
          "<td>" + when + "</td>" +
          "<td><span class='pill " + (bad ? "err" : "ok") + "'>" + (r.result || "?") + "</span></td>" +
          "<td>" + (r.scope || "all") + "</td>" +
          "<td>" + ((r.failed || []).join(", ") || "—") + "</td>";
        tbody.appendChild(tr);
      });
    }
    $("offenders").textContent = h.repeat_offenders
      ? "Repeatedly failing: " + h.repeat_offenders : "";
  } catch (e) {
    $("histList").innerHTML = "<tr><td colspan='4'>" + e.message + "</td></tr>";
  }
}

$("btnCheckUpdate").onclick = async () => {
  const btn = $("btnCheckUpdate");
  btn.disabled = true; btn.textContent = "Checking…";
  try {
    const r = await post("/api/self/check", {});
    if (r.error) {
      msg($("verMsg"), r.error, false);
    } else if (r.update_available) {
      msg($("verMsg"), "Version " + r.latest + " is available (you have " + r.current + ").", true);
      $("verActions").classList.remove("hidden");
    } else {
      msg($("verMsg"), "Up to date (" + r.current + ").", true);
      $("verActions").classList.add("hidden");
    }
  } catch (e) { msg($("verMsg"), e.message, false); }
  finally { btn.disabled = false; btn.textContent = "Check for updates"; }
};

$("btnSelfUpdate").onclick = async () => {
  if (prompt("Install the new version now?\n\nType UPDATE to confirm:") !== "UPDATE") return;
  try {
    const r = await post("/api/self/update", {confirm: "UPDATE"});
    msg($("verMsg"), r.detail, true);
  } catch (e) { msg($("verMsg"), e.message, false); }
};

$("btnUninstall").onclick = async () => {
  const purge = $("purgeToo").checked;
  // Deliberately two steps: a plain-language confirm, then a typed word.
  const warning = "This will remove Proxmox Auto-Update from this node:\n\n" +
    "  • the updater and its schedule\n" +
    "  • this control panel and its service\n" +
    "  • the button in the Proxmox UI\n" +
    (purge ? "  • your configuration and ALL logs\n" : "  • (config and logs will be kept)\n") +
    "\nThis panel will stop responding once it starts.\n\nContinue?";
  if (!confirm(warning)) return;
  if (prompt("Final step.\n\nType UNINSTALL to confirm:") !== "UNINSTALL") {
    msg($("uninstallMsg"), "Cancelled.", false);
    return;
  }
  try {
    const r = await post("/api/self/uninstall",
                         {confirm: "UNINSTALL", acknowledged: true, purge: purge});
    msg($("uninstallMsg"), r.detail, true);
    $("btnUninstall").disabled = true;
  } catch (e) { msg($("uninstallMsg"), e.message, false); }
};

// --- exclusions ---
async function loadGuests() {
  const tbody = $("guestList");
  try {
    const data = await api("/api/guests");
    tbody.innerHTML = "";
    if (!data.guests.length) {
      tbody.innerHTML = "<tr><td colspan='5'>No guests found.</td></tr>";
      return;
    }
    data.guests.forEach((g) => {
      const tr = document.createElement("tr");
      const box = document.createElement("input");
      box.type = "checkbox";
      box.checked = g.excluded;
      box.dataset.vmid = g.vmid;
      box.style.width = "auto";
      box.onchange = updateExclCount;

      const td = document.createElement("td");
      td.appendChild(box);
      tr.appendChild(td);
      [g.vmid, g.name, g.type === "lxc" ? "LXC" : "VM", g.status].forEach((val) => {
        const cell = document.createElement("td");
        cell.textContent = val;
        if (val === "stopped") cell.style.color = "var(--muted)";
        tr.appendChild(cell);
      });
      tbody.appendChild(tr);
    });
    updateExclCount();
  } catch (e) {
    tbody.innerHTML = "<tr><td colspan='5'>" + e.message + "</td></tr>";
  }
}

function updateExclCount() {
  const boxes = document.querySelectorAll("#guestList input[type=checkbox]");
  const n = Array.from(boxes).filter((b) => b.checked).length;
  $("exclCount").textContent = n + " of " + boxes.length + " excluded";
}

$("btnRefreshGuests").onclick = loadGuests;
$("btnExcludeNone").onclick = () => {
  document.querySelectorAll("#guestList input[type=checkbox]").forEach((b) => { b.checked = false; });
  updateExclCount();
};

$("btnSaveExcl").onclick = async () => {
  const ids = Array.from(document.querySelectorAll("#guestList input[type=checkbox]"))
    .filter((b) => b.checked).map((b) => b.dataset.vmid);
  try {
    const res = await post("/api/exclusions", {excluded: ids});
    msg($("exclMsg"), res.excluded.length
        ? "Excluded: " + res.excluded.join(", ")
        : "No guests are excluded.", true);
  } catch (e) { msg($("exclMsg"), e.message, false); }
};

// --- status + live log ---
let logOffset = 0, activeLog = null, wasRunning = false;

async function poll() {
  try {
    const st = await api("/api/status");
    const pill = $("statusPill");
    if (st.running) {
      pill.className = "pill run";
      pill.textContent = (st.dry_run ? "dry run" : "updating") + " …";
    } else if (st.lock_held) {
      pill.className = "pill run";
      pill.textContent = "scheduled run in progress";
    } else if (st.returncode === 0) {
      pill.className = "pill ok"; pill.textContent = "last run OK";
    } else if (st.returncode !== null && st.returncode !== undefined) {
      pill.className = "pill err"; pill.textContent = "last run failed (" + st.returncode + ")";
    } else {
      pill.className = "pill idle"; pill.textContent = "idle";
    }
    $("schedDisplay").textContent = st.schedule || "not scheduled";

    $("btnDry").disabled = st.running || st.lock_held;
    $("btnFull").disabled = st.running || st.lock_held;

    if (st.log && st.log !== activeLog) { activeLog = st.log; logOffset = 0; $("logView").textContent = ""; }
    if (activeLog) await pumpLog();
    if (wasRunning && !st.running) await pumpLog();
    wasRunning = st.running;
  } catch (e) {
    const pill = $("statusPill");
    pill.className = "pill err";
    pill.textContent = e.message;
  }
}

async function pumpLog() {
  const data = await api("/api/log?name=" + encodeURIComponent(activeLog) + "&offset=" + logOffset);
  if (data.data) {
    const view = $("logView");
    const atBottom = view.scrollTop + view.clientHeight >= view.scrollHeight - 30;
    view.textContent += data.data;
    if (atBottom) view.scrollTop = view.scrollHeight;
  }
  logOffset = data.offset;
}

$("btnDry").onclick = async () => {
  try {
    await post("/api/run", {dry_run: true});
    msg($("runMsg"), "Dry run started — nothing will be installed.", true);
    logOffset = 0; activeLog = null;
  } catch (e) { msg($("runMsg"), e.message, false); }
};

$("btnFull").onclick = async () => {
  const typed = prompt(
    "This updates the Proxmox host and every guest right now.\n\n" +
    "Type UPDATE to confirm:");
  if (typed !== "UPDATE") { msg($("runMsg"), "Cancelled.", false); return; }
  try {
    await post("/api/run", {dry_run: false, confirm: "UPDATE"});
    msg($("runMsg"), "Full update started.", true);
    logOffset = 0; activeLog = null;
  } catch (e) { msg($("runMsg"), e.message, false); }
};

// --- schedule ---
$("schedPreset").onchange = () => {
  const v = $("schedPreset").value;
  if (v !== "__custom") $("schedCron").value = v;
};

$("btnSaveSched").onclick = async () => {
  try {
    await post("/api/schedule", {cron: $("schedCron").value.trim()});
    const reboot = $("rebootTime").value.trim();
    if (reboot) await post("/api/config", {config: {REBOOT_TIME: reboot}});
    msg($("schedMsg"), "Schedule saved and crontab updated.", true);
    poll();
  } catch (e) { msg($("schedMsg"), e.message, false); }
};

// --- config ---
function buildConfigForm(cfg, sensitive) {
  const form = $("configForm");
  form.innerHTML = "";
  FIELDS.forEach(([key, label, type, options]) => {
    const wrap = document.createElement("div");
    const lab = document.createElement("label");
    lab.textContent = label; lab.htmlFor = "cfg_" + key;
    wrap.appendChild(lab);

    let input;
    if (type === "select") {
      input = document.createElement("select");
      options.forEach((opt) => {
        const o = document.createElement("option");
        o.value = o.textContent = opt;
        input.appendChild(o);
      });
    } else {
      input = document.createElement("input");
      input.type = type === "password" ? "password" : (type === "number" ? "number" : "text");
    }
    input.id = "cfg_" + key;
    input.dataset.key = key;
    input.value = sensitive.includes(key) && cfg[key] ? "********" : (cfg[key] || "");
    wrap.appendChild(input);
    form.appendChild(wrap);
  });
}

async function loadConfig() {
  try {
    const data = await api("/api/config");
    buildConfigForm(data.config, data.sensitive);
