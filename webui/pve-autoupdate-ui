    return (PAGE_TEMPLATE
            .replace("{{BASE}}", base_path())
            .replace("{{CSS}}", SHARED_CSS + theme_css())
            .replace("{{JS}}", _shared_js())
            .replace("{{USER}}", html.escape(user))
            .replace("{{CSRF}}", csrf))


def render_guest_page(user, csrf, vmid, name):
    # vmid is already known to be all digits, so it is safe to inline into JS.
    return (GUEST_TEMPLATE
            .replace("{{BASE}}", base_path())
            .replace("{{CSS}}", SHARED_CSS + theme_css())
            .replace("{{JS}}", _shared_js())
            .replace("{{USER}}", html.escape(user))
            .replace("{{CSRF}}", csrf)
            .replace("{{VMID}}", html.escape(vmid))
            .replace("{{NAME}}", html.escape(name or "")))


