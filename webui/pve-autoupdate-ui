        } else {
          cbCell.textContent = "—";
          cbCell.style.color = "var(--muted)";
          cbCell.title = "Not created by this tool";
        }
        tr.appendChild(cbCell);

        [g.vmid + " " + (g.name || ""), snap.name, snapWhen(snap.snaptime),
         snap.description || ""].forEach((val) => {
          const cell = document.createElement("td");
          cell.textContent = val;
          if (!snap.ours) cell.style.color = "var(--muted)";
          tr.appendChild(cell);
        });
        tbody.appendChild(tr);
      });
    });
    if (!rows) {
      tbody.innerHTML = "<tr><td colspan='5'>No snapshots on any guest.</td></tr>";
    }
    $("snapSummary").textContent =
      data.ours + " taken by this tool, " + data.other + " taken elsewhere";
    updateSnapSelCount();
  } catch (e) {
    tbody.innerHTML = "<tr><td colspan='5'>" + e.message + "</td></tr>";
