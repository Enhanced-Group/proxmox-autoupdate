# --- Entry point --------------------------------------------------------------


def pick_cert():
    for cert, key in CERT_CANDIDATES:
        if os.path.isfile(cert) and os.path.isfile(key):
            return cert, key
    return None, None


def watch_cert(ctx, cert, key, interval=300):
    """Reload the certificate in place when it changes on disk.

    Proxmox's ACME client renews pveproxy-ssl.pem without touching this service.
    Calling load_cert_chain again on the live context makes new connections use
    the new certificate, so a renewal doesn't silently keep serving an expired
    one until someone restarts us.
    """
    def stat_of(path):
        try:
            st = os.stat(path)
            return (st.st_mtime, st.st_size)
        except OSError:
            return None

    last = (stat_of(cert), stat_of(key))
    while True:
        time.sleep(interval)
        current = (stat_of(cert), stat_of(key))
        if current == last or current[0] is None or current[1] is None:
            continue
        try:
            ctx.load_cert_chain(cert, key)
            last = current
            sys.stderr.write("[ui] reloaded certificate from %s\n" % cert)
        except (ssl.SSLError, OSError) as exc:
            # Half-written file during renewal: keep the old cert and retry.
            sys.stderr.write("[ui] certificate reload failed (%s) — keeping previous\n" % exc)


class TLSServer(ThreadingHTTPServer):
    """HTTPS server that runs the TLS handshake in the worker thread.

    ThreadingHTTPServer accepts on one thread and serves on many.
    `ctx.wrap_socket(httpd.socket, server_side=True)` — the obvious way to make
    it speak HTTPS, and what this did up to and including 1.12.4 — puts the
    wrong side of that split: accept() then returns an already-negotiated
    socket, so the handshake happens in the accept loop and nothing else is
    accepted until it finishes. There was no deadline on it either, so a single
    client that completed the TCP connection and then sent no ClientHello
    stopped the entire panel for as long as it stayed connected, and it
    recovered the moment that client went away.

    That is indistinguishable from a firewall from the outside: the port
    answers locally, the browser times out. Chrome's speculative pre-connect
    and any LAN port scanner both produce exactly that connection.

    Here accept() returns a plain socket under a deadline, and the handshake
    happens in the thread that will serve the request, so a slow or abandoned
    client can only ever delay itself.
    """

    daemon_threads = True
    request_queue_size = LISTEN_BACKLOG
    ssl_context = None

    def get_request(self):
        sock, addr = self.socket.accept()
        # Covers the handshake performed in finish_request() below.
        sock.settimeout(HANDSHAKE_TIMEOUT)
        return sock, addr

    def finish_request(self, request, client_address):
        try:
            tls = self.ssl_context.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError, ValueError):
            # A browser declining the self-signed certificate, something
            # speaking plain HTTP at an HTTPS port, a scanner, or a client that
            # walked away mid-handshake. All routine, none worth a traceback in
            # the journal, and none of them can now affect another connection.
            return
        try:
            self.RequestHandlerClass(tls, client_address, self)
        finally:
            # wrap_socket() detaches the socket it is given, so the teardown
            # socketserver runs after this returns finds a file descriptor of
            # -1 and the real one would leak. Close what we actually opened.
            try:
                tls.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            tls.close()

    def handle_error(self, request, client_address):
        # A client vanishing mid-response is normal on a LAN and the default
        # implementation prints a traceback for every one, which buries real
        # errors. Anything else still gets reported.
        exc = sys.exc_info()[1]
        if exc is not None and isinstance(exc, (ConnectionError, TimeoutError, ssl.SSLError)):
            return
        super().handle_error(request, client_address)


def main():
    if os.geteuid() != 0:
        sys.exit("This service must run as root — it drives pct/qm and writes /etc.")

    cert, key = pick_cert()
    if not cert:
        sys.exit("No Proxmox TLS certificate found in /etc/pve/local/. Is this a PVE node?")

    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.load_cert_chain(cert, key)

    httpd = TLSServer((LISTEN_ADDR, LISTEN_PORT), Handler)
    # Read per connection, in the worker thread. watch_cert() below reloads
    # this same context in place, so a renewed certificate is picked up without
    # a restart.
    httpd.ssl_context = ctx

    threading.Thread(target=watch_cert, args=(ctx, cert, key), daemon=True).start()

    def shutdown(_signum, _frame):
        threading.Thread(target=httpd.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    sys.stderr.write("[ui] listening on https://%s:%d (cert: %s)\n"
                     % (LISTEN_ADDR, LISTEN_PORT, cert))
    httpd.serve_forever()


if __name__ == "__main__":
    main()
