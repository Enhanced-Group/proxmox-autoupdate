// --- snapshots ---------------------------------------------------------------
// Only snapshots this tool created may be selected. The others are rendered so
// the totals on screen describe the node honestly, but without a checkbox -
// this page has no business deleting a restore point somebody made by hand.
let SNAP_ROWS = [];

function snapWhen(epoch) {
  if (!epoch) return "unknown";
  const d = new Date(epoch * 1000);
  return d.toLocaleString();
}

function updateSnapSelCount() {
  const n = document.querySelectorAll("#snapList input[type=checkbox]:checked").length;
  $("snapSelCount").textContent = n ? n + " selected" : "";
