// --- schedules ---
/* A list, not a single expression. Each row carries its own reboot switch,
   which is the whole point: a weekly run that installs a kernel without taking
   the host down, and a monthly one that does. */
const SCHED_PRESETS = [
  ["0 23 * * 5", "Friday at 23:00"],
  ["0 22 * * 5", "Friday at 22:00"],
  ["0 20 * * 5", "Friday at 20:00"],
  ["0 3 * * 0",  "Sunday at 03:00"],
  ["0 3 * * *",  "Every day at 03:00"],
  /* Monthly by day-of-month only. cron ORs day-of-month with day-of-week when
     both are restricted, so "0 3 1-7 * 0" — the obvious way to write "first
     Sunday" — actually fires on the 1st to 7th *and* every Sunday. */
  ["0 3 1 * *",  "1st of the month at 03:00"],
  ["0 3 15 * *", "15th of the month at 03:00"],
];

function schedRowEl(item) {
  const row = document.createElement("div");
  row.className = "sched-row";

  const preset = document.createElement("select");
  SCHED_PRESETS.forEach(([expr, name]) => {
    const o = document.createElement("option");
    o.value = expr; o.textContent = name;
    preset.appendChild(o);
  });
  const custom = document.createElement("option");
  custom.value = "__custom"; custom.textContent = "Custom…";
  preset.appendChild(custom);

  const cron = document.createElement("input");
  cron.className = "sched-cron";
  cron.placeholder = "0 23 * * 5";
  cron.value = item.cron || "";
  preset.value = SCHED_PRESETS.some(([e]) => e === cron.value) ? cron.value : "__custom";
  preset.onchange = () => {
    if (preset.value !== "__custom") { cron.value = preset.value; }
    markDirty("schedule");
  };
  cron.oninput = () => {
    preset.value = SCHED_PRESETS.some(([e]) => e === cron.value.trim())
                 ? cron.value.trim() : "__custom";
    markDirty("schedule");
  };

  const label = document.createElement("input");
  label.className = "sched-label";
  label.placeholder = "Name (optional)";
  label.maxLength = 60;
  label.value = item.label || "";
  label.oninput = () => markDirty("schedule");

  /* Three modes rather than a reboot checkbox, because "reboot only" is a
     genuinely different job: it installs nothing and exists to give the outage
     its own slot in the week. */
  const mode = document.createElement("select");
  mode.className = "sched-mode";
  [["yes",  "Update · reboot if needed"],
   ["no",   "Update · never reboot"],
   ["only", "Reboot window · no updates"]].forEach(([v, text]) => {
    const o = document.createElement("option");
    o.value = v; o.textContent = text;
    mode.appendChild(o);
  });
  mode.value = ["yes", "no", "only"].includes(item.mode) ? item.mode : "yes";
  mode.onchange = () => { markDirty("schedule"); paintSchedWarning(); };

  const del = document.createElement("button");
  del.type = "button";
  del.className = "sched-del";
  del.textContent = "Remove";
  del.onclick = () => {
    if ($("schedRows").children.length <= 1) {
      msg($("schedMsg"), "At least one schedule is needed — updates run from cron.", false);
      return;
    }
    row.remove();
    markDirty("schedule");
    paintSchedWarning();
  };

  [preset, cron, label, mode, del].forEach((el) => row.appendChild(el));
  return row;
}

function readSchedRows() {
  return Array.from($("schedRows").children).map((row) => ({
    cron: row.querySelector(".sched-cron").value.trim(),
    label: row.querySelector(".sched-label").value.trim(),
    mode: row.querySelector(".sched-mode").value,
  }));
}

function paintSchedWarning() {
  const rows = readSchedRows();
  const canReboot = rows.some((s) => s.mode === "yes" || s.mode === "only");
  const canUpdate = rows.some((s) => s.mode !== "only");
  const box = $("schedWarn");
  if (!canReboot) {
    box.textContent = "No schedule may reboot. A new kernel will install and " +
      "then wait indefinitely — the host keeps running the old one until you " +
      "reboot it yourself.";
  } else if (!canUpdate) {
    box.textContent = "Every schedule is a reboot window, so nothing will ever " +
      "be updated.";
  }
  box.classList.toggle("hidden", canReboot && canUpdate);
}

function renderSchedules(items) {
  const box = $("schedRows");
  box.innerHTML = "";
  (items && items.length ? items : [{cron: "0 23 * * 5", mode: "yes", label: ""}])
    .forEach((it) => box.appendChild(schedRowEl(it)));
  paintSchedWarning();
}

$("btnAddSched").onclick = () => {
  if ($("schedRows").children.length >= 10) {
    msg($("schedMsg"), "Ten schedules is the limit.", false);
    return;
  }
  $("schedRows").appendChild(schedRowEl({cron: "0 3 1 * *", mode: "only",
                                         label: "Reboot window"}));
  markDirty("schedule");
  paintSchedWarning();
};

$("btnSaveSched").onclick = async () => {
  const items = readSchedRows();
  const bad = items.find((s) => s.cron.split(/\s+/).filter(Boolean).length !== 5);
  if (bad) {
    msg($("schedMsg"), "Not a 5-field cron expression: " + (bad.cron || "(empty)"), false);
    return;
  }
  try {
    const res = await post("/api/schedule", {schedules: items});
    const reboot = $("rebootTime").value.trim();
    if (reboot) await post("/api/config", {config: {REBOOT_TIME: reboot}});
    markClean("schedule");
    msg($("schedMsg"), res.warning
        ? "Saved. " + res.warning
        : items.length + (items.length === 1 ? " schedule saved" : " schedules saved")
          + " and the crontab updated.", !res.warning);
    poll();
  } catch (e) { msg($("schedMsg"), e.message, false); }
};

async function loadSchedules() {
  try {
    renderSchedules((await api("/api/schedules")).schedules);
    setTimeout(() => markClean("schedule"), 0);
  } catch (e) { msg($("schedMsg"), e.message, false); }
