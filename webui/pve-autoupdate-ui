def _v_nonempty(v):
    return len(v.strip()) > 0 and "\n" not in v and '"' not in v


VALID_METHODS = {"email", "discord", "slack", "teams", "ntfy", "gotify",
                 "telegram", "webhook"}


def _v_methods(v):
    if v.strip() in ("", "none"):
        return True
    return all(part.strip() in VALID_METHODS for part in v.split(",") if part.strip())


def _v_url(v):
    # Empty clears the channel. Otherwise require an https URL — these carry no
    # authentication of their own, so the URL is the secret.
    if v == "":
        return True
    if _has_shell_meta(v):
        return False
    return v.startswith("https://") and " " not in v and len(v) < 2048


def _v_local_url(v):
    """A URL that may be plain http, for self-hosted services on a LAN.

    Separate from _v_url deliberately. For a Slack or Discord webhook the URL
    *is* the credential, so requiring https there is right. ntfy and Gotify are
    usually a box on your own network with a token sent separately, and
    refusing http would just mean nobody could use them.
    """
    if v == "":
        return True
    if _has_shell_meta(v):
        return False
    return (v.startswith("https://") or v.startswith("http://")) \
        and " " not in v and len(v) < 2048


def _v_optional_email(v):
    return v == "" or _v_email(v)


def _v_optional(v):
    # Previously this rejected only newline and double-quote, which left $,
    # backtick and backslash free to reach a file that bash sources as root.
    return not _has_shell_meta(v) and '"' not in v and len(v) < 4096


TZ_RE = re.compile(r"\A[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*\Z")


def _v_tz(v):
    """Empty means "use the host's timezone", which is the default."""
    if v == "":
        return True
    if not TZ_RE.match(v) or len(v) > 64:
        return False
    return os.path.exists(os.path.join("/usr/share/zoneinfo", v))


