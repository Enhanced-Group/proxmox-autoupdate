$("btnDeleteSnaps").onclick = async () => {
  const targets = Array.from(
    document.querySelectorAll("#snapList input[type=checkbox]:checked")
  ).map((el) => ({vmid: el.dataset.vmid, name: el.dataset.name}));
  if (!targets.length) return;

  const many = targets.length > 1;
