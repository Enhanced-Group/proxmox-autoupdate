// --- log filtering and search ------------------------------------------------
// Ninety days of retention is the default, so the list is long by design, and a
// single run prints a block per guest. Both needed a way in.
function applyLogFilter() {
  const q = ($("logFilter").value || "").trim().toLowerCase();
  const rows = Array.from($("logList").querySelectorAll("tr"));
  let shown = 0;
  rows.forEach((tr) => {
    // The placeholder row has no name cell to match on; leave it alone.
    const nameCell = tr.querySelector("td.wrap");
    if (!nameCell) { return; }
    const hit = !q || nameCell.textContent.toLowerCase().indexOf(q) !== -1;
    tr.classList.toggle("hidden", !hit);
    if (hit) shown++;
  });
  $("logFilterCount").textContent =
    q ? shown + " of " + rows.filter((r) => r.querySelector("td.wrap")).length + " shown" : "";
}

// The whole log is already in the browser, so searching it is a string match
// rather than another request. Rebuilt as text nodes plus <mark>, never
// innerHTML: this content came off the filesystem and includes guest output.
let LOG_TEXT = "";

function applyLogSearch() {
  const pre = $("logFile");
  const q = ($("logSearch").value || "");
  if (!LOG_TEXT) { $("logSearchCount").textContent = ""; return; }
  if (!q) {
    pre.textContent = LOG_TEXT;
    $("logSearchCount").textContent = "";
    return;
  }
  const needle = q.toLowerCase();
  const hay = LOG_TEXT.toLowerCase();
  pre.textContent = "";
  let from = 0, hits = 0, first = null;
  for (;;) {
    const at = hay.indexOf(needle, from);
    if (at === -1) { break; }
    pre.appendChild(document.createTextNode(LOG_TEXT.slice(from, at)));
    const mark = document.createElement("mark");
    mark.textContent = LOG_TEXT.slice(at, at + q.length);
    pre.appendChild(mark);
    if (!first) first = mark;
    hits++;
    from = at + q.length;
    if (hits > 5000) { break; }   // a runaway search must not hang the page
  }
  pre.appendChild(document.createTextNode(LOG_TEXT.slice(from)));
  $("logSearchCount").textContent =
    hits ? hits + (hits > 5000 ? "+" : "") + " match" + (hits === 1 ? "" : "es") : "no matches";
  if (first && first.scrollIntoView) { first.scrollIntoView({block: "center"}); }
}

$("logFilter").oninput = applyLogFilter;
$("logSearch").oninput = applyLogSearch;

// --- guests, on the Run tab --------------------------------------------------
// The only list of guests used to live under Settings → Exclusions, so the
// per-guest page was reachable only by going into a settings screen about
// something else. Running one guest is a run.
async function loadRunGuests() {
  const tbody = $("runGuestList");
