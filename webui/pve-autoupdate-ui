// --- logs ---
async function loadLogList() {
  try {
    const data = await api("/api/logs");
    const tbody = $("logList");
    tbody.innerHTML = "";
    data.logs.forEach((entry) => {
      const tr = document.createElement("tr");
      const when = new Date(entry.mtime * 1000).toLocaleString();
