# --- Job state ----------------------------------------------------------------


class Job:
    """Tracks the single update run this service may have started."""

    def __init__(self):
        self.lock = threading.Lock()
        self.proc = None
        self.log_path = None
        self.dry_run = False
        self.only = None
        self.started_at = None
        self.finished_at = None
        self.returncode = None
        self.started_by = None

    def snapshot(self):
        with self.lock:
            running = self.proc is not None and self.proc.poll() is None
            if self.proc is not None and not running and self.returncode is None:
                self.returncode = self.proc.returncode
                self.finished_at = time.time()
            return {
                "running": running,
                "dry_run": self.dry_run,
                "only": self.only,
                "log": os.path.basename(self.log_path) if self.log_path else None,
                "started_at": self.started_at,
                "finished_at": self.finished_at,
                "returncode": self.returncode,
                "started_by": self.started_by,
            }

    def start(self, dry_run, user, only=None, no_email=False):
        """Launch a run. `only` limits it to a comma-separated set of guest IDs."""
        with self.lock:
            if self.proc is not None and self.proc.poll() is None:
                return False, "An update is already running."

            if not os.path.isfile(UPDATE_SCRIPT) or not os.access(UPDATE_SCRIPT, os.X_OK):
                return False, "%s is missing or not executable." % UPDATE_SCRIPT

            os.makedirs(resolve_log_dir(), exist_ok=True)
            stamp = time.strftime("%Y%m%d_%H%M%S")
            if only:
                kind = "guest%s" % only.replace(",", "-")
            else:
                kind = "dryrun" if dry_run else "manual"
            self.log_path = os.path.join(resolve_log_dir(), "webui_%s_%s.log" % (kind, stamp))

            cmd = [UPDATE_SCRIPT]
            if dry_run:
                cmd.append("--dry-run")
            if only:
                cmd += ["--only", only]
            if no_email:
                cmd.append("--no-email")

            scope = "guest %s" % only if only else "everything"
            logfh = open(self.log_path, "wb", buffering=0)
            logfh.write(
                ("=== started from web UI by %s at %s (%s, %s) ===\n"
                 % (user, time.strftime("%d/%m/%Y %H:%M:%S"),
                    "dry run" if dry_run else "full run", scope)).encode()
            )
            try:
                # start_new_session so the run survives a service restart and is
                # not killed by our own process group teardown.
                self.proc = subprocess.Popen(
                    cmd,
                    stdout=logfh,
                    stderr=subprocess.STDOUT,
                    stdin=subprocess.DEVNULL,
                    start_new_session=True,
                    env=dict(os.environ, TERM="dumb"),
                )
            except OSError as exc:
                logfh.close()
                return False, "Could not start the update script: %s" % exc

            self.dry_run = dry_run
            self.only = only
            self.started_at = time.time()
            self.finished_at = None
            self.returncode = None
            self.started_by = user
            return True, os.path.basename(self.log_path)


JOB = Job()


# --- Helpers ------------------------------------------------------------------


def lock_is_held():
    """True when some other run (usually cron) currently holds the lockfile.

    Asks the kernel directly with a non-blocking flock, which is what
    update-everything.sh actually uses. The previous implementation shelled out
    to fuser and returned False on any error — including fuser not being
    installed, which it is not by default, since psmisc is not a dependency the
    installer declares. So the guard that is documented as "refuses to run while
    an update is in progress" silently did nothing on a stock host, and the
    panel would happily start a second concurrent sweep driving pct and qm.
    """
    if not os.path.exists(LOCKFILE):
        return False
    fd = None
    try:
        fd = os.open(LOCKFILE, os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True          # someone else holds it
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        # Cannot even open it. Fail closed: better to refuse a run than to
        # start a second one on top of a live sweep.
        return True
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def read_config():
    """Parse the shell config into a dict. Only simple KEY="value" lines."""
    values = {}
    if not os.path.isfile(CONFIG_FILE):
        return values
    with open(CONFIG_FILE, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, raw = line.partition("=")
            key = key.strip()
            raw = raw.strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
                raw = raw[1:-1]
            values[key] = raw
    return values


def sh_quote(value):
    """Render a value as a single-quoted shell literal.

    The config file is `source`d by update-everything.sh as root. Values were
    written into *double* quotes, where bash still expands $VAR, $(...) and
    backticks — so a webhook URL with a "$" in it aborted the whole run under
    `set -u`, and a backtick executed as root. Inside single quotes bash expands
    nothing at all; the only character needing care is the quote itself, closed
    and reopened around an escaped one.
    """
    return "'" + str(value).replace("'", "'\\''") + "'"


# Serialises config writes. This is a read-modify-write on a shared file from a
# threading server, and it is reachable from three handlers plus the guest-page
# exclusion checkbox; concurrent saves used to lose whole keys, and two open
# tabs could resurrect excluded guests.
_CONFIG_LOCK = threading.Lock()


def write_config(updates):
    """Rewrite the config in place, preserving comments, ordering and mode 600."""
    with _CONFIG_LOCK:
        existing = []
        if os.path.isfile(CONFIG_FILE):
            with open(CONFIG_FILE, "r", encoding="utf-8", errors="replace") as fh:
                existing = fh.readlines()

        seen = set()
        out = []
        for line in existing:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and "=" in stripped:
                key = stripped.partition("=")[0].strip()
                if key in updates:
                    out.append("%s=%s\n" % (key, sh_quote(updates[key])))
                    seen.add(key)
                    continue
            out.append(line)

        missing = [k for k in updates if k not in seen]
        if missing:
            out.append("\n# Added by the web UI\n")
            for key in missing:
                out.append("%s=%s\n" % (key, sh_quote(updates[key])))

        # Create the temp file with the final mode rather than the process
        # umask, so the credentials in it are never briefly world-readable. A
        # per-process unique name stops two writers sharing one temp file.
        tmp = "%s.tmp.%d" % (CONFIG_FILE, os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.writelines(out)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, CONFIG_FILE)
        except Exception:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise


# --- Appearance ---------------------------------------------------------------
#
# Four colour tokens, stored in their own JSON file rather than in
# /etc/proxmox-autoupdate.conf.
#
# That file is `source`d by update-everything.sh as root, so putting
# browser-supplied colour strings in it would mean a slip in hex validation
# becomes root code execution. This file is only ever read by Python, so the
# worst a bad value can do is look wrong. It is also shared across browsers,
# unlike localStorage, and survives clearing site data.
#
# Values are validated on read as well as on write, so hand-editing the file
# cannot inject anything into the stylesheet either.
THEME_FILE = "/etc/proxmox-autoupdate-theme.json"
HEX_RE = re.compile(r"\A#[0-9a-fA-F]{6}\Z")

THEME_DEFAULTS = {
    "accent": "#e65c00",   # Proxmox orange: primary buttons, active tab, links
    "ok":     "#4caf50",
    "warn":   "#ffb300",
    "err":    "#f44336",
}

THEME_PRESETS = {
    "proxmox": {"accent": "#e65c00", "ok": "#4caf50", "warn": "#ffb300", "err": "#f44336"},
    "steel":   {"accent": "#3d8bcd", "ok": "#43a047", "warn": "#fb8c00", "err": "#e53935"},
    "teal":    {"accent": "#0f9d8f", "ok": "#43a047", "warn": "#f9a825", "err": "#e53935"},
    "violet":  {"accent": "#7c5cbf", "ok": "#4caf50", "warn": "#ffb300", "err": "#ef5350"},
}


def read_theme():
    theme = dict(THEME_DEFAULTS)
    try:
        with open(THEME_FILE, "r", encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, ValueError):
        return theme
    if not isinstance(raw, dict):
        return theme
    for key in THEME_DEFAULTS:
        value = raw.get(key)
        if isinstance(value, str) and HEX_RE.match(value):
            theme[key] = value.lower()
    return theme


def write_theme(theme):
    clean = {}
    for key in THEME_DEFAULTS:
        value = str(theme.get(key, THEME_DEFAULTS[key]))
        if not HEX_RE.match(value):
            raise ValueError("%s must be a colour like #e65c00" % key)
        clean[key] = value.lower()
    tmp = "%s.tmp.%d" % (THEME_FILE, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(clean, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, THEME_FILE)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return clean


def _srgb_to_linear(channel):
    c = channel / 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _relative_luminance(hex_colour):
    r, g, b = (int(hex_colour[i:i + 2], 16) for i in (1, 3, 5))
    return (0.2126 * _srgb_to_linear(r)
            + 0.7152 * _srgb_to_linear(g)
            + 0.0722 * _srgb_to_linear(b))


# WCAG AA for UI components and large text. Deliberately not the 4.5 figure for
# small body text: these are short bold labels on a solid fill, and the point of
# this threshold is to catch genuinely unreadable choices, not to restyle the
# panel. White stays the default wherever it is legible, so the shipped look is
# unchanged — black on Proxmox orange scores higher (5.9 vs 3.6) but nobody
# asked for the buttons to change colour.
CONTRAST_MIN = 3.0


def readable_on(hex_colour):
    """White, unless white would be unreadable on this colour — then black.

    Primary buttons and the active tab hardcoded white text, which is fine on
    Proxmox orange and illegible on a pale accent. Rather than rejecting the
    colour the user picked, switch the foreground only when we have to.
    """
    lum = _relative_luminance(hex_colour)
    contrast_white = 1.05 / (lum + 0.05)
    if contrast_white >= CONTRAST_MIN:
        return "#ffffff"
    return "#000000"


def _rgba(hex_colour, alpha):
    r, g, b = (int(hex_colour[i:i + 2], 16) for i in (1, 3, 5))
    return "rgba(%d,%d,%d,%.2f)" % (r, g, b, alpha)


def theme_css(theme=None):
    """CSS custom properties overriding the defaults in SHARED_CSS.

    Emitted after SHARED_CSS so it wins on equal specificity. Every value here
    has already been matched against HEX_RE, so nothing user-supplied can escape
    the declaration.
    """
    t = theme or read_theme()
    return (
        ":root{"
        "--accent:%s;--ok:%s;--warn:%s;--err:%s;"
        "--accent-dim:%s;--on-accent:%s;--on-ok:%s;--on-warn:%s;--on-err:%s"
        "}"
    ) % (
        t["accent"], t["ok"], t["warn"], t["err"],
        _rgba(t["accent"], 0.35),
        readable_on(t["accent"]), readable_on(t["ok"]),
        readable_on(t["warn"]), readable_on(t["err"]),
    )


def _shade(hex_colour, factor):
    """Lighten (factor > 1) or darken (factor < 1) a colour, clamped."""
    r, g, b = (int(hex_colour[i:i + 2], 16) for i in (1, 3, 5))
    adj = lambda c: max(0, min(255, int(round(c * factor))))
    return "#%02x%02x%02x" % (adj(r), adj(g), adj(b))


def theme_for_client():
    """The palette the injected Proxmox-UI buttons need, already derived.

    Hover and pressed shades and the readable foreground are computed here so
    the JavaScript injected into pvemanagerlib.js stays as small and dumb as
    possible — it is the one piece of this project running inside somebody
    else's application.
    """
    t = read_theme()
    return {
        "accent": t["accent"],
        "accentHover": _shade(t["accent"], 1.18),
        "accentPressed": _shade(t["accent"], 0.82),
        "accentBorder": _shade(t["accent"], 0.78),
        "onAccent": readable_on(t["accent"]),
        "ok": t["ok"],
        "warn": t["warn"],
        "err": t["err"],
    }


def resolve_log_dir():
    """Pick up LOG_DIR from the config, falling back to the default.

    Re-read rather than cached: the operator can change it in the config file
    while the service is running, and the Logs tab should follow it.
    """
    value = (read_config().get("LOG_DIR") or "").strip()
    if value and value.startswith("/") and "\x00" not in value:
        return value.rstrip("/") or LOG_DIR_DEFAULT
    return LOG_DIR_DEFAULT


def excluded_ids():
    raw = read_config().get("EXCLUDE_IDS", "")
    return {part for part in re.split(r"[,\s]+", raw) if part}


def set_excluded_ids(ids):
    """Persist the exclusion list, normalised and sorted numerically."""
    clean = sorted({str(int(i)) for i in ids}, key=int)
    write_config({"EXCLUDE_IDS": ",".join(clean)})
    return clean


# ostype is not on /cluster/resources, so it takes one config call per VM.
# Cached for the life of the process: a guest does not change operating system,
# and this is read on every guest-list load.
_OSTYPE_CACHE = {}


def guest_is_windows(node, vmid):
    key = (node, str(vmid))
    if key in _OSTYPE_CACHE:
        return _OSTYPE_CACHE[key]
    ostype = ""
    res = _run(["pvesh", "get", "/nodes/%s/qemu/%s/config" % (node, vmid),
                "--output-format", "json"], timeout=15)
    if res and res.returncode == 0:
        try:
            data = json.loads(res.stdout)
            ostype = (data or {}).get("ostype", "") or ""
        except ValueError:
            ostype = ""
    is_win = ostype.lower().startswith("w")
    _OSTYPE_CACHE[key] = is_win
    return is_win


def list_guests():
    """Every VM and container on this cluster, with its exclusion state.

    Uses /cluster/resources so one call covers both types and every node,
    rather than scraping `pct list` and `qm list` separately.
    """
    try:
        res = subprocess.run(
            ["pvesh", "get", "/cluster/resources", "--type", "vm",
             "--output-format", "json"],
            capture_output=True, text=True, timeout=20,
        )
        if res.returncode != 0:
            return [], (res.stderr.strip() or "pvesh returned %d" % res.returncode)
        raw = json.loads(res.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        return [], str(exc)

    skip = excluded_ids()
    guests = []
    for item in raw:
        vmid = item.get("vmid")
        if vmid is None:
            continue
        guests.append({
            "vmid": str(vmid),
            "name": item.get("name") or ("guest-%s" % vmid),
            "type": "lxc" if item.get("type") == "lxc" else "qemu",
            "status": item.get("status", "unknown"),
            "node": item.get("node", ""),
            "excluded": str(vmid) in skip,
            # Only VMs can be Windows; asking about a container is a wasted call.
            "windows": (item.get("type") != "lxc"
                        and guest_is_windows(item.get("node", ""), vmid)),
        })
    guests.sort(key=lambda g: int(g["vmid"]))
    return guests, None


def read_state():
    """Run history written by update-everything.sh. Absent before the first run."""
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def repeat_offenders_text():
    guests = read_state().get("guests") or {}
    items = [
        (gid, g) for gid, g in guests.items()
        if isinstance(g, dict) and (g.get("consecutive_failures") or 0) > 1
    ]
    items.sort(key=lambda kv: -kv[1]["consecutive_failures"])
    return ", ".join(
        "%s (%s) x%d" % (g.get("name") or "guest", gid, g["consecutive_failures"])
        for gid, g in items
    )


def log_stats():
    """Total size and count of the log directory, for the UI to display."""
    total = count = 0
    oldest = None
    if os.path.isdir(resolve_log_dir()):
        for name in os.listdir(resolve_log_dir()):
            if not name.endswith(".log"):
                continue
            try:
                st = os.stat(os.path.join(resolve_log_dir(), name))
            except OSError:
                continue
            total += st.st_size
            count += 1
            if oldest is None or st.st_mtime < oldest:
                oldest = st.st_mtime
    return {"dir": resolve_log_dir(), "bytes": total, "count": count, "oldest": oldest}


def purge_logs(keep_current=True):
    """Delete stored logs. The log of a run in progress is kept by default."""
    current = None
    if keep_current:
        snap = JOB.snapshot()
        if snap["running"] and snap["log"]:
            current = snap["log"]
    removed = 0
    if os.path.isdir(resolve_log_dir()):
        for name in os.listdir(resolve_log_dir()):
            if not name.endswith(".log") or name == current:
                continue
            try:
                os.remove(os.path.join(resolve_log_dir(), name))
                removed += 1
            except OSError:
                pass
    return removed


def send_test_notification(cfg):
    """Fire a sample notification through every configured channel.

    Reuses update-everything.sh's own notifier rather than reimplementing the
    payloads here, so a successful test genuinely proves the real path works.
    """
    methods = [m.strip() for m in (cfg.get("NOTIFY_METHODS") or "").split(",") if m.strip()]
    methods = [m for m in methods if m in VALID_METHODS]
    if not methods:
        return False, "No notification channels are enabled."

    # Pre-flight. Without this an incomplete channel produces a bare "HTTP 400"
    # from the provider, which says nothing about which field is missing —
    # an empty Mailgun domain builds .../v3//messages, for instance.
    problems = []
    if "email" in methods:
        missing = [k for k in ("MAILGUN_API_KEY", "MAILGUN_DOMAIN",
                               "SENDER_EMAIL", "RECIPIENT_EMAIL")
                   if not (cfg.get(k) or "").strip()]
        if missing:
            problems.append("Email is enabled but %s %s not set."
                            % (", ".join(missing),
                               "is" if len(missing) == 1 else "are"))
        elif "@" not in (cfg.get("SENDER_EMAIL") or ""):
            problems.append("SENDER_EMAIL does not look like an address.")
    if "discord" in methods:
        token = (cfg.get("DISCORD_BOT_TOKEN") or "").strip()
        uid = (cfg.get("DISCORD_USER_ID") or "").strip()
        hook = (cfg.get("DISCORD_WEBHOOK_URL") or "").strip()
        if token and not uid:
            problems.append("Discord: a bot token is set but DISCORD_USER_ID is not.")
        elif uid and not token:
            problems.append("Discord: a user ID is set but DISCORD_BOT_TOKEN is not.")
        elif not token and not hook:
            problems.append("Discord is enabled but neither a webhook URL nor a "
                            "bot DM is configured.")
    for method, key, label in (("slack", "SLACK_WEBHOOK_URL", "Slack/Teams"),
                               ("webhook", "GENERIC_WEBHOOK_URL", "Generic webhook")):
        if method in methods and not (cfg.get(key) or "").strip():
            problems.append("%s is enabled but %s is not set." % (label, key))
    if problems:
        return False, "\n".join(problems)

    script = r'''
set -u
CONFIG_FILE="%s"
. "${CONFIG_FILE}"

# A config written by an older installer will not contain the newer keys, and
# the notifier runs under `set -u` — without these defaults it aborts on the
# first unset variable instead of sending anything.
DISCORD_WEBHOOK_URL="${DISCORD_WEBHOOK_URL:-}"
DISCORD_BOT_TOKEN="${DISCORD_BOT_TOKEN:-}"
DISCORD_USER_ID="${DISCORD_USER_ID:-}"
SLACK_WEBHOOK_URL="${SLACK_WEBHOOK_URL:-}"
GENERIC_WEBHOOK_URL="${GENERIC_WEBHOOK_URL:-}"
MAILGUN_API_KEY="${MAILGUN_API_KEY:-}"
SENDER_EMAIL="${SENDER_EMAIL:-}"
RECIPIENT_EMAIL="${RECIPIENT_EMAIL:-}"

HOST_NAME=$(hostname -f 2>/dev/null || hostname)
TIMESTAMP=$(date '+%%d/%%m/%%Y %%H:%%M:%%S')

# The notifier reads MAILGUN_API_URL, which update-everything.sh derives from
# the region *outside* the helper block copied in below. Derive it the same way
# here, or notify_email would reference an unbound variable — or, with an empty
# domain, POST to .../v3//messages and get a bare 400 back.
MAILGUN_DOMAIN="${MAILGUN_DOMAIN:-}"
MAILGUN_REGION="${MAILGUN_REGION:-EU}"
if [ "${MAILGUN_REGION}" = "EU" ]; then
    MAILGUN_API_URL="https://api.eu.mailgun.net/v3/${MAILGUN_DOMAIN}/messages"
else
    MAILGUN_API_URL="https://api.mailgun.net/v3/${MAILGUN_DOMAIN}/messages"
fi

ERRORS_OCCURRED=false; DRY_RUN=false; KEEP_LOGS=false; LOG_FILE=""
REBOOT_NEEDED=false; REPEAT_OFFENDERS=""; PVE_VERSION_AFTER=$(pveversion 2>/dev/null | awk '{print $1}')
LXC_UPDATED=0 LXC_ERRORS=0 VM_UPDATED=0 VM_ERRORS=0 HOST_PKG_COUNT=0
C_GREEN='' C_RED='' C_BOLD='' C_NC='' C_DIM='' C_YELLOW='' C_CYAN=''
print_ok()   { echo "OK: $1"; }
print_fail() { echo "FAIL: $1"; }
%s
BODY="This is a test notification from Proxmox Auto-Update on ${HOST_NAME}.

If you can read this, the channel is configured correctly.
No update was run."
for m in %s; do
    case "$m" in
        email)   notify_email   "[Proxmox] Test notification" "$BODY" "" ;;
        discord) notify_discord "[Proxmox] Test notification" "$BODY" ;;
        slack)   notify_slack   "[Proxmox] Test notification" "$BODY" ;;
        webhook) notify_webhook "[Proxmox] Test notification" "$BODY" ;;
    esac
done
'''
    # Lift the notifier verbatim out of the update script.
    try:
        with open(UPDATE_SCRIPT, encoding="utf-8") as fh:
            src = fh.read()
    except OSError as exc:
        return False, "Cannot read %s: %s" % (UPDATE_SCRIPT, exc)

    # Delimited by explicit markers rather than by guessing at the first and
    # last function: a helper that falls outside the range is not a syntax
    # error, it is a function that is simply undefined when the test runs.
    begin = src.find("# >>> PAU-NOTIFIER-BEGIN")
    end = src.find("# <<< PAU-NOTIFIER-END")
    if begin < 0 or end < 0 or end <= begin:
        return False, ("Could not locate the notifier markers in %s. The update "
                       "script may be older than this panel — reinstall to bring "
                       "them back into step." % UPDATE_SCRIPT)
    helpers = src[begin:end]

    # Guard against the same class of mistake recurring.
    required = ("cfg_escape()", "curl_cfg()", "build_payload()", "post_webhook()",
                "notify_email()", "notify_discord()", "notify_slack()",
                "notify_webhook()", "discord_resolve_target()", "discord_cfg()")
    absent = [name for name in required if name not in helpers]
    if absent:
        return False, ("The notifier section is incomplete — missing %s. This is a "
                       "packaging fault, not a configuration problem."
                       % ", ".join(absent))

    # Email needs the HTML file argument; a plain-text body is fine for a test.
    body_file = ""
    if "email" in methods:
        fd, body_file = tempfile.mkstemp(suffix=".html")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("<p>This is a <strong>test notification</strong> from "
                     "Proxmox Auto-Update.</p><p>If you can read this, email is "
                     "configured correctly. No update was run.</p>")
        script = script.replace('notify_email   "[Proxmox] Test notification" "$BODY" ""',
                                'notify_email   "[Proxmox] Test notification" "$BODY" "%s"'
                                % body_file)

    full = script % (CONFIG_FILE, helpers, " ".join(methods))
    try:
        res = subprocess.run(["bash", "-c", full], capture_output=True,
                             text=True, timeout=120)
        output = (res.stdout + res.stderr).strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return False, "Test failed to run: %s" % exc
    finally:
        if body_file:
            try:
                os.remove(body_file)
            except OSError:
                pass

    # Success means the notifier explicitly said so. Treating "no output" as
    # success would report a green tick for a channel that never ran.
    ok = "OK:" in output and "FAIL:" not in output
    if not output:
        return False, ("The notifier produced no output at all — check "
                       "'journalctl -u pve-autoupdate-ui' for details.")
    return ok, output


GITHUB_REPO = "Enhanced-Group/proxmox-autoupdate"
UNINSTALL_SCRIPT = "/usr/local/bin/pve-autoupdate-uninstall"
LATEST_RELEASE_API = "https://api.github.com/repos/%s/releases/latest" % GITHUB_REPO
TAGS_API = "https://api.github.com/repos/%s/tags?per_page=100" % GITHUB_REPO
REF_RE = re.compile(r"\A[A-Za-z0-9._/-]{1,64}\Z")
VERSION_TAG_RE = re.compile(r"\Av?[0-9]+(\.[0-9]+)*\Z")

# Tags from the retired numbering.
#
# This project released under a 2.x–4.x scheme before settling on the 1.x line.
# Those tags are still on GitHub — the history is worth keeping — but they sort
# numerically above every 1.x release, so "highest tag wins" would report the
# retired code as an available update on every machine, forever.
#
# If this ever legitimately reaches 2.0, this filter has to go with it.
RETIRED_TAG_RE = re.compile(r"\Av?[234]\.")


def _retired(tag):
    return bool(tag) and bool(RETIRED_TAG_RE.match(tag))


def _highest_version_tag(data):
    """The highest version-shaped tag name in a GitHub /tags response."""
    if not isinstance(data, list):
        return None
    names = [item.get("name") for item in data
             if isinstance(item, dict) and isinstance(item.get("name"), str)]
    versions = [n for n in names if VERSION_TAG_RE.match(n) and not _retired(n)]
    if not versions:
        return None
    return max(versions, key=lambda n: _version_tuple(n.lstrip("v")))


def _github_json_tag(url, extract):
    """Fetch a GitHub API endpoint and pull a ref name out of it."""
    try:
        req = urllib.request.Request(
            url,
            headers={"Accept": "application/vnd.github+json",
                     "User-Agent": "proxmox-autoupdate (https://github.com/%s)" % GITHUB_REPO},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read(1_000_000).decode("utf-8", "replace"))
        name = extract(data)
    except (urllib.error.URLError, OSError, ValueError, ssl.SSLError,
            KeyError, IndexError, TypeError, AttributeError):
        return None
    if isinstance(name, str) and REF_RE.match(name):
        return name
    return None

# Update channel. "release" tracks published tags; "main" tracks the branch and
# is for development only.
#
# This used to be pinned to /main unconditionally, and "Install update" runs the
# installer unattended as root — so every push to this repository, reviewed or
# not, finished or not, went straight into a root cron job on every machine that
# clicked the button. Tracking releases means a commit has to be deliberately
# tagged before it reaches anyone.
UPDATE_CHANNEL = os.environ.get("PAU_UPDATE_CHANNEL", "release")

_release_cache = {"ref": None, "at": 0.0}
_release_lock = threading.Lock()


def latest_release_ref(force=False):
    """The newest published release tag, or None if it cannot be determined."""
    if UPDATE_CHANNEL == "main":
        return "main"
    now = time.monotonic()
    # A person clicking "Check for updates" is asking a question now, and must
    # not be answered from a five-minute-old cache — that is how a panel ends up
    # insisting it is current minutes after a new version goes out. The cache
    # exists to keep background status polls off the GitHub API, not to make an
    # explicit check lie.
    if not force:
        with _release_lock:
            if _release_cache["ref"] and now - _release_cache["at"] < 300:
                return _release_cache["ref"]
    # Take whichever is *newer* of the latest published Release and the highest
    # git tag — not the Release with the tags as a mere fallback.
    #
    # GitHub's /releases/latest only knows about published Release objects. A
    # maintainer who tags and pushes without also clicking "publish release"
    # leaves it pointing at an older version, and every installation then sits
    # on "up to date" forever while newer tags exist. That is not hypothetical:
    # it happened here between v1.4.0 and v1.5.3, six tags with no Release, and
    # every panel reported 1.4.0 as current.
    #
    # Tags are compared by version, never by the order GitHub returns them,
    # so this cannot resolve backwards.
    release_ref = _github_json_tag(LATEST_RELEASE_API, lambda d: d.get("tag_name"))
    if _retired(release_ref):
        release_ref = None
    tag_ref = _github_json_tag(TAGS_API, _highest_version_tag)

    ref = release_ref or tag_ref
    if release_ref and tag_ref and release_ref != tag_ref:
        try:
            if _version_tuple(tag_ref.lstrip("v")) > _version_tuple(release_ref.lstrip("v")):
                ref = tag_ref
        except (TypeError, ValueError):
            pass          # unparseable version: keep the published Release
    if ref:
        with _release_lock:
            _release_cache["ref"] = ref
            _release_cache["at"] = now
    return ref


def github_raw_base(ref=None):
    """Raw base URL for a ref, or None if no release ref could be resolved.

    Deliberately does not fall back to main. Silently pulling an untagged branch
    when the release lookup fails is exactly the behaviour this replaced.
    """
    ref = ref or latest_release_ref()
    if not ref:
        return None
    return "https://raw.githubusercontent.com/%s/%s" % (GITHUB_REPO, ref)


def install_script_url(ref=None):
    base = github_raw_base(ref)
    return "%s/install.sh" % base if base else None


def installed_version():
    try:
        with open(UPDATE_SCRIPT, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'\s*PAU_VERSION="([^"]+)"', line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return "unknown"


# The version this process started up on.
#
# Snapshotted rather than read per request: an update replaces the script on
# disk a few seconds before this service restarts, so for that window the file
# reports the new version while this process is still serving the old page.
# Stamping pages with the file's version there would tell an open tab it is
# current when it is not, which is the whole thing the check exists to catch.
PROCESS_VERSION = installed_version()


def _version_tuple(v):
    parts = []
    for chunk in re.split(r"[.\-+]", v):
        parts.append(int(chunk) if chunk.isdigit() else 0)
    return tuple(parts or [0])


def changelog_url(ref=None):
    base = github_raw_base(ref)
    return "%s/CHANGELOG.md" % base if base else None


LOCAL_CHANGELOG = "/usr/local/share/proxmox-autoupdate/CHANGELOG.md"


def _fetch_raw(url, limit=200_000):
    """Fetch a raw GitHub file, bypassing the CDN cache.

    raw.githubusercontent.com sits behind a CDN that serves a cached copy for
    several minutes. Without this a check run shortly after a release keeps
    reporting the previous version, which looks like the check is broken. A
    unique query string gives the CDN nothing to match on; the no-cache headers
    cover any proxy in between.
    """
    bust = "%s?cb=%d" % (url, int(time.time()))
    req = urllib.request.Request(bust, headers={
        "User-Agent": "proxmox-autoupdate",
        "Cache-Control": "no-cache, max-age=0",
        "Pragma": "no-cache",
    })
    with urllib.request.urlopen(req, timeout=20) as resp:
        return resp.read(limit).decode("utf-8", errors="replace")

VERSION_HEADING = re.compile(r"^##\s+([0-9][^\s—-]*)\s*[—-]?\s*(.*)$")
SECTION_HEADING = re.compile(r"^###\s+(.+?)\s*$")
BULLET = re.compile(r"^[-*]\s+(.*)$")


def parse_changelog(text, limit=1):
    """Turn CHANGELOG.md into [{version, date, sections: {name: [items]}}].

    Just the current release: this is shown when offering an update, so it
    should describe the version being installed and nothing else. The limit is
    still enforced here rather than assumed, so a changelog that has picked up
    older entries cannot flood the panel.

    Deliberately tolerant: an unrecognised line is skipped rather than aborting,
    so a formatting slip in the changelog never breaks the Maintenance tab.
    """
    entries = []
    current = None
    section = None
    for line in text.splitlines():
        m = VERSION_HEADING.match(line)
        if m:
            if len(entries) >= limit:
                break
            current = {"version": m.group(1).strip(),
                       "date": m.group(2).strip(),
                       "sections": {}}
            entries.append(current)
            section = None
            continue
        if current is None:
            continue
        m = SECTION_HEADING.match(line)
        if m:
            section = m.group(1)
            current["sections"].setdefault(section, [])
            continue
        m = BULLET.match(line.strip())
        if m and section:
            current["sections"][section].append(m.group(1).strip())
    return entries


def fetch_changelog():
    """Published changelog, falling back to the copy installed alongside us."""
    url = changelog_url()
    if not url:
        try:
            with open(LOCAL_CHANGELOG, encoding="utf-8") as fh:
                return fh.read(), "Showing the installed copy — no release found on GitHub."
        except OSError:
            return "", "Could not determine the latest release from GitHub."
    try:
        return _fetch_raw(url), None
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        try:
            with open(LOCAL_CHANGELOG, encoding="utf-8") as fh:
                return fh.read(), "Showing the installed copy — %s" % exc
        except OSError:
            return "", "Could not reach GitHub: %s" % exc


def check_for_updates(force=False):
    """Read-only version check against the published update script.

    Deliberately only *reports*. Applying is a separate, explicitly confirmed
    action, so a compromised or mistaken upstream cannot roll itself out
    silently onto a node that merely looked.
    """
    current = installed_version()
    ref = latest_release_ref(force=force)
    if not ref:
        return {"current": current, "latest": None,
                "error": "Could not determine the latest release from GitHub. "
                         "Nothing has been changed."}
    base = github_raw_base(ref)
    try:
        # Read enough to be safe if the assignment ever moves further down the
        # file — a check that silently reports "up to date" because it stopped
        # reading too early is worse than a slightly larger fetch.
        head = _fetch_raw("%s/update-everything.sh" % base, limit=65_536)
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        return {"current": current, "latest": None,
                "error": "Could not reach GitHub: %s" % exc}

    m = re.search(r'PAU_VERSION="([^"]+)"', head)
    if not m:
        return {"current": current, "latest": None,
                "error": "Could not read a version from the published script."}

    latest = m.group(1)
    # A machine still on the retired 2.x–4.x numbering is behind everything on
    # the 1.x line, however the numbers compare. Without this, every existing
    # installation would sit on "up to date" forever after the renumbering and
    # need a manual re-install to escape.
    if _retired(current) and not _retired(latest):
        behind = True
    else:
        try:
            behind = _version_tuple(latest) > _version_tuple(current)
        except ValueError:
            behind = latest != current
    return {
        "current": current,
        "latest": latest,
        "update_available": bool(behind),
        "checked_at": time.strftime("%H:%M:%S"),
        "repo": "https://github.com/%s" % GITHUB_REPO,
        "ref": ref,
        "command": "curl -fsSL %s | bash" % install_script_url(ref),
    }


# The script pads the tag so the columns line up: "[ ok ]", "[warn]", "[FAIL]".
DOCTOR_LINE_RE = re.compile(r"^\s*\[\s*(ok|warn|FAIL)\s*\]\s*(.*)$")


def run_doctor():
    """Run the update script's own self-check and return it as structured rows.

    Read-only by contract — --doctor changes nothing, starts nothing and sends
    nothing — so this needs no confirmation step, unlike every other action on
    the Maintenance tab. It is also the single most useful thing to hand
    somebody whose scheduled runs appear to do nothing, which is why it belongs
    in the UI and not only on the command line.
    """
    if not os.path.isfile(UPDATE_SCRIPT):
        return {"error": "%s is not installed." % UPDATE_SCRIPT}
    try:
        res = subprocess.run([UPDATE_SCRIPT, "--doctor"],
                             capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return {"error": "The self-check took longer than three minutes and was stopped. "
                         "That usually means apt or the Proxmox API is hanging."}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"error": "Could not run the self-check: %s" % exc}

    rows, section = [], ""
    for line in strip_ansi(res.stdout + res.stderr).splitlines():
        if line.startswith("── "):
            section = line[3:].strip()
            continue
        m = DOCTOR_LINE_RE.match(line)
        if m:
            rows.append({"level": m.group(1), "section": section, "text": m.group(2).rstrip()})
    return {
        "rows": rows,
        "failures": sum(1 for r in rows if r["level"] == "FAIL"),
        "warnings": sum(1 for r in rows if r["level"] == "warn"),
        "returncode": res.returncode,
    }


SELFUPDATE_UNIT = "pve-autoupdate-selfupdate"
UNINSTALL_UNIT = "pve-autoupdate-uninstall"

# Version the running self-update is installing. The service restarts part way
# through, so this is also mirrored to disk — the button must stay disabled
# across that restart until the new version is actually confirmed running.
PENDING_VERSION = {}
PENDING_FILE = "/var/lib/proxmox-autoupdate/pending-version"


def set_pending_version(version):
    PENDING_VERSION["target"] = version
    try:
        os.makedirs(os.path.dirname(PENDING_FILE), exist_ok=True)
        with open(PENDING_FILE, "w", encoding="utf-8") as fh:
            fh.write(version or "")
    except OSError:
        pass


def load_pending_version():
    """Clear the marker once the installed version has actually changed to it."""
    target = PENDING_VERSION.get("target")
    if target is None:
        try:
            with open(PENDING_FILE, encoding="utf-8") as fh:
                target = fh.read().strip() or None
        except OSError:
            target = None
        PENDING_VERSION["target"] = target
    if target and installed_version() == target:
        PENDING_VERSION["target"] = None
        try:
            os.remove(PENDING_FILE)
        except OSError:
            pass
        return None
    return target


def unit_state(unit):
    """systemd's view of a transient unit: active, failed, inactive or unknown."""
    try:
        res = subprocess.run(["systemctl", "is-active", unit + ".service"],
                             capture_output=True, text=True, timeout=10)
        return (res.stdout or res.stderr).strip() or "unknown"
    except (OSError, subprocess.SubprocessError):
        return "unknown"


def maintenance_status():
    """Whether a self-update or uninstall is in flight.

    The panel restarts mid-self-update, so this cannot be tracked in memory —
    it is read back from systemd, which survives the restart.
    """
    selfupd = unit_state(SELFUPDATE_UNIT)
    uninst = unit_state(UNINSTALL_UNIT)
    pending = load_pending_version()
    return {
        "self_update": selfupd,
        "uninstall": uninst,
        "pending": pending,
        # Busy while the unit runs *and* while the installed version has not yet
        # caught up with the target — the unit finishes before the restarted
        # service reports the new number.
        "busy": selfupd in ("active", "activating")
                or uninst in ("active", "activating")
                or bool(pending),
    }


def run_detached(command, unit):
    """Run a command owned by systemd rather than by this service.

    Required for self-update and uninstall: both restart or delete this very
    process, so anything still parented to it would be killed part way through.
    """
    if shutil_which("systemd-run"):
        subprocess.run(["systemctl", "reset-failed", unit + ".service"],
                       capture_output=True, timeout=10)
        res = subprocess.run(
            ["systemd-run", "--unit", unit, "--collect",
             "--description", "proxmox-autoupdate maintenance",
             "/bin/bash", "-c", command],
            capture_output=True, text=True, timeout=20)
        if res.returncode == 0:
            return True, unit
        return False, (res.stderr.strip() or "systemd-run failed")

    try:
        subprocess.Popen(["/bin/bash", "-c", command],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True)
        return True, "detached process"
    except OSError as exc:
        return False, str(exc)


def shutil_which(name):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _discord_call(url, token, payload=None):
    """One Discord REST call. Returns (status, parsed_body, raw_text)."""
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        url, data=data, method="POST" if data is not None else "GET",
        headers={
            "Authorization": "Bot %s" % token,
            "Content-Type": "application/json",
            "User-Agent": "proxmox-autoupdate (https://github.com/%s, 1.0)" % GITHUB_REPO,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = resp.read(4000).decode("utf-8", errors="replace")
            status = resp.status
    except urllib.error.HTTPError as exc:
        raw = exc.read(4000).decode("utf-8", errors="replace")
        status = exc.code
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        return 0, None, str(exc)
    try:
        return status, json.loads(raw), raw
    except ValueError:
        return status, None, raw


def identify_credential(value):
    """Guess which Discord credential a string actually is.

    The developer portal shows four values on adjacent pages and only one of
    them is the bot token. Telling someone their token is invalid is far less
    useful than telling them they pasted the Application ID.
    """
    v = value.strip()
    if not v:
        return "empty"
    if re.fullmatch(r"[0-9]{17,20}", v):
        return ("your Application ID (or a user ID) — a long run of digits. "
                "The bot token is on the Bot page and contains dots.")
    if re.fullmatch(r"[0-9a-fA-F]{64}", v):
        return ("your Public Key — 64 hex characters. The bot token is on the "
                "Bot page and contains dots.")
    if "." not in v and re.fullmatch(r"[A-Za-z0-9_-]{28,40}", v):
        return ("your Client Secret — no dots. The bot token is on the Bot "
                "page, under the username, behind Reset Token.")
    if v.count(".") == 2:
        return None      # right shape; the token itself is simply not valid
    return ("not the shape of a bot token — those are three dot-separated "
            "parts, e.g. MTIzNDU2…….Gh1jKl.MnOpQr……")


def diagnose_discord_dm(cfg):
    """Walk the DM flow one call at a time and report what each one did.

    A bare "400" is unactionable — it could be the token, the user ID, the bot's
    server membership, or the message body. Each step is reported separately so
    the failing one is obvious.
    """
    steps = []
    token = (cfg.get("DISCORD_BOT_TOKEN") or "").strip()
    token = token[4:].strip() if token.lower().startswith("bot ") else token
    uid = (cfg.get("DISCORD_USER_ID") or "").strip()

    if not token:
        return False, [{"step": "Configuration", "ok": False,
                        "detail": "DISCORD_BOT_TOKEN is empty."}]
    if not re.fullmatch(r"[0-9]{15,25}", uid):
        return False, [{"step": "Configuration", "ok": False,
                        "detail": "DISCORD_USER_ID must be a numeric user ID "
                                  "(15-25 digits). Got %r." % uid}]

    # 1 — does the token work at all?
    status, body, raw = _discord_call("https://discord.com/api/v10/users/@me", token)
    if status == 200 and isinstance(body, dict):
        steps.append({"step": "Bot token", "ok": True,
                      "detail": "Authenticated as %s (id %s)."
                                % (body.get("username", "?"), body.get("id", "?"))})
        if body.get("id") == uid:
            steps.append({"step": "User ID", "ok": False,
                          "detail": "That is the bot's own ID. Use *your* user ID — "
                                    "a bot cannot DM itself."})
            return False, steps
    else:
        msg = (body or {}).get("message") if isinstance(body, dict) else None
        detail = "HTTP %s — %s" % (status, msg or raw[:200])
        if status == 401:
            looks_like = identify_credential(token)
            if looks_like:
                detail += "  That value looks like %s" % looks_like
            else:
                detail += ("  The shape is right, so this token has been revoked "
                           "or reset. Discord also revokes tokens automatically if "
                           "they are ever committed to a public repository. "
                           "Generate a new one with Bot → Reset Token.")
        steps.append({"step": "Bot token", "ok": False, "detail": detail})
        return False, steps

    # 2 — can a DM channel be opened with this recipient?
    status, body, raw = _discord_call(
        "https://discord.com/api/v10/users/@me/channels", token,
        {"recipient_id": uid})
    if status in (200, 201) and isinstance(body, dict) and body.get("id"):
        channel = body["id"]
        steps.append({"step": "Open DM channel", "ok": True,
                      "detail": "Channel %s opened." % channel})
    else:
        msg = (body or {}).get("message") if isinstance(body, dict) else None
        code = (body or {}).get("code") if isinstance(body, dict) else None
        detail = "HTTP %s — %s" % (status, msg or raw[:200])
        if code == 50007:
            detail += ("  Discord refuses the DM: the bot must share a server with "
                       "you, and your Privacy Settings for that server must allow "
                       "direct messages from members.")
        elif status == 400:
            detail += ("  Discord rejected the recipient. Check the ID is your own "
                       "user ID (Developer Mode → right-click yourself → Copy User ID), "
                       "not a server, channel or message ID.")
        steps.append({"step": "Open DM channel", "ok": False, "detail": detail})
        return False, steps

    # 3 — will it accept a message on that channel?
    status, body, raw = _discord_call(
        "https://discord.com/api/v10/channels/%s/messages" % channel, token,
        {"content": "Proxmox Auto-Update: Discord DM test. "
                    "If you can read this, DM notifications work."})
    if status in (200, 201):
        steps.append({"step": "Send message", "ok": True,
                      "detail": "Test message delivered — check your DMs."})
        return True, steps

    msg = (body or {}).get("message") if isinstance(body, dict) else None
    steps.append({"step": "Send message", "ok": False,
                  "detail": "HTTP %s — %s" % (status, msg or raw[:200])})
    return False, steps


def read_crontab():
    try:
        res = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=10)
        return res.stdout if res.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def current_schedule():
    for line in read_crontab().splitlines():
        if UPDATE_SCRIPT in line and not line.strip().startswith("#"):
            return " ".join(line.split()[:5])
    return ""


# --- Schedules ---------------------------------------------------------------
#
# UPDATE_SCHEDULES is ';'-separated, each entry '<cron>|<yes|no>|<label>'. A
# schedule marked "no" is written into the crontab with --no-reboot, so a host
# can take updates weekly and only reboot for a kernel once a month.
#
# The same format is parsed by parse_schedules() in update-everything.sh and
# install.sh; ci/invariants.sh checks that all three agree.
SCHEDULE_MODES = ("yes", "no", "only")


def parse_schedules(raw, legacy_cron=""):
    """[{'cron': str, 'mode': str, 'label': str}] from the config value.

    mode is 'yes' (update, reboot if a kernel lands), 'no' (update, never
    reboot) or 'only' (reboot window: install nothing, take a reboot that is
    already owed).
    """
    out = []
    for entry in (raw or "").split(";"):
        entry = entry.strip()
        if not entry:
            continue
        # Split at most twice, so a label that still contains a separator is
        # kept whole rather than truncated at the first one. format_schedules
        # strips separators on the way out, but a hand-edited config can carry
        # them in - and the shell parser keeps everything after the second
        # pipe, so anything else here is a disagreement.
        parts = entry.split("|", 2)
        cron = parts[0].strip()
        if not cron:
            continue
        mode = parts[1].strip().lower() if len(parts) > 1 else "yes"
        if mode not in SCHEDULE_MODES:
            mode = "yes"
        label = parts[2].strip() if len(parts) > 2 else ""
        out.append({"cron": cron, "mode": mode, "label": label})
    if not out and legacy_cron:
        # A pre-1.9 config: one schedule, and it always rebooted.
        out.append({"cron": legacy_cron, "mode": "yes", "label": "Updates"})
    return out


def format_schedules(items):
    """The config-file form. Separators cannot appear inside a label."""
    parts = []
    for it in items:
        label = str(it.get("label", "")).replace(";", " ").replace("|", " ").strip()
        mode = it.get("mode", "yes")
        if mode not in SCHEDULE_MODES:
            mode = "yes"
        parts.append("%s|%s|%s" % (it["cron"], mode, label))
    return ";".join(parts)


def current_schedules():
    cfg = read_config()
    return parse_schedules(cfg.get("UPDATE_SCHEDULES", ""),
                           cfg.get("UPDATE_SCHEDULE_CRON", ""))


def write_schedule(items):
    """Replace our crontab entries, leaving every other entry untouched.

    Every line this tool owns either names UPDATE_SCRIPT or starts with
    CRON_MARKER, so the per-schedule comments are removed on rewrite instead of
    accumulating a stale one for every schedule ever configured.
    """
    kept = [
        line
        for line in read_crontab().splitlines()
        if UPDATE_SCRIPT not in line and not line.strip().startswith(CRON_MARKER)
    ]
    while kept and not kept[-1].strip():
        kept.pop()
    kept.append(CRON_MARKER)
    logdir = resolve_log_dir()
    note = {"yes": "", "no": " (no reboot)", "only": " (reboot window)"}
    flag = {"yes": "", "no": " --no-reboot", "only": " --reboot-window"}
    for it in items:
        mode = it.get("mode", "yes")
        if it.get("label"):
            kept.append("%s: %s%s" % (CRON_MARKER, it["label"], note.get(mode, "")))
        kept.append("%s %s%s >> %s/cron.log 2>&1" % (
            it["cron"], UPDATE_SCRIPT, flag.get(mode, ""), logdir))
    payload = "\n".join(kept) + "\n"

    proc = subprocess.run(["crontab", "-"], input=payload, text=True,
                          capture_output=True, timeout=10)
    if proc.returncode != 0:
        raise ValueError(proc.stderr.strip() or "crontab rejected the schedule")


def list_logs(limit=40):
    if not os.path.isdir(resolve_log_dir()):
        return []
    entries = []
    for name in os.listdir(resolve_log_dir()):
        if not name.endswith(".log"):
            continue
        path = os.path.join(resolve_log_dir(), name)
        try:
            st = os.stat(path)
        except OSError:
            continue
        entries.append({"name": name, "size": st.st_size, "mtime": st.st_mtime})
    entries.sort(key=lambda e: e["mtime"], reverse=True)
    return entries[:limit]


def safe_log_path(name):
    """Resolve a log name to a path inside the log directory, or None if it escapes."""
    if not name or "/" in name or "\\" in name or name.startswith("."):
        return None
    # A NUL in the name makes the path calls below raise ValueError rather than
    # return anything, and an uncaught one here is a dropped request and a
    # traceback in the journal instead of a clean rejection. Everything that
    # cannot be a path is simply not a log name.
    if chr(0) in name:
        return None
    try:
        path = os.path.realpath(os.path.join(resolve_log_dir(), name))
        if os.path.dirname(path) != os.path.realpath(resolve_log_dir()):
            return None
        return path if os.path.isfile(path) else None
    except (ValueError, OSError):
        return None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\r")


def strip_ansi(text):
    return ANSI_RE.sub("", text)



# --- Snapshots ----------------------------------------------------------------
#
# update-everything.sh creates "autoupdate_<YYYYMMDD>_<HHMMSS>" before updating
# a guest, and prunes its own to SNAPSHOT_KEEP. Only names matching that exact
# shape are ever offered for deletion here: a snapshot somebody took by hand is
# listed for context - so the counts on screen are the truth about the node -
# and refused if it is ever asked for.
SNAPSHOT_PREFIX = "autoupdate"
OURS_RE = re.compile(r"\Aautoupdate_\d{8}_\d{6}\Z")


def _snap_api_path(node, vmid, kind):
    return "/nodes/%s/%s/%s/snapshot" % (node, "lxc" if kind == "lxc" else "qemu", vmid)


def list_snapshots():
    """Snapshots per guest: [{vmid, name, type, node, snapshots: [...]}].

    Proxmox does not report a per-snapshot size through this API - what a
    snapshot costs is a property of the storage (ZFS, LVM-thin, qcow2), not of
    the snapshot object. Rather than invent a figure, size is reported as
    unknown and the UI says why.
    """
    guests, err = list_guests()
    if err:
        return [], err

    out = []
    for guest in guests:
        node = guest.get("node") or _node_name()
        path = _snap_api_path(node, guest["vmid"], guest["type"])
        res = _run(["pvesh", "get", path, "--output-format", "json"], timeout=20)
        if not res or res.returncode != 0:
            # A guest whose snapshots cannot be read is reported as such, not
            # silently shown as having none.
            out.append(dict(guest, snapshots=None,
                            error=(res.stderr.strip() if res else "pvesh did not run")))
            continue
        try:
            raw = json.loads(res.stdout)
        except ValueError:
            out.append(dict(guest, snapshots=None, error="unreadable snapshot list"))
            continue

        snaps = []
        for item in raw if isinstance(raw, list) else []:
            name = item.get("name") or ""
            # "current" is the running state, not a snapshot.
            if not name or name == "current":
                continue
            snaps.append({
                "name": name,
                "ours": bool(OURS_RE.match(name)),
                "snaptime": item.get("snaptime"),
                "description": (item.get("description") or "").strip(),
                "parent": item.get("parent") or "",
            })
        snaps.sort(key=lambda x: x.get("snaptime") or 0)
        out.append(dict(guest, snapshots=snaps, error=None))
    return out, None


def delete_snapshots(targets):
    """Delete only snapshots this tool created. Returns (deleted, failures).

    Every name is re-checked here rather than trusted from the request: the
    client is the wrong place to enforce which snapshots may be destroyed.
    """
    deleted, failures = [], []
    known = {g["vmid"]: g for g in (list_guests()[0] or [])}
    for target in targets:
        vmid = str(target.get("vmid", ""))
        name = str(target.get("name", ""))
        guest = known.get(vmid)
        if guest is None:
            failures.append({"vmid": vmid, "name": name, "error": "no such guest"})
            continue
        if not OURS_RE.match(name):
            failures.append({"vmid": vmid, "name": name,
                             "error": "not a snapshot created by this tool"})
            continue
        node = guest.get("node") or _node_name()
        res = _run(["pvesh", "delete",
                    "%s/%s" % (_snap_api_path(node, vmid, guest["type"]), name)],
                   timeout=60)
        if res and res.returncode == 0:
            deleted.append({"vmid": vmid, "name": name})
        else:
            failures.append({"vmid": vmid, "name": name,
                             "error": (res.stderr.strip() if res else "pvesh did not run")
                                      or "delete failed"})
    return deleted, failures


# --- Authentication -----------------------------------------------------------

TICKET_RE = re.compile(r"^PVE:([^:]+):")

_ssl_noverify = ssl.create_default_context()
_ssl_noverify.check_hostname = False
_ssl_noverify.verify_mode = ssl.CERT_NONE


# Cache of ticket -> (username-or-None, expiry). Both outcomes are cached.
#
# Without this, every single request — including the status poll every 2s from
# every open tab — made a blocking HTTPS call to pvedaemon with an 8s timeout,
# before any cheaper check. That had two consequences. Upgrading pve-manager
# during a run made the panel log the operator out mid-run, because a transport
# failure was reported as 401. And because the ticket pattern is a trivial
# regex, unauthenticated requests reached that call too, so N cheap connections
# pinned N threads for 8s each against the daemon the Proxmox UI itself depends
# on.
_TICKET_CACHE = {}
_TICKET_CACHE_LOCK = threading.Lock()
_TICKET_TTL_OK = 30.0
_TICKET_TTL_BAD = 5.0
_TICKET_CACHE_MAX = 512

# Raised when the PVE API could not be reached at all, as distinct from it
# rejecting the ticket. The first is a 503 (try again), the second a 401.
class AuthBackendUnavailable(Exception):
    pass


def _verify_ticket_upstream(ticket):
    req = urllib.request.Request(
        "https://127.0.0.1:8006/api2/json/access/permissions",
        headers={"Cookie": "PVEAuthCookie=%s" % ticket},
    )
    try:
        with urllib.request.urlopen(req, context=_ssl_noverify, timeout=8) as resp:
            return resp.status == 200
    except urllib.error.HTTPError:
        # The API answered and said no. That is a real rejection.
        return False
    except (urllib.error.URLError, OSError, ssl.SSLError):
        raise AuthBackendUnavailable()


def verify_ticket(ticket):
    """Validate a PVEAuthCookie against the local PVE API. Returns username or None.

    The signature check is delegated to pvedaemon rather than reimplemented:
    if the API accepts the cookie, it is genuine and unexpired.

    Raises AuthBackendUnavailable if pvedaemon could not be reached, so the
    caller can answer 503 rather than pretending the user is logged out.
    """
    if not ticket:
        return None
    match = TICKET_RE.match(ticket)
    if not match:
        return None
    user = match.group(1)

    now = time.monotonic()
    with _TICKET_CACHE_LOCK:
        hit = _TICKET_CACHE.get(ticket)
        if hit and hit[1] > now:
            return hit[0]

    ok = _verify_ticket_upstream(ticket)
    result = user if ok else None

    with _TICKET_CACHE_LOCK:
        if len(_TICKET_CACHE) >= _TICKET_CACHE_MAX:
            # Cheap bound: drop everything already expired, then, if that was
            # not enough, clear the lot. This is a single-node admin panel, not
            # a session store.
            for key in [k for k, v in _TICKET_CACHE.items() if v[1] <= now]:
                _TICKET_CACHE.pop(key, None)
            if len(_TICKET_CACHE) >= _TICKET_CACHE_MAX:
                _TICKET_CACHE.clear()
        _TICKET_CACHE[ticket] = (result, now + (_TICKET_TTL_OK if ok else _TICKET_TTL_BAD))
    return result


# CSRF: a token bound to the ticket, handed out with the page and required on
# every mutating request. Cross-origin script cannot read our HTML, so it cannot
# obtain the token.
_CSRF_SECRET = token_urlsafe(32)
_csrf_tokens = {}
_csrf_lock = threading.Lock()


def issue_csrf(user):
    token = token_urlsafe(24)
    with _csrf_lock:
        now = time.time()
        for key, (_, ts) in list(_csrf_tokens.items()):
            if now - ts > 43200:
                _csrf_tokens.pop(key, None)
        _csrf_tokens[token] = (user, now)
    return token


def check_csrf(token, user):
    if not token:
        return False
    with _csrf_lock:
        entry = _csrf_tokens.get(token)
    if not entry:
        return False
    owner, ts = entry
    return compare_digest(owner, user) and (time.time() - ts) <= 43200


# --- HTTP handler -------------------------------------------------------------


class Handler(BaseHTTPRequestHandler):
    server_version = "ProxmoxAutoUpdateUI/1.0"
    protocol_version = "HTTP/1.1"
    # HTTP/1.1 means keep-alive, so a browser leaves the connection open
    # after a response. Without a timeout the read for the next request line
    # blocks forever and the thread behind it is never freed. Applied by
    # StreamRequestHandler.setup(); it bounds individual socket operations,
    # not how long a handler may take, so the slow endpoints that shell out
    # for up to three minutes are unaffected.
    timeout = IDLE_TIMEOUT

    # -- plumbing --

    def log_message(self, fmt, *args):
        sys.stderr.write("[ui] %s - %s\n" % (self.address_string(), fmt % args))

    def _allowed_origin(self):
        """Echo the Origin back only when it is this same host on another port.

        The Proxmox UI runs on :8006 and this panel on its own port, so the status dot
        is a cross-origin credentialed request. Credentialed CORS forbids '*',
        and reflecting arbitrary origins would let any site read run status
        using the visitor's cookie — so the hostname must match exactly.
        """
        origin = self.headers.get("Origin")
        if not origin:
            return None
        try:
            parsed = urllib.parse.urlparse(origin)
        except ValueError:
            return None
        if parsed.scheme != "https" or not parsed.hostname:
            return None

        host_header = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        candidates = {host_header.lower()} if host_header else set()
        candidates.discard("")
        if parsed.hostname.lower() in candidates:
            return origin
        return None

    def _send(self, code, body, ctype="application/json", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        allowed = self._allowed_origin()
        if allowed:
            self.send_header("Access-Control-Allow-Origin", allowed)
            self.send_header("Access-Control-Allow-Credentials", "true")
            self.send_header("Vary", "Origin")
        # Allow the Proxmox UI (any port on *this host*) to frame us, and
        # nothing else.
        #
        # This said `frame-ancestors https:`, which permits every HTTPS origin
        # on the internet — the opposite of what the comment claimed. Any site
        # could iframe this panel and clickjack "Update everything now" or the
        # uninstall action, and with CONFIRM_UPDATES=false there is not even a
        # dialog in the way. The host header gives us the one origin that should
        # legitimately be framing this.
        host_only = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        if host_only and _SAFE_HOST_RE.match(host_only):
            frame_ancestors = "'self' https://%s:*" % host_only
        else:
            frame_ancestors = "'self'"
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; style-src 'self' 'unsafe-inline'; "
                         "script-src 'self' 'unsafe-inline'; "
                         "base-uri 'none'; form-action 'self'; "
                         "frame-ancestors " + frame_ancestors)
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _json(self, code, payload):
        self._send(code, json.dumps(payload), "application/json")

    def _auth(self):
        """Returns the username, or None after having already sent a 401."""
        cookies = self.headers.get("Cookie", "")
        ticket = None
        for part in cookies.split(";"):
            name, _, value = part.strip().partition("=")
            if name == "PVEAuthCookie":
                ticket = urllib.parse.unquote(value)
                break

        try:
            user = verify_ticket(ticket)
        except AuthBackendUnavailable:
            # pvedaemon is not answering. That is not the same as the operator
            # being logged out, and reporting it as 401 was actively misleading
            # during the one moment it happens most: a host dist-upgrade that
            # restarts pve-manager while a run is in progress.
            self._json(503, {"error": "The Proxmox API is not responding right now "
                                      "(it restarts during a host upgrade). "
                                      "This page will keep retrying."})
            return None
        if not user:
            self._json(401, {"error": "Not logged in to Proxmox. "
                                      "Open the Proxmox web UI, log in, then reload."})
            return None
        if user not in ALLOWED_USERS:
            self._json(403, {"error": "User %s is not permitted to control updates." % user})
            return None
        return user

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return {}
        if length <= 0 or length > 1_000_000:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}

    # -- routes --

    def do_GET(self):
        path, _, query = self.path.partition("?")
        path = strip_base(path)
        params = urllib.parse.parse_qs(query)

        if path == "/healthz":
            self._send(200, "ok", "text/plain")
            return

        user = self._auth()
        if not user:
            return

        if path == "/":
            token = issue_csrf(user)
            self._send(200, render_page(user, token), "text/html; charset=utf-8")
        elif path == "/guest":
            vmid = (params.get("vmid") or [""])[0]
            if not vmid.isdigit():
                self._send(400, "<p>Missing or invalid vmid.</p>", "text/html; charset=utf-8")
                return
            name = (params.get("name") or [""])[0]
            token = issue_csrf(user)
            self._send(200, render_guest_page(user, token, vmid, name),
                       "text/html; charset=utf-8")
        elif path == "/api/snapshots":
            snaps, err = list_snapshots()
            if err:
                self._json(500, {"error": "Could not list snapshots: %s" % err})
                return
            ours = sum(len([x for x in (g["snapshots"] or []) if x["ours"]]) for g in snaps)
            other = sum(len([x for x in (g["snapshots"] or []) if not x["ours"]]) for g in snaps)
            self._json(200, {"guests": snaps, "ours": ours, "other": other})
        elif path == "/api/schedules":
            # A read, and the page fetches it with GET. It used to be registered
            # under do_POST only, so loadSchedules() got a 404 and the Schedule
            # tab showed "Not found" with no schedules listed at all - the whole
            # screen was dead, and nothing in CI or the config-parity checks
            # looks at which HTTP method serves a route.
            self._json(200, {"schedules": current_schedules()})
        elif path == "/api/guests":
            guests, err = list_guests()
            if err:
                self._json(500, {"error": "Could not list guests: %s" % err})
                return
            self._json(200, {"guests": guests})
        elif path == "/api/status":
            status = JOB.snapshot()
            status["lock_held"] = lock_is_held() and not status["running"]
            status["schedule"] = current_schedule()
            status["schedules"] = current_schedules()
            status["user"] = user
            status["version"] = installed_version()
            # The header has to distinguish "updating the guests" from "updating
            # this tool" — they look the same from the job's point of view but
            # mean very different things to whoever is reading the page.
            maint = maintenance_status()
            status["self_updating"] = maint["busy"]
            status["pending"] = maint["pending"]
            self._json(200, status)
        elif path == "/api/state":
            # Consumed cross-origin by the toolbar button's status dot. Includes
            # the self-update fields so the button can say it is updating the
            # tool rather than the guests — the two mean different things, and
            # only one of them invalidates the page you are looking at.
            state = read_state()
            snap = JOB.snapshot()
            maint = maintenance_status()
            self._json(200, {
                "running": snap["running"] or lock_is_held(),
                "last_run": state.get("last_run") or {},
                "repeat_offenders": repeat_offenders_text(),
                "version": installed_version(),
                "self_update": maint["self_update"],
                "pending": maint["pending"],
                # Carried here rather than on a second endpoint: the toolbar
                # button already polls this and caches it, so the injected
                # buttons in the Proxmox UI can follow the panel's colours
                # without any extra request.
                "theme": theme_for_client(),
            })
        elif path == "/api/history":
            state = read_state()
            self._json(200, {
                "runs": state.get("runs") or [],
                "guests": state.get("guests") or {},
                "repeat_offenders": repeat_offenders_text(),
            })
        elif path == "/api/logs/stats":
            cfg = read_config()
            stats = log_stats()
            stats["keep_logs"] = (cfg.get("KEEP_LOGS") or "true")
            stats["retention_days"] = (cfg.get("LOG_RETENTION_DAYS") or "90")
            self._json(200, stats)
        elif path == "/api/self/version":
            status = maintenance_status()
            status["version"] = installed_version()
            status["expected"] = PENDING_VERSION.get("target")
            self._json(200, status)
        elif path == "/api/self/changelog":
            text, warning = fetch_changelog()
            self._json(200, {
                "entries": parse_changelog(text),
                "installed": installed_version(),
                "warning": warning,
                "url": "https://github.com/%s/releases" % GITHUB_REPO,
            })
        elif path == "/api/config":
            # Secrets are redacted here, on the server.
            #
            # This used to return the Mailgun API key, the Discord bot token and
            # every webhook URL in cleartext, and rely on the browser to render
            # them as asterisks. Anything that could read the response — an
            # extension, a proxy, devtools, a saved HAR — had the credentials.
            # The client already treats an all-asterisk value as "unchanged", so
            # sending a placeholder is enough for the form to round-trip.
            cfg = read_config()
            payload = {}
            for k in EDITABLE_KEYS:
                # Fall back to the effective default rather than an empty
                # string. A blank box for a setting that does have a value is
                # misleading, and it used to make the whole form unsaveable:
                # every field is posted on save, and an empty integer failed
                # validation.
                value = cfg.get(k)
                if k == "EMAIL_TRANSPORT":
                    value = effective_email_transport(cfg)
                elif value is None or value == "":
                    value = KEY_DEFAULTS.get(k, "")
                if k in SENSITIVE_KEYS and value:
                    payload[k] = "*" * 12
                else:
                    payload[k] = value
            self._json(200, {"config": payload, "sensitive": sorted(SENSITIVE_KEYS)})
        elif path == "/api/theme":
            self._json(200, {"theme": read_theme(),
                             "defaults": THEME_DEFAULTS,
                             "presets": THEME_PRESETS})
        elif path == "/api/logs":
            self._json(200, {"logs": list_logs()})
        elif path == "/api/log/download":
            self._download_log(params)
        elif path == "/api/log":
            self._serve_log(params)
        else:
            self._json(404, {"error": "Not found"})

    def _download_log(self, params):
        """Serve one log, or all of them as a .tar.gz, as a file download.

        Reading a log in the browser and getting a copy off the box are
        different jobs: the viewer strips ANSI and pages through 256 KiB at a
        time, which is right for reading and wrong for attaching to a bug
        report. This serves the bytes as they are on disk.
        """
        name = (params.get("name") or [None])[0]
        log_dir = resolve_log_dir()

        if name in (None, "", "all"):
            names = [n for n in sorted(os.listdir(log_dir))
                     if n.endswith(".log")] if os.path.isdir(log_dir) else []
            if not names:
                self._json(404, {"error": "No logs to download"})
                return
            buf = io.BytesIO()
            with tarfile.open(fileobj=buf, mode="w:gz") as tar:
                for n in names:
                    p = safe_log_path(n)
                    if p:
                        try:
                            tar.add(p, arcname="proxmox-autoupdate-logs/%s" % n)
                        except OSError:
                            continue
            payload = buf.getvalue()
            stamp = time.strftime("%Y%m%d-%H%M%S")
            self._send(200, payload, ctype="application/gzip", extra={
                "Content-Disposition":
                    'attachment; filename="proxmox-autoupdate-logs-%s.tar.gz"' % stamp,
            })
            return

        path = safe_log_path(name)
        if not path:
            self._json(404, {"error": "No such log"})
            return
        try:
            with open(path, "rb") as fh:
                payload = fh.read()
        except OSError as exc:
            self._json(500, {"error": "Could not read the log: %s" % exc})
            return
        # safe_log_path has already confirmed this resolves inside the log
        # directory, so the name cannot carry a path or escape the quotes.
        self._send(200, payload, ctype="text/plain; charset=utf-8", extra={
            "Content-Disposition": 'attachment; filename="%s"' % os.path.basename(path),
        })

    def _serve_log(self, params):
        name = (params.get("name") or [None])[0]
        if name is None:
            status = JOB.snapshot()
            name = status["log"]
            if not name:
                self._json(200, {"data": "", "offset": 0, "eof": True})
                return
        path = safe_log_path(name)
        if not path:
            self._json(404, {"error": "No such log"})
            return
        try:
            offset = int((params.get("offset") or ["0"])[0])
        except ValueError:
            offset = 0

        size = os.path.getsize(path)
        if offset > size:      # log rotated or truncated underneath us
            offset = 0
        with open(path, "rb") as fh:
            fh.seek(offset)
            chunk = fh.read(256 * 1024)
        self._json(200, {
            "data": strip_ansi(chunk.decode("utf-8", errors="replace")),
            "offset": offset + len(chunk),
            "eof": offset + len(chunk) >= size,
            "name": name,
        })

    def do_POST(self):
        path = strip_base(self.path.partition("?")[0])
        user = self._auth()
        if not user:
            return

        if not check_csrf(self.headers.get("X-PAU-CSRF"), user):
            self._json(403, {"error": "Invalid or expired CSRF token — reload the page."})
            return

        body = self._body()

        if path == "/api/run":
            self._run(body, user)
        elif path == "/api/guest/run":
            self._run_guest(body, user)
        elif path == "/api/exclusions":
            self._save_exclusions(body)
        elif path == "/api/snapshots/delete":
            self._delete_snapshots(body, user)
        elif path == "/api/config":
            self._save_config(body)
        elif path == "/api/theme":
            self._save_theme(body)
        elif path == "/api/schedule":
            self._save_schedule(body)
        elif path == "/api/notify/test":
            self._test_notification()
        elif path == "/api/notify/diagnose-discord":
            ok, steps = diagnose_discord_dm(read_config())
            self._json(200, {"ok": ok, "steps": steps})
        elif path == "/api/logs/purge":
            removed = purge_logs()
            self._json(200, {"removed": removed})
        elif path == "/api/self/check":
            # An explicit check bypasses the cache; the background poll does not.
            self._json(200, check_for_updates(force=True))
        elif path == "/api/self/doctor":
            self._json(200, run_doctor())
        elif path == "/api/subscription-notice":
            self._set_subscription_notice(body)
        elif path == "/api/self/update":
            self._self_update(body, user)
        elif path == "/api/self/uninstall":
            self._self_uninstall(body, user)
        else:
            self._json(404, {"error": "Not found"})

    def _test_notification(self):
        # Always 200: the request succeeded, and it is the *test* that passed or
        # failed. Returning 400 made the browser's generic error path fire and
        # report "HTTP 400", throwing away the explanation in the body — which
        # is the one thing anyone needs from this button.
        ok, detail = send_test_notification(read_config())
        self._json(200, {"ok": ok, "detail": detail})

    def _self_update(self, body, user):
        if body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Self-update requires an explicit confirmation."})
            return
        if JOB.snapshot()["running"] or lock_is_held():
            self._json(409, {"error": "An update run is in progress — wait for it to finish."})
            return
        if maintenance_status()["busy"]:
            self._json(409, {"error": "A self-update or uninstall is already running."})
            return

        ref = latest_release_ref()
        url = install_script_url(ref)
        if not url:
            self._json(503, {"error": "Could not determine the latest release from GitHub. "
                                      "Nothing has been changed."})
            return

        # Runs detached: the installer replaces this very script and restarts
        # this service, so it cannot be a child of the request handling it.
        #
        # The downloaded installer is checked before it is executed. curl --fail
        # already rejects an HTTP error, but a captive portal or filtering proxy
        # can return 200 with its own body, and this runs as root — so confirm
        # it is a shell script, that it parses, and that it is recognisably our
        # installer before handing it to bash. PAU_REF pins the child install to
        # the same tag we just resolved, so the version that gets installed is
        # the one that was checked.
        command = (
            "set -eu; "
            "d=$(mktemp -d); trap 'rm -rf \"$d\"' EXIT; "
            "curl -fsSL --retry 3 --retry-delay 2 -m 120 %s -o \"$d/install.sh\"; "
            "test -s \"$d/install.sh\"; "
            "head -1 \"$d/install.sh\" | grep -q '^#!'; "
            "grep -q 'proxmox-autoupdate' \"$d/install.sh\"; "
            "bash -n \"$d/install.sh\"; "
            "PAU_REF=%s bash \"$d/install.sh\" --unattended"
        ) % (shlex.quote(url), shlex.quote(ref))
        # Remember what we are installing, so the button stays disabled until
        # that exact version is confirmed running rather than merely until the
        # unit exits.
        target = body.get("target_version")
        if not target:
            info = check_for_updates()
            target = info.get("latest")
        set_pending_version(target)

        ok, detail = run_detached(command, SELFUPDATE_UNIT)
        if not ok:
            set_pending_version(None)
            self._json(500, {"error": "Could not start the update: %s" % detail})
            return
        sys.stderr.write("[ui] self-update to %s started by %s\n" % (target, user))
        self._json(200, {
            "started": True,
            "detail": "Update started. This panel will restart part way through — "
                      "the page will reconnect on its own.",
        })

    def _self_uninstall(self, body, user):
        # Two independent gates: the typed word, and an explicit acknowledgement
        # that this removes the panel serving the request.
        if body.get("confirm") != "UNINSTALL":
            self._json(400, {"error": "Type UNINSTALL to confirm."})
            return
        if not body.get("acknowledged"):
            self._json(400, {"error": "Acknowledgement required."})
            return
        if JOB.snapshot()["running"] or lock_is_held():
            self._json(409, {"error": "An update run is in progress — wait for it to finish."})
            return

        purge = " --purge" if body.get("purge") else ""
        if os.path.isfile(UNINSTALL_SCRIPT):
            command = "%s --yes%s" % (UNINSTALL_SCRIPT, purge)
        else:
            base = github_raw_base()
            if not base:
                self._json(503, {"error": "The local uninstaller is missing and the latest "
                                          "release could not be resolved. Nothing was changed."})
                return
            command = (
                "set -eu; "
                "d=$(mktemp -d); trap 'rm -rf \"$d\"' EXIT; "
                "curl -fsSL --retry 3 -m 120 %s/uninstall.sh -o \"$d/uninstall.sh\"; "
                "test -s \"$d/uninstall.sh\"; "
                "head -1 \"$d/uninstall.sh\" | grep -q '^#!'; "
                "bash -n \"$d/uninstall.sh\"; "
                "bash \"$d/uninstall.sh\" --yes%s"
            ) % (shlex.quote(base), purge)

        ok, detail = run_detached(command, UNINSTALL_UNIT)
        if not ok:
            self._json(500, {"error": "Could not start the uninstall: %s" % detail})
            return
        sys.stderr.write("[ui] uninstall started by %s (purge=%s)\n" % (user, bool(purge)))
        self._json(200, {
            "started": True,
            "detail": "Uninstall started as %s. This panel will stop responding "
                      "shortly — that is expected." % detail,
        })

    def _run(self, body, user):
        dry = bool(body.get("dry_run", True))
        if not dry and body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Full runs require an explicit confirmation."})
            return
        if lock_is_held():
            self._json(409, {"error": "Another update run holds the lock "
                                      "(a scheduled run is probably in progress)."})
            return
        ok, detail = JOB.start(dry, user)
        if not ok:
            self._json(409, {"error": detail})
            return
        self._json(200, {"started": True, "log": detail, "dry_run": dry})

    def _run_guest(self, body, user):
        """Update a single guest. Never touches the host and never reboots."""
        vmid = str(body.get("vmid", "")).strip()
        if not vmid.isdigit():
            self._json(400, {"error": "Expected a numeric vmid."})
            return

        guests, err = list_guests()
        if err:
            self._json(500, {"error": "Could not verify the guest: %s" % err})
            return
        if vmid not in {g["vmid"] for g in guests}:
            self._json(404, {"error": "No guest with ID %s on this cluster." % vmid})
            return

        dry = bool(body.get("dry_run", True))
        if not dry and body.get("confirm") != "UPDATE":
            self._json(400, {"error": "Full runs require an explicit confirmation."})
            return
        if lock_is_held():
            self._json(409, {"error": "Another update run holds the lock "
                                      "(a scheduled run is probably in progress)."})
            return

        # No email for a single guest — the caller is watching the output live.
        ok, detail = JOB.start(dry, user, only=vmid, no_email=True)
        if not ok:
            self._json(409, {"error": detail})
            return
        self._json(200, {"started": True, "log": detail, "dry_run": dry, "vmid": vmid})

    def _delete_snapshots(self, body, user):
        targets = body.get("targets")
        if not isinstance(targets, list) or not targets:
            self._json(400, {"error": "Nothing selected."})
            return
        if len(targets) > 500:
            self._json(400, {"error": "Too many snapshots in one request."})
            return
        # Deleting more than one at a time is typed, not clicked - the same bar
        # as a full update run and as uninstalling.
        if len(targets) > 1 and str(body.get("confirm", "")).strip() != "DELETE":
            self._json(400, {"error": 'Type DELETE to remove more than one snapshot.'})
            return
        deleted, failures = delete_snapshots(targets)
        sys.stderr.write("[ui] %s deleted %d snapshot(s), %d failed\n"
                         % (user, len(deleted), len(failures)))
        self._json(200, {"deleted": deleted, "failures": failures})

    def _save_exclusions(self, body):
        ids = body.get("excluded")
        if not isinstance(ids, list):
            self._json(400, {"error": "Expected a list of IDs."})
            return
        cleaned = []
        for item in ids:
            text = str(item).strip()
            if not text.isdigit():
                self._json(400, {"error": "Not a valid guest ID: %r" % item})
                return
            cleaned.append(text)
        try:
            saved = set_excluded_ids(cleaned)
        except OSError as exc:
            self._json(500, {"error": "Could not write config: %s" % exc})
            return
        self._json(200, {"excluded": saved})

    def _set_subscription_notice(self, body):
        """Toggle the 'No valid subscription' dialog, and act on it now.

        Saving the setting alone would do nothing until the next apt
        transaction re-ran the patcher, so the toggle would appear not to work.
        The patcher reconciles the file against the config, so applying is the
        same call in both directions.
        """
        suppress = bool(body.get("suppress"))
        try:
            write_config({"SUPPRESS_SUBSCRIPTION_NOTICE": "true" if suppress else "false"})
        except OSError as exc:
            self._json(500, {"error": "Could not save the setting: %s" % exc})
            return

        if not os.path.isfile(UI_PATCHER):
            self._json(200, {"ok": True, "suppressed": suppress,
                             "note": "Saved. The Proxmox UI patcher is not installed, "
                                     "so nothing was changed in the interface."})
            return
        try:
            res = subprocess.run([UI_PATCHER, "nag-apply" if suppress else "nag-remove", "--quiet"],
                                 capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as exc:
            self._json(500, {"error": "Setting saved, but the patcher failed: %s" % exc})
            return
        if res.returncode != 0:
            self._json(500, {"error": "Setting saved, but the patcher failed: %s"
                                      % (strip_ansi(res.stdout + res.stderr).strip() or "unknown error")})
            return
        self._json(200, {"ok": True, "suppressed": suppress})

    def _save_theme(self, body):
        incoming = body.get("theme")
        if body.get("reset"):
            incoming = dict(THEME_DEFAULTS)
        preset = body.get("preset")
        if preset:
            if preset not in THEME_PRESETS:
                self._json(400, {"error": "Unknown preset '%s'" % preset})
                return
            incoming = dict(THEME_PRESETS[preset])
        if not isinstance(incoming, dict):
            self._json(400, {"error": "Expected a theme object"})
            return
        try:
            saved = write_theme(incoming)
        except ValueError as exc:
            self._json(400, {"error": str(exc)})
            return
        except OSError as exc:
            self._json(500, {"error": "Could not save the theme: %s" % exc})
            return
        self._json(200, {"ok": True, "theme": saved})

    def _save_config(self, body):
        incoming = body.get("config")
        if not isinstance(incoming, dict):
            self._json(400, {"error": "Expected a config object."})
            return

        updates, errors = {}, []
        for key, value in incoming.items():
            if key not in EDITABLE_KEYS:
                errors.append("%s is not an editable setting" % key)
                continue
            value = ("" if value is None else str(value)).strip()
            # An untouched sensitive field comes back as the placeholder; skip it
            # so we never overwrite a real key with asterisks.
            if key in SENSITIVE_KEYS and set(value) == {"*"}:
                continue
            if not EDITABLE_KEYS[key](value):
                # "invalid value" for a port is useless: the whole point is
                # which of eight rules it broke.
                if key == "WEB_UI_PORT":
                    errors.append("WEB_UI_PORT: %s" % (ui_port_problem(value)
                                                       or "invalid value"))
                else:
                    errors.append("%s: invalid value" % key)
                continue
            updates[key] = value

        if errors:
            self._json(400, {"error": "; ".join(errors)})
            return
        try:
            write_config(updates)
        except OSError as exc:
            self._json(500, {"error": "Could not write config: %s" % exc})
            return

        # Moving the panel's own port touches the drop-in, the firewall, the
        # toolbar button and this very service. Done after write_config(), so
        # the patcher below reads the new value.
        notice = ""
        if "WEB_UI_PORT" in updates and int(updates["WEB_UI_PORT"]) != LISTEN_PORT:
            moved_to = int(updates["WEB_UI_PORT"])
            ok, detail = apply_ui_port(moved_to)
            if not ok:
                self._json(500, {"error": "The port was saved to the config but not "
                                          "applied: %s" % detail})
                return
            notice = ("Moving to port %d. This service restarts in a few seconds, so "
                      "this page will stop responding - reopen the panel on the new "
                      "port. Hard-refresh the Proxmox UI (Ctrl+Shift+R) so the toolbar "
                      "button picks it up, and note that a self-signed certificate has "
                      "to be trusted again for a new port." % moved_to)
            if detail:
                notice += " [" + detail + "]"

        # The panel's external address is baked into pvemanagerlib.js by the
        # patcher, not read live. Writing the config alone would leave the
        # toolbar button pointing at the old address, which is a setting that
        # appears to save and silently does nothing -- and the reason this was
        # a config-file-only setting was that it needed a shell to apply.
        if "WEB_UI_PUBLIC_URL" in updates and os.path.isfile(UI_PATCHER):
            try:
                res = subprocess.run([UI_PATCHER, "apply", "--quiet"],
                                     capture_output=True, text=True, timeout=30)
                if res.returncode != 0:
                    self._json(500, {
                        "error": "Config saved, but the toolbar button could not be "
                                 "re-applied: %s" % (res.stderr or res.stdout or
                                                     "exit %d" % res.returncode)})
                    return
            except (OSError, subprocess.SubprocessError) as exc:
                self._json(500, {"error": "Config saved, but re-applying the toolbar "
                                          "button failed: %s" % exc})
                return

        # The cron expression lives in both the config and the crontab.
        if "UPDATE_SCHEDULE_CRON" in updates:
            try:
                write_schedule(parse_schedules(
                    read_config().get("UPDATE_SCHEDULES", ""),
                    updates["UPDATE_SCHEDULE_CRON"]))
            except (ValueError, OSError, subprocess.SubprocessError) as exc:
                self._json(500, {"error": "Config saved, but crontab update failed: %s" % exc})
                return
        self._json(200, {"saved": sorted(updates), "notice": notice})

    def _save_schedule(self, body):
        # Accepts either a list of schedules, or the single "cron" key an older
        # page would send. The crontab and the config are written together;
        # letting them drift is how a host ends up running a schedule nobody
        # can see in the panel.
        raw = body.get("schedules")
        if raw is None:
            expr = str(body.get("cron", "")).strip()
            raw = [{"cron": expr, "mode": "yes", "label": "Updates"}] if expr else []
        if not isinstance(raw, list) or not raw:
            self._json(400, {"error": "At least one schedule is required."})
            return
        if len(raw) > 10:
            self._json(400, {"error": "Ten schedules is the limit."})
            return

        items = []
        for entry in raw:
            if not isinstance(entry, dict):
                self._json(400, {"error": "Each schedule must be an object."})
                return
            expr = " ".join(str(entry.get("cron", "")).split())
            if not _v_cron(expr):
                self._json(400, {"error": "Not a 5-field cron expression: %r" % expr})
                return
            label = str(entry.get("label", ""))[:60]
            if any(c in label for c in ";|\n\r"):
                self._json(400, {"error": "A label cannot contain ; | or a line break."})
                return
            mode = str(entry.get("mode", "yes")).lower()
            if mode not in SCHEDULE_MODES:
                self._json(400, {"error": "Unknown schedule mode: %r" % mode})
                return
            items.append({"cron": expr, "mode": mode, "label": label.strip()})

        if not any(it["mode"] in ("yes", "only") for it in items):
            # Not refused — it is a legitimate choice for a host that is
            # rebooted by hand — but it is almost never what someone means.
            warning = ("No schedule may reboot, so a new kernel will install "
                       "and then wait indefinitely.")
        elif all(it["mode"] == "only" for it in items):
            warning = ("Every schedule is a reboot window, so nothing will ever "
                       "be updated.")
        else:
            warning = ""

        try:
            write_schedule(items)
        except (ValueError, OSError, subprocess.SubprocessError) as exc:
            self._json(400, {"error": str(exc)})
            return
        try:
            write_config({"UPDATE_SCHEDULES": format_schedules(items),
                          "UPDATE_SCHEDULE_CRON": items[0]["cron"]})
        except OSError as exc:
            self._json(500, {"error": "Crontab updated, but config write failed: %s" % exc})
            return
        self._json(200, {"schedules": items, "warning": warning})


