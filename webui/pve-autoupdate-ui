      v = await api("/api/self/version");
    } catch (e) {
      // The service restarts mid-update; keep waiting rather than erroring.
      return;
    }
    $("verInstalled").textContent = v.version;
    if (!renderMaintState(v)) {
      clearInterval(maintPoll); maintPoll = null;
      // Only reached once the installed version matches what was being
      // installed, so this really does mean finished.
      msg($("verMsg"), "Updated to " + v.version + ".", true);
      $("btnSelfUpdate").classList.add("hidden");
      $("reloadWarning").classList.add("hidden");
      latestVersion = null;
      loadChangelog();
      if (!versionDriftPrompted) {
