# EMAIL_TRANSPORT is not a plain default — the script infers it when unset, so
# that installations predating SMTP support keep using Mailgun without anyone
# editing anything. Mirror that inference here, or the panel would show "SMTP
# server" selected on a working Mailgun install and quietly misrepresent what
# the next run will actually do.
def effective_email_transport(cfg):
    explicit = (cfg.get("EMAIL_TRANSPORT") or "").strip()
    if explicit in ("mailgun", "smtp"):
        return explicit
    return "mailgun" if (cfg.get("MAILGUN_API_KEY") or "").strip() else "smtp"


