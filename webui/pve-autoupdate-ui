def _port_in_use(port):
    """Bind to it. Parsing `ss` is a second implementation to get wrong."""
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        probe.bind(("0.0.0.0", port))
        return False
    except OSError:
        return True
    finally:
        probe.close()


def ui_port_problem(value):
    """Why this port cannot be used, or "" if it can."""
    value = (value or "").strip()
    if not value.isdigit():
        return "not a number"
    port = int(value)
    # The port already in use is always allowed: it is the current one.
    if port == LISTEN_PORT:
        return ""
    if port < 1024:
        return "below 1024 - privileged, and reserved for well-known services"
    if port > 65535:
        return "above 65535 - not a port"
    if 5900 <= port <= 5999:
        return "inside 5900-5999, which Proxmox uses for VNC consoles"
    if 60000 <= port <= 60050:
        return "inside 60000-60050, which Proxmox uses for live migration"
    if port in RESERVED_UI_PORTS:
        if port == 8006:
            return "the Proxmox web UI's own port"
        if port == 8007:
            return "Proxmox Backup Server's port"
        return "a port another service commonly uses"
    if _port_in_use(port):
        return "already in use on this node"
    return ""


def _v_ui_port(v):
    return ui_port_problem(v) == ""


def _run(cmd, timeout=15):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def _node_name():
    res = _run(["hostname", "-s"], timeout=5)
    if res and res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    return os.uname().nodename.split(".")[0]


def _pve_firewall_on():
    res = _run(["pve-firewall", "status"], timeout=10)
    return bool(res and res.returncode == 0 and "enabled" in res.stdout.lower())


def _node_addr_networks():
    """[(address, network)] for every global IPv4 address on this node."""
    out, seen = [], set()
    res = _run(["ip", "-4", "-o", "addr", "show", "scope", "global"], timeout=10)
    if not res or res.returncode != 0:
        return out
    for line in res.stdout.splitlines():
        parts = line.split()
        for i, token in enumerate(parts):
            if token != "inet" or i + 1 >= len(parts):
                continue
            cidr = parts[i + 1]
            addr = cidr.partition("/")[0]
            if addr.startswith("127.") or addr.startswith("169.254.") or addr in seen:
                break
            try:
                network = str(ipaddress.ip_network(cidr, strict=False))
            except ValueError:
                break
            seen.add(addr)
            out.append((addr, network))
            break
    return out


def _fw_rules():
    res = _run(["pvesh", "get", "/nodes/%s/firewall/rules" % _node_name(),
                "--output-format", "json"], timeout=20)
    if not res or res.returncode != 0:
        return []
    try:
        data = json.loads(res.stdout)
    except ValueError:
        return []
    return data if isinstance(data, list) else []


def _fw_close_port(port):
    """Remove only our own rules for a port, highest position first.

    Descending, because deleting a rule renumbers every rule below it.
    """
    positions = [r["pos"] for r in _fw_rules()
                 if isinstance(r, dict)
                 and r.get("comment") == FW_RULE_COMMENT
                 and str(r.get("dport", "")) == str(port)
                 and r.get("pos") is not None]
    for pos in sorted(positions, reverse=True):
        _run(["pvesh", "delete",
              "/nodes/%s/firewall/rules/%s" % (_node_name(), pos)], timeout=20)
    return len(positions)


def _fw_open_port(port):
    added = 0
    node = _node_name()
    for addr, network in _node_addr_networks():
        res = _run(["pvesh", "create", "/nodes/%s/firewall/rules" % node,
                    "--type", "in", "--action", "ACCEPT", "--proto", "tcp",
                    "--dport", str(port), "--dest", addr, "--source", network,
                    "--enable", "1", "--comment", FW_RULE_COMMENT], timeout=20)
        if res and res.returncode == 0:
            added += 1
    return added


def apply_ui_port(new_port):
    """Move the panel to a new port. Returns (ok, detail)."""
    new_port = int(new_port)
    old_port = LISTEN_PORT
    if new_port == old_port:
        return True, ""

    try:
        os.makedirs(os.path.dirname(UI_SERVICE_DROPIN), exist_ok=True)
        with open(UI_SERVICE_DROPIN, "w") as handle:
            handle.write("# Managed by the proxmox-autoupdate panel. Safe to edit.\n"
                         "[Service]\nEnvironment=PAU_UI_PORT=%d\n" % new_port)
        os.chmod(UI_SERVICE_DROPIN, 0o644)
    except OSError as exc:
        return False, "could not write %s (%s)" % (UI_SERVICE_DROPIN, exc)

    res = _run(["systemctl", "daemon-reload"], timeout=30)
    if not res or res.returncode != 0:
        return False, "systemctl daemon-reload failed"

    notes = []
    if _pve_firewall_on():
        opened = _fw_open_port(new_port)
        closed = _fw_close_port(old_port)
        if opened:
            notes.append("opened %d firewall rule(s) for %d" % (opened, new_port))
        else:
            notes.append("WARNING: no firewall rule could be added for %d, so the "
                         "panel may be unreachable on it" % new_port)
        if closed:
            notes.append("removed %d stale rule(s) for %d" % (closed, old_port))

    if os.path.isfile(UI_PATCHER):
        res = _run([UI_PATCHER, "apply", "--quiet"], timeout=60)
        if not res or res.returncode != 0:
            notes.append("WARNING: the toolbar button still points at %d - run "
                         "'pve-autoupdate-patch-webui apply' on the node" % old_port)

    # Detached and delayed, so this response is delivered before the socket
    # serving it goes away.
    ok, detail = run_detached("sleep 3; systemctl restart %s" % UI_UNIT,
                              PORT_CHANGE_UNIT)
    if not ok:
        return False, ("everything is in place but the restart could not be "
                       "started (%s) - run 'systemctl restart %s'" % (detail, UI_UNIT))
    return True, "; ".join(notes)


def _v_schedules(v):
    """';'-separated '<cron>|<yes|no>|<label>' entries, or empty.

    Validated field by field rather than with one big regex: this value reaches
    both the sourced config file and, expression by expression, the root
    crontab, so a newline slipping through either of them is a root-shell
    problem, not a formatting one.
    """
    if v == "":
        return True
    if "\n" in v or "\r" in v or len(v) > 1000:
        return False
    entries = [e for e in v.split(";") if e.strip()]
    if not entries or len(entries) > 10:
        return False
    for entry in entries:
        parts = entry.split("|")
        if len(parts) > 3 or not _v_cron(parts[0].strip()):
            return False
        if len(parts) > 1 and parts[1].strip().lower() not in SCHEDULE_MODES:
            return False
        if len(parts) > 2 and len(parts[2]) > 60:
            return False
    return True


