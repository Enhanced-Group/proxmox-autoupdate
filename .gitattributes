# These all execute on Linux. A CRLF line ending in a shebang makes the kernel
# look for an interpreter literally named "bash\r", so force LF regardless of
# the platform a contributor happens to be editing on.
*.sh              text eol=lf
*.service         text eol=lf
uninstall.sh      text eol=lf
install.sh        text eol=lf

# Extension-less executables
webui/pve-autoupdate-ui             text eol=lf
webui/99-proxmox-autoupdate-webui   text eol=lf

*.md              text eol=lf
